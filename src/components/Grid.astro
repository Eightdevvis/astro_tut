---
const { items } = Astro.props;
---

<div class="grid">
  {items ? (
    items.map((item: any) => (
      <div class="grid-item" style={item.color ? `background: ${item.color};` : ''}>
        {item.content}
      </div>
    ))
  ) : (
    <slot />
  )}
</div>

<style>

  .grid {
    display: grid;
    grid-auto-flow: row;
    grid-template-columns: repeat(auto-fit, minmax(0, max-content));
    justify-content: start;
    gap: 1rem;
    width: auto;
    padding: 1rem 0;
  }

  .grid-item {
    width: max-content;
    max-width: 100%;
    padding: 0.75rem;
    box-sizing: border-box;
  }

  @media (max-width: 480px) {
    .grid {
      grid-template-columns: repeat(auto-fit, minmax(0, max-content));
      gap: 0.5rem;
      padding: 0.5rem 0;
    }
  }
</style>
