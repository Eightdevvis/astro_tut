---
/*
 * Linke Spalte neben dem Editor:
 *   1. Privacy-Werkzeugkasten (SVG-Toolbox-Optik)
 *   2. Backup-Tresor (SVG-Safe-Optik)
 * Akkordeon: nur eine Box ausgeklappt zur Zeit.
 *
 * Daten kommen aus src/lib/privacy-toggles.js und src/lib/backup-layers.js
 * (Single Source of Truth). Der State der Toggles lebt im window-globalen
 * `window.__blogToolbox` und wird beim Save vom Editor-Script in
 * blogpost.astro mitgeschickt.
 */

import { TOGGLES, VISIBILITIES, EFFECT_AXES } from '../lib/privacy-toggles.js';
import { LAYERS, BACKUP_AXES } from '../lib/backup-layers.js';
---

<aside class="pb-sidebar" id="pbSidebar" aria-label="Privatsphaere und Sicherung">
  <!-- Privacy-Werkzeugkasten -->
  <section class="pb-box pb-box--privacy is-open" data-box="privacy" aria-labelledby="pbPrivacyTitle">
    <button class="pb-box-head" type="button" data-toggle="privacy">
      <svg class="pb-icon" viewBox="0 0 64 48" aria-hidden="true">
        <!-- offener Werkzeugkasten -->
        <rect x="6" y="18" width="52" height="26" rx="2" fill="none" stroke="currentColor" stroke-width="2"/>
        <path d="M14 18 V12 a4 4 0 0 1 4 -4 h28 a4 4 0 0 1 4 4 v6" fill="none" stroke="currentColor" stroke-width="2"/>
        <line x1="6" y1="26" x2="58" y2="26" stroke="currentColor" stroke-width="1.5"/>
        <!-- kleine "Werkzeuge" -->
        <rect x="12" y="29" width="4" height="11" fill="currentColor" opacity="0.6"/>
        <rect x="20" y="29" width="3" height="11" fill="currentColor" opacity="0.5"/>
        <circle cx="34" cy="34" r="3" fill="currentColor" opacity="0.5"/>
        <rect x="42" y="29" width="10" height="3" fill="currentColor" opacity="0.5"/>
        <rect x="42" y="36" width="6" height="3" fill="currentColor" opacity="0.5"/>
      </svg>
      <span class="pb-box-title" id="pbPrivacyTitle">Privatsphaere</span>
      <span class="pb-box-status" id="pbPrivacyStatus" aria-live="polite">oeffentlich</span>
      <span class="pb-box-chevron" aria-hidden="true">▾</span>
    </button>

    <div class="pb-box-body" data-body="privacy">
      <!-- Visibility-Stufe (Mega-Toggle) -->
      <div class="pb-section pb-section--visibility">
        <div class="pb-section-label">Sichtbarkeit</div>
        <div class="pb-vis-group" role="radiogroup" aria-label="Sichtbarkeitsstufe">
          {VISIBILITIES.map((v) => (
            <label class="pb-vis">
              <input type="radio" name="pbVisibility" value={v.id} data-vis={v.id} />
              <span class="pb-vis-label">{v.label}</span>
              <button class="pb-info"
                      type="button"
                      data-info-title={v.label}
                      data-info-short={v.short}
                      data-info-effects-axes="vis"
                      data-info-effects-key={v.id}
                      aria-label={`Info zu ${v.label}`}>i</button>
            </label>
          ))}
        </div>
        <div class="pb-pw-row" id="pbPwRow" hidden>
          <label class="pb-pw-label" for="pbPwInput">Passwort</label>
          <input type="text" id="pbPwInput" class="pb-pw-input" maxlength="256" autocomplete="off" placeholder="leer = behalten" />
        </div>
        <div class="pb-expires-row">
          <label class="pb-pw-label" for="pbExpiresInput">Ablauf (optional)</label>
          <input type="datetime-local" id="pbExpiresInput" class="pb-pw-input" />
        </div>
      </div>

      <!-- Einzelne Toggles -->
      <div class="pb-section">
        <div class="pb-section-label">Toggles</div>
        <ul class="pb-toggle-list">
          {TOGGLES.map((t) => (
            <li class="pb-toggle">
              <label class="pb-toggle-row">
                <input type="checkbox" data-toggle-id={t.id} />
                <span class="pb-toggle-label">{t.label}</span>
              </label>
              <button class="pb-info"
                      type="button"
                      data-info-title={t.label}
                      data-info-short={t.short}
                      data-info-effects-axes="toggle"
                      data-info-effects-key={t.id}
                      aria-label={`Info zu ${t.label}`}>i</button>
            </li>
          ))}
        </ul>
      </div>

      <!-- Sammel-Status (12 Achsen) -->
      <div class="pb-section">
        <div class="pb-section-label">Effektiver Zustand</div>
        <ul class="pb-effects" id="pbPrivacyEffects">
          {EFFECT_AXES.map((a) => (
            <li class="pb-effect" data-axis-id={a.id}>
              <span class="pb-effect-mark" aria-hidden="true">–</span>
              <span class="pb-effect-label">{a.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Backup-Tresor -->
  <section class="pb-box pb-box--backup" data-box="backup" aria-labelledby="pbBackupTitle">
    <button class="pb-box-head" type="button" data-toggle="backup">
      <svg class="pb-icon" viewBox="0 0 56 56" aria-hidden="true">
        <!-- Tresor-Korpus -->
        <rect x="4" y="6" width="48" height="44" rx="3" fill="none" stroke="currentColor" stroke-width="2"/>
        <rect x="9" y="11" width="38" height="34" rx="2" fill="none" stroke="currentColor" stroke-width="1.4"/>
        <!-- Dial -->
        <circle cx="30" cy="28" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/>
        <circle cx="30" cy="28" r="2" fill="currentColor"/>
        <line x1="30" y1="28" x2="34" y2="22" stroke="currentColor" stroke-width="1.6"/>
        <!-- Griff -->
        <line x1="40" y1="22" x2="46" y2="22" stroke="currentColor" stroke-width="2"/>
        <line x1="40" y1="34" x2="46" y2="34" stroke="currentColor" stroke-width="2"/>
        <!-- Scharniere -->
        <rect x="6" y="14" width="2" height="6" fill="currentColor"/>
        <rect x="6" y="36" width="2" height="6" fill="currentColor"/>
      </svg>
      <span class="pb-box-title" id="pbBackupTitle">Sicherung</span>
      <span class="pb-box-status" id="pbBackupStatus" aria-live="polite">alles aktiv</span>
      <span class="pb-box-chevron" aria-hidden="true">▾</span>
    </button>

    <div class="pb-box-body" data-body="backup">
      <div class="pb-section">
        <div class="pb-section-label">Schichten (default: alles aktiv)</div>
        <ul class="pb-layer-list">
          {LAYERS.map((l) => (
            <li class="pb-layer">
              <span class="pb-layer-dot" aria-hidden="true">●</span>
              <span class="pb-layer-label">{l.label}</span>
              <span class="pb-layer-status" data-layer-status={l.id}>{l.alwaysOn ? 'an' : '—'}</span>
              <button class="pb-info"
                      type="button"
                      data-info-title={l.label}
                      data-info-short={l.short}
                      data-info-effects-axes="layer"
                      data-info-effects-key={l.id}
                      aria-label={`Info zu ${l.label}`}>i</button>
            </li>
          ))}
        </ul>
        <p class="pb-hint">Detaillierte Verwaltung (alle Revisionen, Papierkorb, Webhook) in den Einstellungen.</p>
      </div>
    </div>
  </section>

  <!-- InfoPopover (eines fuer alle, dynamisch befuellt) -->
  <div class="pb-popover" id="pbPopover" role="dialog" hidden>
    <button class="pb-popover-close" id="pbPopoverClose" type="button" aria-label="Schliessen">×</button>
    <h3 class="pb-popover-title" id="pbPopoverTitle"></h3>
    <p class="pb-popover-short" id="pbPopoverShort"></p>
    <ul class="pb-popover-effects" id="pbPopoverEffects"></ul>
  </div>
</aside>

<script
  is:inline
  type="application/json"
  id="pbToolboxData"
  set:html={JSON.stringify({
    visibilities: VISIBILITIES,
    toggles: TOGGLES,
    effectAxes: EFFECT_AXES,
    layers: LAYERS,
    backupAxes: BACKUP_AXES,
  })}
></script>

<style>
  .pb-sidebar {
    position: sticky;
    top: calc(var(--nav-strip-h, 56px) + 1rem);
    width: 280px;
    flex: 0 0 280px;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    align-self: flex-start;
    max-height: calc(100dvh - var(--nav-strip-h, 56px) - 2rem);
    overflow: visible;
  }
  .pb-box {
    border: 1px solid var(--site-card-border);
    border-radius: 0.7rem;
    background: var(--site-card-bg);
    overflow: hidden;
    box-shadow: var(--site-card-shadow);
  }
  .pb-box-head {
    width: 100%;
    display: grid;
    grid-template-columns: 36px 1fr auto 1.2em;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.7rem;
    border: 0;
    background: transparent;
    color: var(--site-body-text);
    cursor: pointer;
    text-align: left;
    font: inherit;
  }
  .pb-icon {
    width: 32px;
    height: 32px;
    color: var(--site-body-text);
  }
  .pb-box-title {
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pb-box-status {
    font-size: 0.72rem;
    opacity: 0.72;
    letter-spacing: 0.04em;
  }
  .pb-box-chevron {
    opacity: 0.7;
    transform: rotate(0deg);
    transition: transform 220ms ease;
    font-size: 1rem;
  }
  .pb-box:not(.is-open) .pb-box-chevron {
    transform: rotate(-90deg);
  }
  .pb-box-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 320ms ease;
  }
  .pb-box.is-open .pb-box-body {
    max-height: 80dvh;
    overflow-y: auto;
  }
  .pb-section {
    padding: 0.5rem 0.7rem 0.7rem;
    border-top: 1px solid var(--site-card-border);
  }
  .pb-section-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.6;
    margin-bottom: 0.4rem;
  }
  .pb-vis-group {
    display: grid;
    gap: 0.3rem;
  }
  .pb-vis {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.4rem;
    align-items: center;
    font-size: 0.84rem;
    cursor: pointer;
  }
  .pb-pw-row,
  .pb-expires-row {
    margin-top: 0.5rem;
    display: grid;
    gap: 0.15rem;
  }
  .pb-pw-label {
    font-size: 0.7rem;
    opacity: 0.7;
  }
  .pb-pw-input {
    border: 1px solid var(--site-card-border);
    background: transparent;
    color: inherit;
    border-radius: 0.4rem;
    padding: 0.3rem 0.45rem;
    font-size: 0.82rem;
    font-family: inherit;
  }
  .pb-toggle-list,
  .pb-layer-list,
  .pb-effects {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.25rem;
  }
  .pb-toggle,
  .pb-layer {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.3rem;
    align-items: center;
    font-size: 0.84rem;
  }
  .pb-toggle-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem;
    align-items: center;
    cursor: pointer;
  }
  .pb-layer {
    grid-template-columns: auto 1fr auto auto;
  }
  .pb-layer-dot {
    color: #4caf50;
    font-size: 0.9rem;
    line-height: 1;
  }
  .pb-layer-status {
    font-size: 0.7rem;
    opacity: 0.62;
    letter-spacing: 0.04em;
  }
  .pb-info {
    border: 1px solid var(--site-card-border);
    background: transparent;
    color: inherit;
    border-radius: 999px;
    width: 1.4rem;
    height: 1.4rem;
    font-size: 0.74rem;
    line-height: 1.2;
    cursor: pointer;
    padding: 0;
    opacity: 0.7;
  }
  .pb-info:hover { opacity: 1; }
  .pb-effects {
    font-size: 0.78rem;
  }
  .pb-effect {
    display: grid;
    grid-template-columns: 1.1rem 1fr;
    gap: 0.3rem;
    align-items: center;
  }
  .pb-effect-mark {
    font-family: monospace;
    text-align: center;
    opacity: 0.7;
  }
  .pb-effect-mark[data-mark='+'] { color: #4caf50; }
  .pb-effect-mark[data-mark='-'] { color: #c44; }
  .pb-hint {
    font-size: 0.72rem;
    opacity: 0.6;
    margin: 0.5rem 0 0;
  }

  .pb-popover {
    position: fixed;
    z-index: 200;
    min-width: 260px;
    max-width: 320px;
    background: var(--site-card-bg);
    color: var(--site-body-text);
    border: 1px solid var(--site-card-border);
    box-shadow: var(--site-card-shadow);
    border-radius: 0.6rem;
    padding: 0.7rem 0.8rem;
  }
  .pb-popover-close {
    position: absolute;
    top: 0.2rem;
    right: 0.3rem;
    border: 0;
    background: transparent;
    color: inherit;
    font-size: 1.1rem;
    cursor: pointer;
    opacity: 0.6;
  }
  .pb-popover-title {
    margin: 0 0 0.35rem;
    font-size: 0.92rem;
  }
  .pb-popover-short {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    line-height: 1.4;
    opacity: 0.85;
  }
  .pb-popover-effects {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.15rem;
    font-size: 0.76rem;
  }
  .pb-popover-effects li {
    display: grid;
    grid-template-columns: 1.1rem 1fr;
    gap: 0.3rem;
    align-items: center;
  }

  @media (max-width: 900px) {
    .pb-sidebar {
      position: static;
      width: 100%;
      flex: 0 0 auto;
      max-height: none;
      margin-bottom: 1rem;
    }
  }
</style>

<script>
  // Modul-IIFE, damit nichts ins window-Globalverhalten leakt — bis auf
  // window.__blogToolbox als bewusste Bridge zum Editor-Save-Script.
  (function () {
    const root = document.getElementById('pbSidebar');
    if (!root) return;
    const dataNode = document.getElementById('pbToolboxData');
    if (!dataNode) return;
    let DATA;
    try { DATA = JSON.parse(dataNode.textContent || '{}'); } catch { return; }

    // --- State (lebt im window, damit das Save-Script vom Editor zugreift) ---
    /** @type {{visibility:string, flags:Record<string,boolean>, password:string, expiresAt:string}} */
    const STATE = {
      visibility: 'public',
      flags: {},
      password: '',
      expiresAt: '',
    };
    window.__blogToolbox = {
      state: STATE,
      // Vom Editor-Save-Script gerufen: liefert den Payload-Anteil, der
      // an /api/posts/add oder PATCH /api/posts/[id] geschickt wird.
      readPayload() {
        const payload = {
          visibility: STATE.visibility,
          privacyFlags: { ...STATE.flags },
        };
        if (STATE.expiresAt) {
          payload.expiresAt = STATE.expiresAt;
        }
        if (STATE.visibility === 'password' && STATE.password) {
          payload.password = STATE.password;
        }
        return payload;
      },
      // Vom Editor gerufen, wenn ein bestehender Post zur Bearbeitung
      // geoeffnet wird — setzt die UI auf die Werte aus mine.js.
      loadFromPost(post) {
        STATE.visibility = (post && post.visibility) || 'public';
        try {
          STATE.flags = JSON.parse(post && post.privacy_flags || '{}') || {};
        } catch {
          STATE.flags = {};
        }
        STATE.password = '';
        STATE.expiresAt = '';
        renderAll();
      },
      reset() {
        STATE.visibility = 'public';
        STATE.flags = {};
        STATE.password = '';
        STATE.expiresAt = '';
        renderAll();
      },
    };

    // --- Akkordeon ---
    root.querySelectorAll('[data-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const which = btn.getAttribute('data-toggle');
        root.querySelectorAll('.pb-box').forEach((b) => {
          if (b.getAttribute('data-box') === which) b.classList.toggle('is-open');
          else b.classList.remove('is-open');
        });
      });
    });

    // --- Visibility-Radio ---
    root.querySelectorAll('input[name="pbVisibility"]').forEach((input) => {
      input.addEventListener('change', () => {
        if (!input.checked) return;
        STATE.visibility = input.value;
        renderVisibility();
        renderEffects();
      });
    });

    // --- Toggle-Checkboxes ---
    root.querySelectorAll('input[data-toggle-id]').forEach((cb) => {
      cb.addEventListener('change', () => {
        const id = cb.getAttribute('data-toggle-id');
        STATE.flags[id] = cb.checked;
        renderEffects();
      });
    });

    // --- Passwort + Expire ---
    const pwInput = document.getElementById('pbPwInput');
    pwInput?.addEventListener('input', () => { STATE.password = pwInput.value; });
    const exInput = document.getElementById('pbExpiresInput');
    exInput?.addEventListener('input', () => {
      if (!exInput.value) { STATE.expiresAt = ''; return; }
      const d = new Date(exInput.value);
      STATE.expiresAt = Number.isNaN(d.getTime()) ? '' : d.toISOString();
    });

    // --- InfoPopover ---
    const pop = document.getElementById('pbPopover');
    const popTitle = document.getElementById('pbPopoverTitle');
    const popShort = document.getElementById('pbPopoverShort');
    const popEffects = document.getElementById('pbPopoverEffects');
    const popClose = document.getElementById('pbPopoverClose');

    function closePopover() { pop.hidden = true; }
    popClose?.addEventListener('click', closePopover);
    document.addEventListener('click', (ev) => {
      if (pop.hidden) return;
      if (pop.contains(ev.target)) return;
      if (ev.target.closest && ev.target.closest('.pb-info')) return;
      closePopover();
    });

    function openPopover(btn) {
      const title = btn.getAttribute('data-info-title') || '';
      const short = btn.getAttribute('data-info-short') || '';
      const axesKind = btn.getAttribute('data-info-effects-axes') || '';
      const key = btn.getAttribute('data-info-effects-key') || '';
      popTitle.textContent = title;
      popShort.textContent = short;
      popEffects.innerHTML = '';
      let effects = null;
      let axes = null;
      if (axesKind === 'vis') {
        const v = DATA.visibilities.find((x) => x.id === key);
        effects = v?.effects || {};
        axes = DATA.effectAxes;
      } else if (axesKind === 'toggle') {
        const t = DATA.toggles.find((x) => x.id === key);
        effects = t?.effects || {};
        axes = DATA.effectAxes;
      } else if (axesKind === 'layer') {
        const l = DATA.layers.find((x) => x.id === key);
        effects = l?.effects || {};
        axes = DATA.backupAxes;
      }
      if (effects && axes) {
        for (const a of axes) {
          const v = effects[a.id];
          const li = document.createElement('li');
          const mark = document.createElement('span');
          let m = v == null ? '–' : (v === '+' ? '✓' : v === '-' ? '✗' : String(v));
          mark.textContent = m;
          mark.className = 'pb-effect-mark';
          if (v === '+' || v === 'OK') mark.dataset.mark = '+';
          else if (v === '-') mark.dataset.mark = '-';
          li.appendChild(mark);
          const label = document.createElement('span');
          label.textContent = a.label;
          li.appendChild(label);
          popEffects.appendChild(li);
        }
      }
      // Positionierung: rechts neben dem geklickten Button, falls Platz.
      const rect = btn.getBoundingClientRect();
      pop.hidden = false;
      const popRect = pop.getBoundingClientRect();
      let left = rect.right + 8;
      if (left + popRect.width > window.innerWidth - 8) {
        left = Math.max(8, rect.left - popRect.width - 8);
      }
      let top = rect.top;
      if (top + popRect.height > window.innerHeight - 8) {
        top = Math.max(8, window.innerHeight - popRect.height - 8);
      }
      pop.style.left = `${left}px`;
      pop.style.top = `${top}px`;
    }

    root.querySelectorAll('.pb-info').forEach((btn) => {
      btn.addEventListener('click', (ev) => {
        ev.stopPropagation();
        openPopover(btn);
      });
    });

    // --- Rendering ---
    function renderVisibility() {
      root.querySelectorAll('input[name="pbVisibility"]').forEach((i) => {
        i.checked = i.value === STATE.visibility;
      });
      document.getElementById('pbPwRow').hidden = STATE.visibility !== 'password';
      const status = document.getElementById('pbPrivacyStatus');
      const v = DATA.visibilities.find((x) => x.id === STATE.visibility);
      if (status) status.textContent = (v && v.label) || STATE.visibility;
    }
    function renderToggles() {
      root.querySelectorAll('input[data-toggle-id]').forEach((cb) => {
        const id = cb.getAttribute('data-toggle-id');
        cb.checked = !!STATE.flags[id];
      });
    }
    function renderEffects() {
      // aggregateEffects-Aequivalent in-place
      const v = DATA.visibilities.find((x) => x.id === STATE.visibility) || DATA.visibilities[0];
      const result = {};
      for (const [k, val] of Object.entries(v.effects)) result[k] = val;
      for (const t of DATA.toggles) {
        if (!STATE.flags[t.id]) continue;
        for (const [k, val] of Object.entries(t.effects)) {
          if (val == null) continue;
          if (val === '-' || result[k] == null) result[k] = val;
        }
      }
      root.querySelectorAll('.pb-effect').forEach((el) => {
        const id = el.getAttribute('data-axis-id');
        const mark = el.querySelector('.pb-effect-mark');
        const v = result[id];
        const sym = v == null ? '–' : (v === '+' ? '✓' : v === '-' ? '✗' : v);
        if (mark) {
          mark.textContent = sym;
          if (v === '+') mark.dataset.mark = '+';
          else if (v === '-') mark.dataset.mark = '-';
          else delete mark.dataset.mark;
        }
      });
    }
    function renderAll() {
      renderVisibility();
      renderToggles();
      renderEffects();
      const exInput = document.getElementById('pbExpiresInput');
      if (exInput) {
        exInput.value = STATE.expiresAt ? STATE.expiresAt.slice(0, 16) : '';
      }
      const pwInput = document.getElementById('pbPwInput');
      if (pwInput) pwInput.value = STATE.password || '';
    }

    // Initial: vom Server-Default vorbelegen (best effort).
    fetch('/api/user/privacy-defaults', { credentials: 'same-origin' })
      .then((r) => r.ok ? r.json() : null)
      .then((j) => {
        const d = j && j.defaults;
        if (!d) { renderAll(); return; }
        STATE.visibility = d.default_visibility || 'public';
        try { STATE.flags = JSON.parse(d.default_flags || '{}') || {}; } catch {}
        renderAll();
      })
      .catch(() => renderAll());
  })();
</script>
