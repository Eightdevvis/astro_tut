---
import LoginWidget from './LoginWidget.jsx';
---

<nav>
    <div class="left-nav2">
        <!-- Mund-Icon: führt zur Zitat-Einreichungs-Seite -->
        <a href="/quotes/new" style="display:flex; align-items:center; padding:20px; color:white; text-decoration:none;">
            <svg width="38" height="38" viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-4-8c.55 0 1-.45 1-1s-.45-1-1-1-1 .45-1 1 .45 1 1 1zm8 0c.55 0 1-.45 1-1s-.45-1-1-1-1 .45-1 1 .45 1 1 1zm-4 5c2.33 0 4.31-1.46 5.11-3.5H6.89C7.69 14.54 9.67 16 12 16z"/>
            </svg>
        </a>
    </div>
    <div class="center-nav2">
        <h1>
            SaSh
        </h1>
    </div>
    <div class="right-nav2">
        <!-- LoginWidget: client:load damit Preact/React im Browser lädt -->
        <LoginWidget client:load />
    </div>
</nav>

<style>
nav {
    display: flex;
    align-items: center;
    width: 100%;
    position: relative;
}
.left-nav2, .right-nav2 {
    flex: 1;
    display: flex;
    align-items: center;
    align-self: flex-start;
    padding-top: calc(1rem + 5vh);  /* margin-top(1rem) + halbes Leading der h1 (line-height 1.5 bei 20vh = 5vh über dem Glyph) */
}
/* rechts auffüllen von rechts → justify-content: flex-end */
.right-nav2 {
    justify-content: flex-end;
}
.center-nav2 {
    position: relative;
    display: flex;
    align-items: center;
}
h1 {
    font-family: var(--font-hero, 'Protest Demo');
    font-size: 20vh;
    color: white;
    /* Buchstaben horizontal auf 60% stauchen → länglicher/schmaler Effekt.
       display:inline-block nötig damit transform auf Inline-Elemente wirkt */
    display: inline-block;
    transform: scaleX(0.6);
}
</style>
