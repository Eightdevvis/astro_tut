---
import LoginWidget from './LoginWidget.jsx';

interface Props {
  /** Startseite: nur Icon-Leiste (fixiert). Großer Titel liegt im Fluss auf `index.astro`. Sonst: Haus-Icon zur Startseite. */
  variant?: 'home' | 'subpage';
}

const { variant = 'subpage' } = Astro.props;
const isHome = variant === 'home';
---

<nav class:list={['nav2', isHome && 'nav2--home']} aria-label="Hauptnavigation">
  <div class="nav2-strip">
    <div class="nav2-left">
      <div class="nav2-left-desktop">
        <a href="/quotes/new" class="nav2-icon" aria-label="Zitat einreichen">
          <svg width="38" height="38" viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path
              d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-4-8c.55 0 1-.45 1-1s-.45-1-1-1-1 .45-1 1 .45 1 1 1zm8 0c.55 0 1-.45 1-1s-.45-1-1-1-1 .45-1 1 .45 1 1 1zm-4 5c2.33 0 4.31-1.46 5.11-3.5H6.89C7.69 14.54 9.67 16 12 16z"
            />
          </svg>
        </a>
        <a href="/minigames" class="nav2-icon" aria-label="Minigames">
          <svg width="38" height="38" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect x="3" y="7" width="18" height="12" rx="2" stroke="white" stroke-width="1.6" />
            <path d="M8 11h2v2H8zm3 0h2v2h-2zm3 0h2v2h-2z" fill="white" />
            <path d="M6 7V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2" stroke="white" stroke-width="1.4" stroke-linecap="round" />
          </svg>
        </a>
        <a href="/blog/" class="nav2-icon" aria-label="Blog">
          <svg width="38" height="38" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path
              d="M7 3h10a2 2 0 0 1 2 2v16l-7-3-7 3V5a2 2 0 0 1 2-2z"
              stroke="white"
              stroke-width="1.6"
              stroke-linejoin="round"
            />
            <path d="M8 8h8M8 12h6" stroke="white" stroke-width="1.4" stroke-linecap="round" />
          </svg>
        </a>
      </div>

      <details class="nav2-drawer">
        <summary class="nav2-drawer-summary">
          <span class="nav2-visually-hidden">Menü</span>
          <svg class="nav2-burger-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </summary>
        <div class="nav2-drawer-panel">
          <a href="/quotes/new" class="nav2-drawer-link">
            <span class="nav2-drawer-ic" aria-hidden="true">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg">
                <path
                  d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-4-8c.55 0 1-.45 1-1s-.45-1-1-1-1 .45-1 1 .45 1 1 1zm8 0c.55 0 1-.45 1-1s-.45-1-1-1-1 .45-1 1 .45 1 1 1zm-4 5c2.33 0 4.31-1.46 5.11-3.5H6.89C7.69 14.54 9.67 16 12 16z"
                />
              </svg>
            </span>
            <span>Zitate</span>
          </a>
          <a href="/minigames" class="nav2-drawer-link">
            <span class="nav2-drawer-ic" aria-hidden="true">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="3" y="7" width="18" height="12" rx="2" stroke="white" stroke-width="1.6" />
                <path d="M8 11h2v2H8zm3 0h2v2h-2zm3 0h2v2h-2z" fill="white" />
                <path d="M6 7V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2" stroke="white" stroke-width="1.4" stroke-linecap="round" />
              </svg>
            </span>
            <span>Minigames</span>
          </a>
          <a href="/blog/" class="nav2-drawer-link">
            <span class="nav2-drawer-ic" aria-hidden="true">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path
                  d="M7 3h10a2 2 0 0 1 2 2v16l-7-3-7 3V5a2 2 0 0 1 2-2z"
                  stroke="white"
                  stroke-width="1.6"
                  stroke-linejoin="round"
                />
                <path d="M8 8h8M8 12h6" stroke="white" stroke-width="1.4" stroke-linecap="round" />
              </svg>
            </span>
            <span>Blog</span>
          </a>
        </div>
      </details>
    </div>
    <div class="nav2-right">
      <div class="nav2-login-wrap">
        <LoginWidget client:load />
      </div>
    </div>
  </div>

  {
    !isHome && (
      <div class="nav2-brand-layer">
        <a href="/" class="nav2-icon nav2-icon--home" aria-label="Startseite" title="Startseite">
          <svg width="38" height="38" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path
              d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1v-9.5z"
              stroke="white"
              stroke-width="1.6"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    )
  }
</nav>

<style>
  .nav2-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .nav2 {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding-top: env(safe-area-inset-top, 0px);
    pointer-events: none;
  }

  .nav2-strip {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    min-height: var(--nav-strip-h);
    padding: 0 0.25rem;
    pointer-events: auto;
  }

  .nav2-left {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 0.15rem;
    min-width: 0;
  }

  .nav2-left-desktop {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.15rem;
  }

  .nav2-drawer {
    display: none;
    position: relative;
  }

  .nav2-drawer-summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 12px;
    color: #fff;
    border-radius: 8px;
    transition: background 0.15s ease;
  }

  .nav2-drawer-summary::-webkit-details-marker {
    display: none;
  }

  .nav2-drawer-summary::marker {
    content: '';
  }

  .nav2-drawer-summary:hover,
  .nav2-drawer-summary:focus-visible {
    background: rgba(255, 255, 255, 0.08);
    outline: none;
  }

  .nav2-burger-icon {
    display: block;
  }

  .nav2-drawer-panel {
    position: absolute;
    left: 0;
    top: calc(100% + 2px);
    min-width: 12rem;
    padding: 0.35rem 0;
    background: rgba(8, 8, 10, 0.97);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
    z-index: 5;
  }

  .nav2-drawer-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 1rem;
    color: rgba(255, 255, 255, 0.95);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .nav2-drawer-link:hover,
  .nav2-drawer-link:focus-visible {
    background: rgba(255, 255, 255, 0.08);
    outline: none;
  }

  .nav2-drawer-ic {
    display: flex;
    flex-shrink: 0;
    align-items: center;
  }

  @media screen and (max-width: 767px) {
    .nav2-left-desktop {
      display: none;
    }

    .nav2-drawer {
      display: block;
    }
  }

  .nav2-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
  }

  .nav2-login-wrap {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .nav2-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
    color: white;
    text-decoration: none;
    flex-shrink: 0;
    border-radius: 8px;
    transition: background 0.15s ease;
  }

  .nav2-icon:hover,
  .nav2-icon:focus-visible {
    background: rgba(255, 255, 255, 0.08);
    outline: none;
  }

  .nav2-brand-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: env(safe-area-inset-top, 0px);
    bottom: auto;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    z-index: 1;
    pointer-events: none;
  }

  .nav2-icon--home {
    pointer-events: auto;
    margin-top: 0.35rem;
    padding: 10px;
  }
</style>
