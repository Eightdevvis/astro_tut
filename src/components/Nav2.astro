---
import LoginWidget from './LoginWidget.jsx';
import ThemeToggle from './ThemeToggle.astro';
import { getSessionUserFromCookies } from '../lib/session.js';
import { hasPermission } from '../lib/permissions.js';
import { getGitInfo } from '../lib/git-info.js';

interface Props {
  /** Startseite: nur Icon-Leiste (fixiert). Großer Titel liegt im Fluss auf `index.astro`. Sonst: Haus-Icon zur Startseite. */
  variant?: 'home' | 'subpage';
}

const { variant = 'subpage' } = Astro.props;
const isHome = variant === 'home';
const sessionUser = Astro.isPrerendered ? null : await getSessionUserFromCookies(Astro.cookies);
const username = sessionUser?.username || null;
const showRpgNav = Boolean(username) && (await hasPermission(username, 'rpg_access'));
const showBlogpostNav = Boolean(username) && (await hasPermission(username, 'blogpost_poster'));
// Minigames vorerst nur Superuser — Architektur-Umbau laeuft.
const showMinigamesNav = Boolean(username) && (await hasPermission(username, 'super_access'));
const isSuperuser = Boolean(username) && (await hasPermission(username, 'super_access'));
const gitInfo = isSuperuser ? getGitInfo() : null;
const gitBadgeLabel = gitInfo?.branch || gitInfo?.shortSha || null;
const gitBadgeTitle = gitInfo
  ? `Branch: ${gitInfo.branch ?? '?'}\nCommit: ${gitInfo.shortSha ?? '?'}`
  : '';
---

<nav class:list={['nav2', isHome && 'nav2--home']} aria-label="Hauptnavigation">
  <div class="nav2-strip">
    <div class="nav2-left">
      <div class="nav2-left-desktop">
        <a href="/quotes/new" class="nav2-icon" aria-label="Zitat einreichen" title="Zitat einreichen">
          <svg width="38" height="38" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path
              d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-4-8c.55 0 1-.45 1-1s-.45-1-1-1-1 .45-1 1 .45 1 1 1zm8 0c.55 0 1-.45 1-1s-.45-1-1-1-1 .45-1 1 .45 1 1 1zm-4 5c2.33 0 4.31-1.46 5.11-3.5H6.89C7.69 14.54 9.67 16 12 16z"
            />
          </svg>
        </a>
        {
          showMinigamesNav && (
            <a href="/minigames" class="nav2-icon" aria-label="Minigames" title="Minigames">
              <svg width="38" height="38" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="3" y="7" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.6" />
                <path d="M8 11h2v2H8zm3 0h2v2h-2zm3 0h2v2h-2z" fill="currentColor" />
                <path d="M6 7V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
              </svg>
            </a>
          )
        }
        {
          showRpgNav && (
            <a href="/rpg" class="nav2-icon" aria-label="RPG Quests" title="RPG Quests">
              <svg width="38" height="38" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path
                  d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
                  opacity="0.95"
                />
              </svg>
            </a>
          )
        }
        {
          showBlogpostNav && (
            <a href="/blogpost" class="nav2-icon" aria-label="Blogpost erstellen" title="Blogpost erstellen">
              <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="miter" stroke-linecap="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                {/* Oberlippe: eckiger Cupid's Bow, gerade Unterkante */}
                <path d="M 3 11 L 5 10 L 8 7 L 12 9.5 L 16 7 L 19 10 L 21 11 Z" />
                {/* Zunge: drei klar separierte verschachtelte Dreiecke,
                   Spitze jeweils nach unten */}
                <path d="M 4 11 L 20 11 L 12 23 Z" />
                <path d="M 7 13.4 L 17 13.4 L 12 20.6 Z" />
                <path d="M 10 15.8 L 14 15.8 L 12 18.2 Z" />
              </svg>
            </a>
          )
        }
      </div>

      <details class="nav2-drawer">
        <summary class="nav2-drawer-summary" title="Menü öffnen">
          <span class="nav2-visually-hidden">Menü</span>
          <svg class="nav2-burger-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </summary>
        <div class="nav2-drawer-panel">
          <a href="/quotes/new" class="nav2-drawer-link" title="Zitate — einreichen und verwalten">
            <span class="nav2-drawer-ic" aria-hidden="true">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                <path
                  d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-4-8c.55 0 1-.45 1-1s-.45-1-1-1-1 .45-1 1 .45 1 1 1zm8 0c.55 0 1-.45 1-1s-.45-1-1-1-1 .45-1 1 .45 1 1 1zm-4 5c2.33 0 4.31-1.46 5.11-3.5H6.89C7.69 14.54 9.67 16 12 16z"
                />
              </svg>
            </span>
            <span>Zitate</span>
          </a>
          {
            showMinigamesNav && (
              <a href="/minigames" class="nav2-drawer-link" title="Minigames">
                <span class="nav2-drawer-ic" aria-hidden="true">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="3" y="7" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.6" />
                    <path d="M8 11h2v2H8zm3 0h2v2h-2zm3 0h2v2h-2z" fill="currentColor" />
                    <path d="M6 7V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                  </svg>
                </span>
                <span>Minigames</span>
              </a>
            )
          }
          {
            showRpgNav && (
              <a href="/rpg" class="nav2-drawer-link" title="RPG Quests">
                <span class="nav2-drawer-ic" aria-hidden="true">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path
                      d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
                      opacity="0.95"
                    />
                  </svg>
                </span>
                <span>Quests</span>
              </a>
            )
          }
          {
            showBlogpostNav && (
              <a href="/blogpost" class="nav2-drawer-link" title="Blogpost erstellen">
                <span class="nav2-drawer-ic" aria-hidden="true">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="miter" stroke-linecap="round" xmlns="http://www.w3.org/2000/svg">
                    <path d="M 3 11 L 5 10 L 8 7 L 12 9.5 L 16 7 L 19 10 L 21 11 Z" />
                    <path d="M 4 11 L 20 11 L 12 23 Z" />
                    <path d="M 7 13.4 L 17 13.4 L 12 20.6 Z" />
                    <path d="M 10 15.8 L 14 15.8 L 12 18.2 Z" />
                  </svg>
                </span>
                <span>Blogpost</span>
              </a>
            )
          }
          {
            isHome && (
              <div class="nav2-drawer-theme">
                <ThemeToggle />
              </div>
            )
          }
        </div>
      </details>
    </div>
    <div class="nav2-right">
      {
        isSuperuser && gitBadgeLabel && (
          <span class="nav2-git-badge" title={gitBadgeTitle} aria-label={`Git: ${gitBadgeLabel}`}>
            <svg
              class="nav2-git-badge-ic"
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="6" cy="6" r="2.2" />
              <circle cx="6" cy="18" r="2.2" />
              <circle cx="18" cy="12" r="2.2" />
              <path d="M6 8v8" />
              <path d="M8 18h4a4 4 0 0 0 4-4v-2" />
            </svg>
            <span class="nav2-git-badge-label">{gitBadgeLabel}</span>
            {gitInfo?.shortSha && gitInfo.branch && (
              <span class="nav2-git-badge-sha">@{gitInfo.shortSha}</span>
            )}
          </span>
        )
      }
      {
        isHome && (
          <div class="nav2-theme-bar">
            <ThemeToggle />
          </div>
        )
      }
      <div class="nav2-login-wrap">
        <LoginWidget client:load initialUser={sessionUser} />
      </div>
    </div>
  </div>

  {
    !isHome && (
      <div class="nav2-brand-layer">
        <a href="/" class="nav2-icon nav2-icon--home" aria-label="Startseite" title="Startseite">
          <svg width="38" height="38" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path
              d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1v-9.5z"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    )
  }
</nav>

<style>
  .nav2-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .nav2 {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding-top: env(safe-area-inset-top, 0px);
    pointer-events: none;
  }

  .nav2-strip {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    min-height: var(--nav-strip-h);
    padding: 0 0.25rem;
    pointer-events: auto;
  }

  .nav2-left {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 0.15rem;
    min-width: 0;
  }

  .nav2-left-desktop {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.15rem;
  }

  .nav2-drawer {
    display: none;
    position: relative;
  }

  .nav2-drawer-summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 12px;
    color: var(--nav2-fg);
    border-radius: 8px;
    transition: background 0.15s ease;
  }

  .nav2-drawer-summary::-webkit-details-marker {
    display: none;
  }

  .nav2-drawer-summary::marker {
    content: '';
  }

  .nav2-drawer-summary:hover,
  .nav2-drawer-summary:focus-visible {
    background: var(--nav2-drawer-hover);
    outline: none;
  }

  .nav2-burger-icon {
    display: block;
  }

  .nav2-drawer-panel {
    position: absolute;
    left: 0;
    top: calc(100% + 2px);
    min-width: 12rem;
    padding: 0.35rem 0;
    background: var(--nav2-drawer-bg);
    border: 1px solid var(--nav2-drawer-border);
    border-radius: 10px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
    z-index: 5;
  }

  .nav2-drawer-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 1rem;
    color: var(--nav2-drawer-text);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .nav2-drawer-link:hover,
  .nav2-drawer-link:focus-visible {
    background: var(--nav2-drawer-hover);
    outline: none;
  }

  .nav2-drawer-ic {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    color: var(--nav2-fg);
  }

  .nav2-drawer-theme {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 0.45rem 1rem 0.65rem;
    border-top: 1px solid var(--nav2-drawer-border);
  }

  .nav2-drawer-theme :global(.theme-toggle) {
    width: 100%;
    justify-content: flex-start;
    gap: 0.65rem;
    padding: 0.4rem 0.5rem;
  }

  .nav2-drawer-theme :global(.theme-toggle)::after {
    content: 'Hell / Dunkel';
    font-size: 0.95rem;
    color: var(--nav2-drawer-text);
  }

  @media screen and (max-width: 767px) {
    .nav2-left-desktop {
      display: none;
    }

    .nav2-drawer {
      display: block;
    }

    .nav2-theme-bar {
      display: none;
    }
  }

  @media screen and (min-width: 768px) {
    .nav2-drawer-theme {
      display: none;
    }
  }

  .nav2-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
  }

  .nav2-login-wrap {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .nav2-theme-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 0.15rem;
  }

  .nav2-git-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-right: 0.4rem;
    padding: 0.2rem 0.55rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.72rem;
    line-height: 1;
    color: var(--nav2-fg);
    background: var(--nav2-drawer-hover, rgba(127, 127, 127, 0.18));
    border: 1px solid var(--nav2-drawer-border, rgba(127, 127, 127, 0.35));
    border-radius: 999px;
    white-space: nowrap;
    max-width: 22ch;
    overflow: hidden;
    text-overflow: ellipsis;
    cursor: help;
    user-select: text;
  }

  .nav2-git-badge-ic {
    flex-shrink: 0;
    opacity: 0.8;
  }

  .nav2-git-badge-label {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nav2-git-badge-sha {
    opacity: 0.65;
  }

  @media screen and (max-width: 480px) {
    .nav2-git-badge {
      max-width: 10ch;
    }
    .nav2-git-badge-sha {
      display: none;
    }
  }

  .nav2-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
    color: var(--nav2-fg);
    text-decoration: none;
    flex-shrink: 0;
    border-radius: 8px;
    transition: background 0.15s ease;
  }

  .nav2-icon:hover,
  .nav2-icon:focus-visible {
    background: var(--nav2-drawer-hover);
    outline: none;
  }

  .nav2-brand-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: env(safe-area-inset-top, 0px);
    bottom: auto;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    z-index: 3;
    pointer-events: none;
  }

  .nav2-icon--home {
    pointer-events: auto;
    margin-top: 0.35rem;
    padding: 10px;
  }
</style>
