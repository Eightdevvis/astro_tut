---
/**
 * BewareOfBugsBanner.astro
 *
 * Diagonales Eck-Ribbon unten rechts, das aktiv wird, wenn fuer das gegebene
 * Recht in der Super-Einstellungen-Tabelle die "Beware of Bugs"-Zeile
 * aktiviert ist.
 *
 * Einbau pro Seite, z. B.:
 *   <BewareOfBugsBanner permission="rpg_access" />
 *
 * Server-side gerendert (Astro-Frontmatter) -> kein Flash beim Page-Load,
 * keine Client-DB-Calls noetig.
 */
import { hasPermissionWarning } from '../lib/permissions.js';

const { permission, label, tooltip } = Astro.props;
const show = permission ? await hasPermissionWarning(permission) : false;
const ribbonText = label || 'Beware of bugs';
const titleText = tooltip || 'Frisches Feature – Bugs sind sehr wahrscheinlich. Wenn du etwas merkst: bitte melden.';
---

{show && (
  <aside class="beware-of-bugs-corner" role="status" aria-label="Bug-Warnung" title={titleText}>
    <div class="beware-of-bugs-ribbon">
      <span class="beware-of-bugs-ribbon__icon" aria-hidden="true">⚠</span>
      <span class="beware-of-bugs-ribbon__text">{ribbonText}</span>
    </div>
  </aside>
)}

<style>
  /* Container belegt das eckige Quadrat unten rechts. overflow: hidden clippt
     die ueberlappenden Bandenden, sodass das Ribbon nur die Eck-Diagonale
     zeigt. Geometrie ist so abgestimmt, dass die Ribbon-Bounding-Box nach
     45deg-Rotate exakt in den Container passt. */
  .beware-of-bugs-corner {
    position: fixed;
    bottom: 0;
    right: 0;
    width: 160px;
    height: 160px;
    overflow: hidden;
    pointer-events: none;
    z-index: 9999;
  }
  .beware-of-bugs-ribbon {
    position: absolute;
    /* zentriert im Container, dann gedreht. Width ~ Container-Diagonale,
       sodass die Enden gerade ueber die Seiten ragen und sauber abgeschnitten
       werden. */
    left: 50%;
    top: 50%;
    width: 230px;
    margin-left: -115px;
    margin-top: -15px;
    transform: rotate(-45deg);
    transform-origin: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 6px 0;
    background: linear-gradient(180deg, #fde68a 0%, #facc15 50%, #eab308 100%);
    color: #1f1f1f;
    border-top: 1px solid rgba(180, 83, 9, 0.7);
    border-bottom: 1px solid rgba(180, 83, 9, 0.7);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.22);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .beware-of-bugs-ribbon__icon {
    font-size: 0.9rem;
    line-height: 1;
  }
  @media (max-width: 480px) {
    .beware-of-bugs-corner {
      width: 130px;
      height: 130px;
    }
    .beware-of-bugs-ribbon {
      width: 190px;
      margin-left: -95px;
      margin-top: -13px;
      font-size: 0.7rem;
      padding: 5px 0;
    }
  }
</style>
