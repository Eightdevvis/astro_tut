---
/**
 * BewareOfBugsBanner.astro
 *
 * Diagonales Eck-Ribbon unten rechts, das aktiv wird, wenn fuer das gegebene
 * Recht in der Super-Einstellungen-Tabelle die "Beware of Bugs"-Zeile
 * aktiviert ist.
 *
 * Einbau pro Seite, z. B.:
 *   <BewareOfBugsBanner permission="rpg_access" />
 *
 * Server-side gerendert (Astro-Frontmatter) -> kein Flash beim Page-Load,
 * keine Client-DB-Calls noetig.
 */
import { hasPermissionWarning } from '../lib/permissions.js';

const { permission, label, tooltip } = Astro.props;
const show = permission ? await hasPermissionWarning(permission) : false;
const titleText = tooltip || 'Frisches Feature – Bugs sind sehr wahrscheinlich. Wenn du etwas merkst: bitte melden.';
---

{show && (
  <aside class="beware-of-bugs-corner" role="status" aria-label="Bug-Warnung" title={titleText}>
    <div class="beware-of-bugs-ribbon">
      {label ? (
        <span class="beware-of-bugs-ribbon__text">{label}</span>
      ) : (
        <>
          <span class="beware-of-bugs-ribbon__text">Fresh Feature</span>
          <span class="beware-of-bugs-ribbon__icon" aria-hidden="true">⚠</span>
          <span class="beware-of-bugs-ribbon__text">Beware of Bugs</span>
        </>
      )}
    </div>
  </aside>
)}

<style>
  /* Container spannt das ganze Viewport — overflow:hidden clippt das Band
     dann an den Viewport-Kanten (rechts/unten), nicht an einer kleinen
     Eck-Box. Damit gibt es keinen harten Cut innerhalb der Page; das
     innere Bandende laeuft per Mask sanft aus. */
  .beware-of-bugs-corner {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 9999;
  }
  .beware-of-bugs-ribbon {
    position: absolute;
    /* Banner sitzt diagonal ueber der unteren rechten Ecke. Negative
       right-Wert + Bottom-Offset schieben einen Bandende ueber den
       rechten Viewport-Rand hinaus, wo es vom Container-Overflow geclippt
       wird. */
    bottom: 70px;
    right: -130px;
    width: 440px;
    transform: rotate(-45deg);
    transform-origin: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 8px 0;
    background: linear-gradient(180deg, #fde68a 0%, #facc15 50%, #eab308 100%);
    color: #1f1f1f;
    border-top: 1px solid rgba(180, 83, 9, 0.7);
    border-bottom: 1px solid rgba(180, 83, 9, 0.7);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.28);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    /* Sanftes Auslaufen am linken (sichtbaren) Bandende; rechts bleibt
       voll, weil es ohnehin vom Viewport-Rand geclippt wird. */
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 18%, #000 100%);
            mask-image: linear-gradient(90deg, transparent 0%, #000 18%, #000 100%);
  }
  .beware-of-bugs-ribbon__icon {
    font-size: 1rem;
    line-height: 1;
  }
  @media (max-width: 480px) {
    .beware-of-bugs-ribbon {
      bottom: 56px;
      right: -100px;
      width: 340px;
      font-size: 0.7rem;
      padding: 6px 0;
      gap: 8px;
    }
  }
</style>
