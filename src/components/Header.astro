---
import Menu from './Menu.astro';
import Navigation from "./Navigation.astro";
import ThemeIcon from './ThemeIcon.astro';

---

<header>
    <nav>
        <Menu />
        <ThemeIcon />
        <Navigation />
        
    </nav>
</header>

<style>
  header {
    background: linear-gradient(90deg, var(--color-nav-start), var(--color-nav-end));
    font-family: var(--font-nav, 'Courier New', Courier, monospace);
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    padding: 1rem;
  }

  
  nav {
    display: flex;
    gap: 1rem;
  }

</style>