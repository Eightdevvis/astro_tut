---
// Ketcher (ketcher-react + ketcher-standalone, 3.x) versendet im Lazy-Chunk
// CJS-Reste, die im Browser `require(...)` bare aufrufen — ohne Shim crasht
// dann der ganze Chunk beim Eval mit "require is not defined", noch bevor
// `onInit` überhaupt feuern kann (siehe Mikrobio-Debug-Log:
// `prefetch-failed`, `canvas-chunk-import-failed`).
//
// Lösung: ein No-op-`require`-Stub auf window, **bevor** irgendein Modul-
// Script lädt. `is:inline` hängt das Script direkt in <head> und Astro
// berührt es nicht mehr — läuft synchron vor allen deferred Module-Scripts.
//
// Falls Ketcher tatsächlich einen bestimmten Modul-Inhalt erwartet, wird
// dann ein neuer (anderer) Fehler im Debug-Panel auftauchen — keine stille
// Verschlechterung.
---
<script is:inline>
  (function () {
    if (typeof window === 'undefined') return;
    if (typeof window.require !== 'undefined') return;
    // Singleton-Proxy: antwortet auf JEDEN Property-Access (default, default.x,
    // default.x.y ...) mit sich selbst, ist callable, ist konstruierbar, und
    // gibt für Spezial-Symbole sinnvolle Werte zurück (sonst crasht z. B.
    // `String(stub)` oder `await stub`). __esModule:true umgeht ESM-Interop-
    // Re-Wrapping, then:undefined verhindert dass jemand stub für ein Promise
    // hält.
    var SINGLETON;
    var target = function () { return SINGLETON; };
    SINGLETON = new Proxy(target, {
      get: function (_, prop) {
        if (prop === '__esModule') return true;
        if (prop === 'then') return undefined;
        if (prop === Symbol.toPrimitive) return function () { return ''; };
        if (prop === Symbol.iterator) return function () {
          return { next: function () { return { done: true, value: undefined }; } };
        };
        if (prop === 'toString' || prop === 'toJSON' || prop === 'valueOf') {
          return function () { return ''; };
        }
        return SINGLETON;
      },
      apply: function () { return SINGLETON; },
      construct: function () { return SINGLETON; },
    });
    window.require = function () { return SINGLETON; };
    window.require.resolve = function () { return ''; };
    window.require.cache = SINGLETON;
  })();
</script>
