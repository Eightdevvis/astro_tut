---
/**
 * PageFavicon.astro
 *
 * Setzt das Browser-Tab-Favicon auf das Nav-Icon der jeweiligen Seite.
 * Einbau pro Seite, z. B. <PageFavicon icon="rpg" />, statt dem
 * statischen <link rel="icon" href="/favicon.svg">.
 *
 * Die SVGs sind als Strings hinterlegt und werden als data:-URL geliefert,
 * damit es keinen extra Asset-Request gibt. Farben sind fest (schwarz);
 * @media (prefers-color-scheme: dark) flippt auf weiss.
 */
const { icon } = Astro.props;

const ICONS: Record<string, string> = {
  quotes: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><style>path{fill:#111}@media(prefers-color-scheme:dark){path{fill:#fff}}</style><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-4-8c.55 0 1-.45 1-1s-.45-1-1-1-1 .45-1 1 .45 1 1 1zm8 0c.55 0 1-.45 1-1s-.45-1-1-1-1 .45-1 1 .45 1 1 1zm-4 5c2.33 0 4.31-1.46 5.11-3.5H6.89C7.69 14.54 9.67 16 12 16z"/></svg>`,
  rpg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><style>path{fill:#111}@media(prefers-color-scheme:dark){path{fill:#fff}}</style><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`,
  blogpost: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><style>path{fill:none;stroke:#111;stroke-width:1.5;stroke-linejoin:miter;stroke-linecap:round}@media(prefers-color-scheme:dark){path{stroke:#fff}}</style><path d="M3 11L5 10L8 7L12 9.5L16 7L19 10L21 11Z"/><path d="M4 11L20 11L12 23Z"/><path d="M7 13.4L17 13.4L12 20.6Z"/><path d="M10 15.8L14 15.8L12 18.2Z"/></svg>`,
  minigames: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><style>rect,path{fill:none;stroke:#111;stroke-width:1.6}.dot{fill:#111;stroke:none}@media(prefers-color-scheme:dark){rect,path{stroke:#fff}.dot{fill:#fff}}</style><rect x="3" y="7" width="18" height="12" rx="2"/><path class="dot" d="M8 11h2v2H8zm3 0h2v2h-2zm3 0h2v2h-2z"/><path d="M6 7V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2" stroke-linecap="round"/></svg>`,
};

const svg = icon && ICONS[icon] ? ICONS[icon] : null;
const href = svg ? `data:image/svg+xml,${encodeURIComponent(svg)}` : '/favicon.svg';
---
<link rel="icon" type="image/svg+xml" href={href} />
