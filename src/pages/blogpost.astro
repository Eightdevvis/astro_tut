---
import { jwtVerify } from 'jose';
import { hasPermission } from '../lib/permissions.js';
import { getJwtSecretBytes } from '../lib/jwt-secret.js';
import Nav2 from '../components/Nav2.astro';
import SiteFontOverrides from '../components/SiteFontOverrides.astro';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeClient from '../components/ThemeClient.astro';
import BewareOfBugsBanner from '../components/BewareOfBugsBanner.astro';
import { ensureDbSchema, getDb } from '../lib/db.js';
import '../styles/global.css';

const token = Astro.cookies.get('session')?.value;
let username = null;
let allowed = false;

if (token) {
  try {
    const { payload } = await jwtVerify(token, getJwtSecretBytes());
    username = String(payload.username || '');
    allowed = await hasPermission(username, 'blogpost_poster');
  } catch {
    username = null;
  }
}

const isLoggedIn = Boolean(username);
const canPost = allowed; // = eingeloggt UND blogpost_poster

// Hub-Tiles: Ausschnitte aus existierenden Posts. Die Hub-Seite ist fuer
// jeden zugaenglich (auch ausgeloggt) — das Auth-Gate wird erst beim Klick
// auf das `+`-Tile gezogen.
type HubTile = { id: number; snippet: string; date: string };
const HUB_TILE_COUNT = 24; // 5x5-Grid mit dem zentralen `+`-Tile in der Mitte
let hubTiles: HubTile[] = [];
try {
  await ensureDbSchema();
  const r = await getDb().execute({
    sql: `SELECT id, content_text, created_at
            FROM blog_posts
           ORDER BY datetime(created_at) DESC, id DESC
           LIMIT ?`,
    args: [HUB_TILE_COUNT],
  });
  hubTiles = (r.rows || []).map((row) => {
    const id = Number(row.id ?? 0);
    const text = String(row.content_text || '').replace(/\s+/g, ' ').trim();
    const span = Math.min(380, text.length);
    const maxStart = Math.max(0, text.length - span);
    const start = maxStart > 0 ? Math.floor(Math.random() * (maxStart + 1)) : 0;
    const snippet = text.slice(start, start + span);
    const date = String(row.created_at || '').replace('T', ' ').slice(0, 10);
    return { id, snippet, date };
  }).filter((t) => t.id > 0);
} catch {
  hubTiles = [];
}
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <ThemeInit />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f4f1ea" />
    <title>BLOGPOST</title>
    <SiteFontOverrides />
    <style>
      html {
        -webkit-text-size-adjust: 100%;
      }
      body {
        margin: 0;
        min-height: 100dvh;
        box-sizing: border-box;
        background: var(--site-body-bg);
        color: var(--site-body-text);
        font-family: var(--font-family);
        padding-top: calc(var(--nav-strip-h) + env(safe-area-inset-top, 0px));
        overflow-x: hidden;
      }
      .page {
        --past-posts-offset: 8dvh;
        max-width: 100%;
        margin: 0 auto;
        padding-top: max(1rem, env(safe-area-inset-top));
        padding-right: max(0.5rem, env(safe-area-inset-right));
        padding-bottom: max(4rem, env(safe-area-inset-bottom));
        padding-left: max(0.5rem, env(safe-area-inset-left));
      }
      .page[data-mode="hub"] {
        padding-left: 0;
        padding-right: 0;
        width: 100%;
        max-width: 100%;
        margin: 0;
      }
      .page[data-mode="editor"] {
        max-width: 1100px;
      }
      .no-permission {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        letter-spacing: 0.08em;
      }
      .no-permission a {
        margin-top: 1rem;
        color: inherit;
        opacity: 0.75;
      }
      .editor-shell {
        position: relative;
        width: min(860px, 100%);
        margin: 0 auto;
        min-height: 80dvh;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .editor-activation {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 6.5rem;
        height: 6.5rem;
        transform: translate(-50%, -50%);
        border: 0;
        background: transparent;
        color: var(--site-body-text);
        border-radius: 0.7rem;
        display: grid;
        place-items: center;
        font-size: clamp(3rem, 8vw, 5rem);
        cursor: pointer;
        z-index: 6;
      }
      .editor-wrap {
        position: relative;
        width: min(620px, 100%);
      }
      .editor-box {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1;
        min-height: 420px;
        border-radius: 0.7rem;
        border: 1px solid var(--site-card-border);
        background: var(--site-card-bg);
        box-shadow: var(--site-card-shadow);
        padding: 1.25rem;
        box-sizing: border-box;
        overflow: hidden;
      }
      .editor-wrap.active .editor-activation {
        display: none;
      }
      #editor {
        min-height: calc(100% - 0.25rem);
        outline: none;
        white-space: pre-wrap;
        word-break: break-word;
        font-size: 1.08rem;
        line-height: 1.6;
        color: var(--editor-accent, #8dc5ff);
      }
      .editor-wrap:not(.active) #editor {
        visibility: hidden;
        pointer-events: none;
      }
      #editor:empty::before {
        content: 'Schreib deinen Post hier...';
        opacity: 0.45;
      }
      #doodleCanvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 2;
        cursor: crosshair;
        pointer-events: none;
      }
      #doodleCanvas.active {
        pointer-events: auto;
      }
      .tool {
        position: absolute;
        z-index: 5;
        width: 1.9rem;
        height: 1.9rem;
        border: none;
        background: transparent;
        color: var(--site-body-text);
        display: grid;
        place-items: center;
        cursor: pointer;
        transform: rotate(var(--rot, 0deg));
        font-size: 1.2rem;
      }
      .tool.active {
        color: var(--editor-accent, #8dc5ff);
      }
      .tool.bold { left: -2.6rem; top: 18%; --rot: -13deg; }
      .tool.italic { left: -2.4rem; top: 42%; --rot: 11deg; }
      .tool.font { left: 43%; top: -2.4rem; --rot: -7deg; }
      .tool.list { left: 59%; top: -2.15rem; --rot: 8deg; }
      .tool.doodle { right: -2.45rem; top: 34%; --rot: -10deg; }
      .tool.eraser { right: -2.8rem; top: 48%; --rot: -4deg; }
      .tool.color { right: -2.25rem; top: 63%; --rot: 14deg; }
      .editor-actions {
        margin-top: 0.85rem;
        display: flex;
        justify-content: center;
      }
      .save-btn {
        border: 1px solid var(--site-card-border);
        border-radius: 0.7rem;
        padding: 0.6rem 0.9rem;
        background: var(--site-card-bg);
        color: var(--site-body-text);
        cursor: pointer;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .msg {
        min-height: 1.2rem;
        margin-top: 0.45rem;
        text-align: right;
        font-size: 0.85rem;
        opacity: 0.85;
      }
      .past-posts {
        margin-top: var(--past-posts-offset);
      }
      .past-posts h2 {
        margin: 0 0 0.8rem;
        font-size: 0.95rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        opacity: 0.7;
      }
      .post-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 0.8rem;
      }
      .post-card {
        width: 100%;
        border: 1px solid var(--site-card-border);
        border-radius: 0.9rem;
        padding: 0.85rem;
        background: var(--site-card-bg);
        box-shadow: var(--site-card-shadow);
        min-height: 130px;
        text-align: left;
        color: inherit;
        cursor: pointer;
      }
      .post-date {
        font-size: 0.72rem;
        opacity: 0.6;
        margin-bottom: 0.45rem;
      }
      .post-preview {
        font-size: 0.92rem;
        white-space: pre-wrap;
      }
      .post-modal {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 120;
        padding: 1rem;
      }
      .post-modal.show {
        display: flex;
      }
      .post-modal-panel {
        width: min(780px, 100%);
        max-height: 85dvh;
        overflow: auto;
        background: var(--site-card-bg);
        color: var(--site-body-text);
        border: 1px solid var(--site-card-border);
        border-radius: 0.8rem;
        box-shadow: var(--site-card-shadow);
        padding: 1rem;
      }
      .post-modal-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.7rem;
        margin-bottom: 0.6rem;
      }
      .post-modal-actions {
        display: flex;
        gap: 0.5rem;
      }
      .post-modal-edit,
      .post-modal-delete,
      .post-modal-close {
        border: 1px solid var(--site-card-border);
        background: transparent;
        color: inherit;
        border-radius: 0.45rem;
        cursor: pointer;
        padding: 0.35rem 0.55rem;
      }
      .post-modal-delete {
        border-color: rgba(220, 80, 80, 0.55);
        color: #d04d4d;
      }
      .post-modal-body {
        white-space: pre-wrap;
        line-height: 1.55;
      }
      @media (max-width: 700px) {
        .editor-wrap {
          width: min(95vw, 620px);
        }
        .tool.bold { left: 1%; top: -2.1rem; }
        .tool.italic { left: 14%; top: -2rem; }
        .tool.font { left: 31%; top: -2.2rem; }
        .tool.list { left: 48%; top: -2.05rem; }
        .tool.doodle { left: 65%; top: -2rem; right: auto; }
        .tool.eraser { left: 80%; top: -2.05rem; right: auto; }
        .tool.color { left: 92%; top: -2.15rem; right: auto; }
      }

      /* Hub: chaotisch zusammengeklebte Zeitungsschnipsel an einer Wand.
         Tiles werden absolut positioniert, mit per-JS gewuerfelten Werten
         (Font, Size, Letter/Line-Spacing, Position, z-index). Kein Grid,
         keine sauberen Reihen — und das `+` Tile in der Mitte als klare
         Einstiegs-Marke. */
      .hub-grid {
        /* Parent .page wird im hub-mode auf width:100% / margin:0 gezwungen,
           also reicht hier 100% — kein vw-Breakout noetig (der wuerde mit
           overflow-x:hidden + Scrollbar die linke Spalte abschneiden). */
        position: relative;
        width: 100%;
        margin: 0;
        padding: 0;
        transition: opacity 540ms ease;
      }
      .hub-tile {
        position: absolute;
        display: block;
        text-decoration: none;
        color: inherit;
        background: transparent;
        border: 1px solid rgba(0, 0, 0, 0.18);
        border-radius: 0;
        padding: 0;
        overflow: hidden;
        cursor: pointer;
        box-sizing: border-box;
        transform-origin: center;
        will-change: opacity, transform;
        transition:
          opacity 520ms cubic-bezier(0.34, 0.06, 0.46, 1),
          transform 520ms cubic-bezier(0.34, 0.06, 0.46, 1);
        transition-delay: calc(var(--tile-i, 0) * 18ms);
      }
      :global(html.dark) .hub-tile {
        border-color: rgba(255, 255, 255, 0.18);
      }
      .hub-tile--post {
        opacity: 0.92;
      }
      .hub-tile--post:hover,
      .hub-tile--post:focus-visible {
        outline: none;
        opacity: 1;
        border-color: currentColor;
        z-index: 5;
      }
      .hub-tile-date {
        display: none; /* Datum nicht anzeigen — fluttert das Layout zu sehr. */
      }
      .hub-tile-snippet {
        display: block;
      }
      /* Das Editor-Tile bleibt fest in der Mitte — z-index ueber allem,
         damit es nicht von einem Post-Schnipsel verdeckt wird. */
      .hub-tile--editor {
        /* Position/Hoehe/Breite werden vom Masonry-JS gesetzt. */
        border: 1px solid rgba(0, 0, 0, 0.18);
        border-radius: 0;
        background: var(--site-card-bg);
        display: grid;
        place-items: center;
        z-index: 50;
        max-height: none;
      }
      :global(html.dark) .hub-tile--editor {
        border-color: rgba(255, 255, 255, 0.18);
      }
      .hub-tile-plus {
        font-size: clamp(2.4rem, 5vw, 3.4rem);
        line-height: 1;
        opacity: 0.75;
        transition: opacity 220ms ease, transform 220ms ease;
      }
      .hub-tile--editor:hover .hub-tile-plus,
      .hub-tile--editor:focus-visible .hub-tile-plus {
        opacity: 1;
        transform: scale(1.08);
      }

      /* Mode-Switch: Hub blendet aus, Editor-Shell faded rein. */
      .page[data-mode="hub"] .editor-shell {
        opacity: 0;
        transform: scale(0.6);
        pointer-events: none;
        max-height: 0;
        margin: 0;
        overflow: hidden;
      }
      .page[data-mode="hub"] .past-posts {
        opacity: 0;
        transform: translateY(20px);
        pointer-events: none;
        max-height: 0;
        margin: 0;
        overflow: hidden;
      }
      .page[data-mode="editor"] .hub-tile--post {
        opacity: 0;
        transform: scale(0.4);
        pointer-events: none;
      }
      .page[data-mode="editor"] .hub-tile--editor {
        opacity: 0;
        transform: scale(2.4);
        pointer-events: none;
        transition-delay: 0ms;
      }
      .page[data-mode="editor"] .hub-grid {
        max-height: 0;
        margin: 0;
        padding: 0;
        opacity: 0;
        transition: max-height 540ms ease 320ms, margin 540ms ease 320ms,
          padding 540ms ease 320ms, opacity 320ms ease 360ms;
      }
      .editor-shell {
        transition:
          opacity 540ms ease 240ms,
          transform 620ms cubic-bezier(0.22, 0.7, 0.32, 1) 240ms,
          max-height 540ms ease 240ms,
          margin 540ms ease 240ms;
      }
      .past-posts {
        transition:
          opacity 540ms ease 360ms,
          transform 540ms ease 360ms,
          max-height 540ms ease 360ms,
          margin 540ms ease 360ms;
      }

      /* Mobile-Grid: 3 Spalten, `+` in der Mitte. */
      @media (max-width: 720px) {
        .hub-grid { grid-template-columns: repeat(3, 1fr); gap: 0.4rem; }
        .hub-tile--editor { grid-column: 2; grid-row: 2; }
        .hub-tile { font-size: 0.66rem; padding: 0.45rem 0.5rem; }
      }

      /* Auth-Hinweis: kleine Caption direkt unter dem +Tile (kein gelber
         Balken mehr). Wird per data-Attribut & Klasse kurz eingeblendet. */
      .hub-tile--editor[data-hint] {
        position: absolute;
      }
      .hub-tile--editor[data-hint]::after {
        content: attr(data-hint);
        position: absolute;
        top: calc(100% + 0.5rem);
        left: 50%;
        transform: translateX(-50%);
        white-space: nowrap;
        font-size: 0.78rem;
        letter-spacing: 0.04em;
        opacity: 0;
        animation: hub-hint-flash 2400ms ease both;
        color: var(--site-body-text);
        pointer-events: none;
      }
      @keyframes hub-hint-flash {
        0%, 100% { opacity: 0; }
        10%, 75% { opacity: 0.85; }
      }
      .hub-tile--editor.shake {
        animation: hub-tile-shake 480ms ease;
      }
      @keyframes hub-tile-shake {
        0%, 100% { transform: none; }
        20% { transform: translateX(-5px); }
        40% { transform: translateX(5px); }
        60% { transform: translateX(-5px); }
        80% { transform: translateX(5px); }
      }
    </style>
  </head>
  <body>
    <Nav2 />
    <main class="page" id="blogpostPage" data-mode="hub" data-logged-in={isLoggedIn ? 'true' : 'false'} data-can-post={canPost ? 'true' : 'false'}>
      <section class="hub-grid" id="hubGrid" aria-label="Post-Sammelstelle">
        {hubTiles.map((tile, i) => (
          <a
            class="hub-tile hub-tile--post"
            href={`/posts/db/${tile.id}`}
            style={`--tile-i: ${i};`}
            aria-label={`Post vom ${tile.date}`}
          >
            <span class="hub-tile-date">{tile.date}</span>
            <span class="hub-tile-snippet">{tile.snippet}</span>
          </a>
        ))}
        <button class="hub-tile hub-tile--editor" id="editorTile" type="button" aria-label="Neuen Blogpost schreiben">
          <span class="hub-tile-plus">+</span>
        </button>
      </section>

      <section class="editor-shell" aria-label="Blogpost Editor">
          <div class="editor-wrap" id="editorWrap">
            <button class="editor-activation" id="editorActivation" type="button" aria-label="Editor oeffnen">+</button>
            <button class="tool bold" data-tool="bold" title="Fett">B</button>
            <button class="tool italic" data-tool="italic" title="Kursiv"><em>I</em></button>
            <button class="tool font" data-tool="font" title="Schrift wechseln">Aa</button>
            <button class="tool list" data-tool="list" title="Liste">-</button>
            <button class="tool doodle" data-tool="doodle" title="Kritzeln">~</button>
            <button class="tool eraser" data-tool="eraser" title="Radiergummi">E</button>
            <button class="tool color" data-tool="color" title="Farbe">#</button>

            <div class="editor-box">
              <canvas id="doodleCanvas" width="1440" height="920"></canvas>
              <div id="editor" contenteditable="true" spellcheck="true"></div>
            </div>
            <div class="editor-actions">
              <button id="savePostBtn" class="save-btn" type="button">Post speichern</button>
            </div>
            <div class="msg" id="msg"></div>
          </div>
        </section>

        <section class="past-posts" id="pastPostsSection" aria-label="Vergangene Posts">
          <h2>Vergangene Posts</h2>
          <div class="post-grid" id="pastPostsGrid"></div>
        </section>
      <div class="post-modal" id="postModal" aria-hidden="true">
        <div class="post-modal-panel">
          <div class="post-modal-head">
            <div class="post-modal-actions">
              <button class="post-modal-edit" id="postModalEdit" type="button">Bearbeiten</button>
              <button class="post-modal-delete" id="postModalDelete" type="button">Loeschen</button>
            </div>
            <button class="post-modal-close" id="postModalClose" type="button">Schliessen</button>
          </div>
          <div class="post-modal-body" id="postModalBody"></div>
        </div>
      </div>
    </main>

    <script>
      const blogpostPage = document.getElementById('blogpostPage');
      const hubGrid = document.getElementById('hubGrid');
      const editorTile = document.getElementById('editorTile');

      // System-/Web-safe Fonts. KEINE der manuell hochgeladenen Custom-Fonts
      // (die liegen unter custom-* family-names) — die sind hier bewusst raus.
      const HUB_FONTS = [
        '"Times New Roman", Times, serif',
        'Georgia, "Times New Roman", serif',
        '"Palatino Linotype", "Book Antiqua", Palatino, serif',
        '"Book Antiqua", Palatino, serif',
        'Garamond, "Times New Roman", serif',
        '"Courier New", Courier, monospace',
        '"Lucida Console", Monaco, monospace',
        'Consolas, "Lucida Console", monospace',
        'Arial, Helvetica, sans-serif',
        'Helvetica, Arial, sans-serif',
        'Verdana, Geneva, sans-serif',
        '"Trebuchet MS", sans-serif',
        'Tahoma, Geneva, sans-serif',
        '"Arial Narrow", Arial, sans-serif',
        'Impact, "Arial Black", sans-serif',
        '"Arial Black", Impact, sans-serif',
        '"Brush Script MT", cursive',
        '"Comic Sans MS", "Comic Sans", cursive',
        '"Lucida Sans Unicode", "Lucida Grande", sans-serif',
      ];
      const HUB_WEIGHTS = [300, 400, 400, 500, 600, 700, 900];

      function hubRand(min, max) {
        return Math.random() * (max - min) + min;
      }
      function hubPick(arr) {
        return arr[Math.floor(Math.random() * arr.length)];
      }

      function decorateHubTiles() {
        if (!hubGrid) return;
        const postTiles = Array.from(hubGrid.querySelectorAll('.hub-tile--post'));
        const editorTileEl = hubGrid.querySelector('.hub-tile--editor');
        if (postTiles.length === 0 && !editorTileEl) return;

        const gridW = Math.max(0, Math.floor(hubGrid.getBoundingClientRect().width));
        if (gridW < 80) return;

        // Spaltenanzahl basierend auf Viewport. Pro Page gewuerfelt — manche
        // Spalten breiter, andere schmaler. Tiles in einer Spalte erben
        // die Spaltenbreite (= alle Tiles einer Spalte sind gleich breit).
        const targetCol = 320;
        const colCount = Math.max(2, Math.min(5, Math.round(gridW / targetCol)));

        // Random Gewicht pro Spalte (0.85..1.7). Mind. eine Spalte soll
        // deutlich breiter sein als der Schnitt — sonst sehen alle gleich
        // aus. Falls die Zufallsverteilung das nicht hergibt, hieven wir
        // eine zufaellige Spalte hoch.
        const weights = [];
        for (let c = 0; c < colCount; c += 1) {
          weights.push(hubRand(0.85, 1.7));
        }
        if (Math.max(...weights) < 1.45) {
          weights[Math.floor(Math.random() * colCount)] = hubRand(1.6, 2.0);
        }
        const totalWeight = weights.reduce((a, b) => a + b, 0);
        const colWidths = weights.map((w) => (w / totalWeight) * gridW);
        const colLefts = [];
        let leftAcc = 0;
        for (let c = 0; c < colCount; c += 1) {
          colLefts.push(leftAcc);
          leftAcc += colWidths[c];
        }

        // Reihenfolge: alle Post-Tiles random, das +-Tile etwa in der Mitte
        // der Liste — so landet es ungefaehr mittig in seiner Spalte.
        const postOrder = postTiles.map((tile) => ({ tile, isEditor: false }));
        postOrder.sort(() => Math.random() - 0.5);
        const order = postOrder.slice();
        if (editorTileEl) {
          const insertIdx = Math.floor(order.length / 2);
          order.splice(insertIdx, 0, { tile: editorTileEl, isEditor: true });
        }

        // Hilfsfunktion: aktuelle Spalte fuer dieses Tile bestimmen.
        // Editor-Tile bevorzugt eine mittlere Spalte (oder die kuerzeste
        // davon bei gerader Spaltenzahl). Post-Tiles gehen in die kuerzeste
        // Spalte.
        const centerCols = colCount % 2 === 1
          ? [Math.floor(colCount / 2)]
          : [colCount / 2 - 1, colCount / 2];
        const colHeights = new Array(colCount).fill(0);

        function pickCol(isEditor) {
          if (isEditor) {
            let best = centerCols[0];
            for (const c of centerCols) {
              if (colHeights[c] < colHeights[best]) best = c;
            }
            return best;
          }
          let best = 0;
          for (let c = 1; c < colCount; c += 1) {
            if (colHeights[c] < colHeights[best]) best = c;
          }
          return best;
        }

        // Layout tile-fuer-tile: Spalte picken (mit aktuellem colHeights),
        // Width setzen, Hoehe messen, Position setzen, colHeights updaten.
        // Wichtig: colHeights muss zwischen Tiles aktualisiert sein, sonst
        // landen alle Tiles in derselben Spalte.
        order.forEach((entry, i) => {
          const { tile, isEditor } = entry;
          const targetCol = pickCol(isEditor);
          const widthPx = colWidths[targetCol];
          if (isEditor) {
            tile.style.width = `${widthPx}px`;
            tile.style.height = `${widthPx}px`;
          } else {
            tile.style.fontFamily = hubPick(HUB_FONTS);
            tile.style.fontSize = `${hubRand(0.62, 1.4).toFixed(3)}rem`;
            tile.style.lineHeight = `${hubRand(1.0, 1.6).toFixed(2)}`;
            tile.style.letterSpacing = `${hubRand(-0.03, 0.14).toFixed(3)}em`;
            tile.style.fontWeight = String(hubPick(HUB_WEIGHTS));
            tile.style.fontStyle = Math.random() < 0.35 ? 'italic' : 'normal';
            tile.style.textTransform = Math.random() < 0.2 ? 'uppercase' : 'none';
            tile.style.opacity = `${hubRand(0.82, 1).toFixed(2)}`;
            tile.style.width = `${widthPx}px`;
            tile.style.height = '';
          }
          tile.style.setProperty('--tile-i', String(i));
          tile.style.left = '-9999px';
          tile.style.top = '0px';
          tile.style.visibility = 'hidden';
          tile.style.display = '';
          if (!isEditor) tile.style.zIndex = '1';
          const h = tile.offsetHeight || 80;
          tile.style.left = `${Math.round(colLefts[targetCol])}px`;
          tile.style.top = `${Math.round(colHeights[targetCol])}px`;
          tile.style.visibility = 'visible';
          colHeights[targetCol] += h;
        });

        hubGrid.style.height = `${Math.max(...colHeights, 320)}px`;
      }

      const activation = document.getElementById('editorActivation');
      const editorWrap = document.getElementById('editorWrap');
      const editor = document.getElementById('editor');
      const msg = document.getElementById('msg');
      const savePostBtn = document.getElementById('savePostBtn');
      const pastPostsSection = document.getElementById('pastPostsSection');
      const pastPostsGrid = document.getElementById('pastPostsGrid');
      const postModal = document.getElementById('postModal');
      const postModalClose = document.getElementById('postModalClose');
      const postModalEdit = document.getElementById('postModalEdit');
      const postModalDelete = document.getElementById('postModalDelete');
      const postModalBody = document.getElementById('postModalBody');
      const doodleCanvas = document.getElementById('doodleCanvas');
      const toolButtons = Array.from(document.querySelectorAll('.tool'));

      let fontMode = 0;
      const fonts = ['inherit', 'serif', 'sans-serif'];
      const palette = ['#8dc5ff', '#ff9ac2', '#8de8bf', '#ffd16d', '#d4b0ff', '#ffffff'];
      let colorIndex = 0;
      let currentColor = palette[colorIndex];
      let doodleMode = false;
      let eraserMode = false;
      let drawing = false;
      let lastX = 0;
      let lastY = 0;
      let currentEditingPostId = null;
      let openPostId = null;
      const postsById = new Map();

      function setMsg(text, good) {
        if (!msg) return;
        msg.textContent = text || '';
        msg.style.color = good ? 'lightgreen' : 'salmon';
      }

      function applyColor() {
        document.documentElement.style.setProperty('--editor-accent', currentColor);
        if (doodleMode && doodleCanvas) {
          const ctx = doodleCanvas.getContext('2d');
          if (ctx) {
            ctx.strokeStyle = currentColor;
            ctx.lineWidth = eraserMode ? 16 : 3;
            ctx.lineCap = 'round';
            ctx.globalCompositeOperation = eraserMode ? 'destination-out' : 'source-over';
          }
        }
      }

      function resizeCanvasToBox() {
        if (!doodleCanvas) return;
        const rect = doodleCanvas.getBoundingClientRect();
        if (!rect.width || !rect.height) return;
        const ratio = window.devicePixelRatio || 1;
        const targetWidth = Math.floor(rect.width * ratio);
        const targetHeight = Math.floor(rect.height * ratio);
        if (doodleCanvas.width === targetWidth && doodleCanvas.height === targetHeight) return;
        const previous = doodleCanvas.toDataURL('image/png');
        doodleCanvas.width = targetWidth;
        doodleCanvas.height = targetHeight;
        const ctx = doodleCanvas.getContext('2d');
        if (!ctx) return;
        ctx.scale(ratio, ratio);
        const img = new Image();
        img.onload = () => {
          ctx.drawImage(img, 0, 0, rect.width, rect.height);
          applyColor();
        };
        img.src = previous;
      }

      async function loadPosts() {
        if (!pastPostsGrid) return;
        try {
          const res = await fetch('/api/posts/mine', { credentials: 'same-origin' });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) return;
          const rows = Array.isArray(data.posts) ? data.posts : [];
          postsById.clear();
          rows.forEach((row) => {
            const id = Number(row?.id);
            if (Number.isInteger(id) && id > 0) postsById.set(id, row);
          });
          if (rows.length === 0) {
            pastPostsGrid.innerHTML = '<div class="post-card"><div class="post-preview">Noch keine Posts.</div></div>';
            return;
          }
          pastPostsGrid.innerHTML = rows
            .map((row) => {
              const fullText = String(row.content_text || '');
              const len = fullText.length;
              const span = Math.min(220, len);
              const maxStart = Math.max(0, len - span);
              const start = maxStart > 0 ? Math.floor(Math.random() * (maxStart + 1)) : 0;
              const preview = fullText.slice(start, start + span);
              const date = String(row.created_at || '').replace('T', ' ').slice(0, 16);
              const escapedFull = fullText.replace(/[<>&]/g, '');
              const id = Number(row.id);
              return `<button class="post-card" type="button" data-id="${id}" data-full="${escapedFull.replace(/"/g, '&quot;')}">
                <div class="post-date">${date}</div>
                <div class="post-preview">${preview.replace(/[<>&]/g, '')}</div>
              </button>`;
            })
            .join('');
          Array.from(pastPostsGrid.querySelectorAll('.post-card')).forEach((el) => {
            el.addEventListener('click', () => {
              const id = Number(el.getAttribute('data-id') || 0);
              openPostId = Number.isInteger(id) && id > 0 ? id : null;
              const full = el.getAttribute('data-full') || '';
              if (postModalBody) postModalBody.textContent = full;
              postModal?.classList.add('show');
              postModal?.setAttribute('aria-hidden', 'false');
            });
          });
        } catch {
          /* ignore */
        }
      }

      postModalClose?.addEventListener('click', () => {
        postModal?.classList.remove('show');
        postModal?.setAttribute('aria-hidden', 'true');
      });
      postModal?.addEventListener('click', (ev) => {
        if (ev.target === postModal) {
          postModal.classList.remove('show');
          postModal.setAttribute('aria-hidden', 'true');
        }
      });

      postModalEdit?.addEventListener('click', () => {
        if (!editor || !editorWrap || !openPostId) return;
        const row = postsById.get(openPostId);
        if (!row) return;
        editorWrap.classList.add('active');
        editor.innerHTML = String(row.content_html || '');
        currentEditingPostId = openPostId;
        if (savePostBtn) savePostBtn.textContent = 'Post aktualisieren';
        postModal?.classList.remove('show');
        postModal?.setAttribute('aria-hidden', 'true');
        editor.focus();
        resizeCanvasToBox();
        setMsg('Bearbeitungsmodus aktiv.', true);
      });

      postModalDelete?.addEventListener('click', async () => {
        if (!openPostId) return;
        const sure = window.confirm('Diesen Post wirklich loeschen?');
        if (!sure) return;
        postModalDelete.disabled = true;
        try {
          const res = await fetch(`/api/posts/${openPostId}`, {
            method: 'DELETE',
            credentials: 'same-origin',
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok || !data.success) {
            setMsg((data.error || 'Loeschen fehlgeschlagen').toUpperCase(), false);
            return;
          }
          if (currentEditingPostId === openPostId) {
            currentEditingPostId = null;
            if (savePostBtn) savePostBtn.textContent = 'Post speichern';
          }
          postModal?.classList.remove('show');
          postModal?.setAttribute('aria-hidden', 'true');
          openPostId = null;
          await loadPosts();
          setMsg('Post geloescht.', true);
        } catch {
          setMsg('Netzwerkfehler.', false);
        } finally {
          postModalDelete.disabled = false;
        }
      });

      if (activation && editorWrap && editor) {
        activation.addEventListener('click', () => {
          editorWrap.classList.add('active');
          editor.focus();
          resizeCanvasToBox();
        });
      }

      let authHintTimer = null;
      function showAuthHint(text) {
        if (!editorTile) return;
        if (authHintTimer) {
          clearTimeout(authHintTimer);
          authHintTimer = null;
          editorTile.removeAttribute('data-hint');
          editorTile.classList.remove('shake');
          // force reflow damit Animation neu startet
          void editorTile.offsetWidth;
        }
        editorTile.dataset.hint = text || '';
        editorTile.classList.add('shake');
        authHintTimer = setTimeout(() => {
          editorTile.removeAttribute('data-hint');
          editorTile.classList.remove('shake');
          authHintTimer = null;
        }, 2400);
      }

      function enterEditorMode() {
        if (!blogpostPage) return;
        blogpostPage.setAttribute('data-mode', 'editor');
        // Editor-Aktivierung nach der Fade-Animation (CSS-Delay ~240ms +
        // Transition-Dauer). Wir warten genug, damit das Editor-Shell sichtbar
        // ist, bevor wir den Focus setzen und das Canvas messen.
        setTimeout(() => {
          editorWrap?.classList.add('active');
          editor?.focus();
          resizeCanvasToBox();
        }, 720);
      }

      if (editorTile && blogpostPage) {
        editorTile.addEventListener('click', () => {
          const loggedIn = blogpostPage.dataset.loggedIn === 'true';
          const canPost = blogpostPage.dataset.canPost === 'true';
          if (!loggedIn) {
            showAuthHint('Bitte einloggen, um zu posten');
            return;
          }
          if (!canPost) {
            showAuthHint('Kein Recht für Blogposts');
            return;
          }
          enterEditorMode();
        });
      }

      toolButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          if (!editor) return;
          const key = btn.getAttribute('data-tool');
          editor.focus();
          if (key === 'bold') document.execCommand('bold');
          if (key === 'italic') document.execCommand('italic');
          if (key === 'list') document.execCommand('insertUnorderedList');
          if (key === 'font') {
            fontMode = (fontMode + 1) % fonts.length;
            const nextFont = fonts[fontMode];
            if (nextFont === 'inherit') {
              document.execCommand('removeFormat');
            } else {
              document.execCommand('fontName', false, nextFont);
            }
          }
          if (key === 'color') {
            colorIndex = (colorIndex + 1) % palette.length;
            currentColor = palette[colorIndex];
            if (!doodleMode) document.execCommand('foreColor', false, currentColor);
            applyColor();
          }
          if (key === 'doodle') {
            doodleMode = !doodleMode;
            btn.classList.toggle('active', doodleMode);
            doodleCanvas?.classList.toggle('active', doodleMode);
            if (!doodleMode) {
              eraserMode = false;
              const eraserBtn = document.querySelector('[data-tool="eraser"]');
              eraserBtn?.classList.remove('active');
            }
            if (doodleMode) resizeCanvasToBox();
          }
          if (key === 'eraser') {
            eraserMode = !eraserMode;
            btn.classList.toggle('active', eraserMode);
            const doodleBtn = document.querySelector('[data-tool="doodle"]');
            if (!doodleMode) {
              doodleMode = true;
              doodleCanvas?.classList.add('active');
              doodleBtn?.classList.add('active');
              resizeCanvasToBox();
            }
            applyColor();
          }
        });
      });

      if (doodleCanvas) {
        const getPoint = (ev) => {
          const rect = doodleCanvas.getBoundingClientRect();
          const source = ev.touches ? ev.touches[0] : ev;
          return {
            x: source.clientX - rect.left,
            y: source.clientY - rect.top,
          };
        };
        const start = (ev) => {
          if (!doodleMode) return;
          drawing = true;
          const p = getPoint(ev);
          lastX = p.x;
          lastY = p.y;
        };
        const move = (ev) => {
          if (!drawing || !doodleMode) return;
          ev.preventDefault();
          const p = getPoint(ev);
          const ctx = doodleCanvas.getContext('2d');
          if (!ctx) return;
          ctx.globalCompositeOperation = eraserMode ? 'destination-out' : 'source-over';
          ctx.strokeStyle = currentColor;
          ctx.lineWidth = eraserMode ? 16 : 3;
          ctx.lineCap = 'round';
          ctx.beginPath();
          ctx.moveTo(lastX, lastY);
          ctx.lineTo(p.x, p.y);
          ctx.stroke();
          lastX = p.x;
          lastY = p.y;
        };
        const stop = () => {
          drawing = false;
        };
        doodleCanvas.addEventListener('mousedown', start);
        doodleCanvas.addEventListener('mousemove', move, { passive: false });
        window.addEventListener('mouseup', stop);
        doodleCanvas.addEventListener('touchstart', start, { passive: true });
        doodleCanvas.addEventListener('touchmove', move, { passive: false });
        window.addEventListener('touchend', stop, { passive: true });
        window.addEventListener('resize', resizeCanvasToBox);
      }

      if (savePostBtn && editor) {
        savePostBtn.addEventListener('click', async () => {
          const contentHtml = editor.innerHTML.trim();
          const contentText = editor.innerText.trim();
          if (!contentText) {
            setMsg('Der Post ist leer.', false);
            return;
          }
          savePostBtn.disabled = true;
          setMsg('', true);
          try {
            const isEditing = Number.isInteger(currentEditingPostId) && currentEditingPostId > 0;
            const endpoint = isEditing ? `/api/posts/${currentEditingPostId}` : '/api/posts/add';
            const res = await fetch(endpoint, {
              method: isEditing ? 'PATCH' : 'POST',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'same-origin',
              body: JSON.stringify({
                contentHtml,
                contentText,
                accentColor: currentColor,
                doodleDataUrl: doodleCanvas ? doodleCanvas.toDataURL('image/png') : '',
              }),
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok || !data.success) {
              setMsg((data.error || 'Speichern fehlgeschlagen').toUpperCase(), false);
              return;
            }
            if (isEditing) {
              setMsg('Post aktualisiert.', true);
              currentEditingPostId = null;
              if (savePostBtn) savePostBtn.textContent = 'Post speichern';
            } else {
              setMsg('Post gespeichert.', true);
            }
            await loadPosts();
          } catch {
            setMsg('Netzwerkfehler.', false);
          } finally {
            savePostBtn.disabled = false;
          }
        });
      }

      applyColor();
      decorateHubTiles();
      void loadPosts();

      // Beim Resize Layout neu rechnen — Spaltenanzahl passt sich an,
      // damit auch nach Browser-Resize keine schmale Mittel-Spur entsteht.
      let hubResizeTimer = null;
      window.addEventListener('resize', () => {
        if (hubResizeTimer) clearTimeout(hubResizeTimer);
        hubResizeTimer = setTimeout(() => {
          decorateHubTiles();
        }, 180);
      });
    </script>
    <ThemeClient />
    <BewareOfBugsBanner permission="blogpost_poster" />
  </body>
</html>
