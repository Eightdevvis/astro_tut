---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SuperSettings from '../../components/SuperSettings.jsx';
import { getUsernameFromCookies } from '../../lib/session.js';
import { hasPermission } from '../../lib/permissions.js';

const username = await getUsernameFromCookies(Astro.cookies);
if (!username || !(await hasPermission(username, 'super_access'))) {
  return Astro.redirect('/');
}
---

<BaseLayout pageTitle="Super-Einstellungen">
  <style>
    /* Specificity um eine Stufe hoeher als die Default-Regel in global.css,
       damit der Override unabhaengig von der CSS-Bundle-Reihenfolge greift
       (Astro packt globale Imports im Production-Build hinter Page-Styles). */
    :global(html.site-subpage main.subpage-main) {
      max-width: none;
      margin: 0;
      width: 100%;
    }
  </style>
  <SuperSettings client:load />
</BaseLayout>
