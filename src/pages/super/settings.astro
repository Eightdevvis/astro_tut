---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SuperSettings from '../../components/SuperSettings.jsx';
import { getUsernameFromCookies } from '../../lib/session.js';
import { hasPermission } from '../../lib/permissions.js';

const username = await getUsernameFromCookies(Astro.cookies);
if (!username || !(await hasPermission(username, 'super_access'))) {
  return Astro.redirect('/');
}
---

<BaseLayout pageTitle="Super-Einstellungen">
  <SuperSettings client:load />
</BaseLayout>
