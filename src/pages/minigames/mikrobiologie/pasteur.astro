---
import Nav2 from '../../../components/Nav2.astro';
import SiteFontOverrides from '../../../components/SiteFontOverrides.astro';
import ThemeInit from '../../../components/ThemeInit.astro';
import ThemeClient from '../../../components/ThemeClient.astro';
import BewareOfBugsBanner from '../../../components/BewareOfBugsBanner.astro';
import PageFavicon from '../../../components/PageFavicon.astro';
import LabBench from '../../../components/lab-bench/LabBench.jsx';
import { getUsernameFromCookies } from '../../../lib/session.js';
import { hasPermission } from '../../../lib/permissions.js';
import '../../../styles/global.css';

const username = await getUsernameFromCookies(Astro.cookies);
const canUseMinigames = Boolean(username) && (await hasPermission(username, 'super_access'));
if (!canUseMinigames) {
  return Astro.redirect('/');
}
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <ThemeInit />
    <PageFavicon icon="minigames" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f4f1ea" />
    <title>Pasteurs Experiment · Mikrobiologie · Minigames</title>
    <SiteFontOverrides />
  </head>
  <body>
    <Nav2 variant="subpage" />
    <header class="pst-head">
      <p class="pst-kicker"><a href="/minigames/mikrobiologie">&larr; Mikrobiologie</a></p>
      <h1 class="pst-title">Pasteurs Experiment</h1>
      <p class="pst-lead">
        Bau das Schwanenhals-Experiment auf. Items aus der Schublade, dem Regal oder der
        Versorgungs-Schiene auf den Tisch ziehen; Bunsenbrenner anklicken zum Anzuenden,
        Kolben anklicken zum Kippen. Mit dem Muelleimer wieder loeswerden.
        <em>(WIP — Game-Mechanik kommt im naechsten Schritt; das hier ist nur die Buehne.)</em>
      </p>
    </header>
    <main class="pst-main">
      <LabBench client:load />
    </main>
    <ThemeClient />
    <BewareOfBugsBanner permission="minigames_access" />
  </body>
</html>

<style>
  body {
    background-color: var(--mg-page-bg);
    margin: 0;
    padding: 0;
    padding-top: calc(var(--nav-strip-h) + env(safe-area-inset-top, 0px));
    color: var(--site-body-text);
  }
  .pst-head {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.4rem 1rem 0.6rem;
    box-sizing: border-box;
  }
  .pst-kicker {
    margin: 0 0 0.4rem;
    font-size: 0.9rem;
    color: var(--site-soft-muted);
  }
  .pst-kicker a { color: inherit; text-decoration: none; }
  .pst-kicker a:hover { text-decoration: underline; }
  .pst-title {
    margin: 0 0 0.4rem;
    font-size: 1.85rem;
    font-weight: 700;
  }
  .pst-lead {
    margin: 0;
    line-height: 1.55;
    color: var(--site-muted);
  }
  .pst-main {
    width: 100%;
    max-width: 1200px;
    margin: 1rem auto 4rem;
    padding: 0 1rem;
    box-sizing: border-box;
  }
</style>
