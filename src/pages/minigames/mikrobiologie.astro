---
import Nav2 from '../../components/Nav2.astro';
import SiteFontOverrides from '../../components/SiteFontOverrides.astro';
import ThemeInit from '../../components/ThemeInit.astro';
import ThemeClient from '../../components/ThemeClient.astro';
import BewareOfBugsBanner from '../../components/BewareOfBugsBanner.astro';
import PageFavicon from '../../components/PageFavicon.astro';
import MoleculeBuilder from '../../components/MoleculeBuilder.jsx';
import ArchaeaLipidsMikrobioCard from '../../components/ArchaeaLipidsMikrobioCard.jsx';
import ExtremophileMikrobioCard from '../../components/ExtremophileMikrobioCard.jsx';
import KetcherRequireShim from '../../components/KetcherRequireShim.astro';
import { getUsernameFromCookies } from '../../lib/session.js';
import { hasPermission } from '../../lib/permissions.js';
import '../../styles/global.css';

const username = await getUsernameFromCookies(Astro.cookies);
// Vorerst nur Superuser (siehe minigames/index.astro fuer Begruendung).
const canUseMinigames = Boolean(username) && (await hasPermission(username, 'super_access'));
if (!canUseMinigames) {
  return Astro.redirect('/');
}
---

<html lang="de">
  <head>
    <KetcherRequireShim />
    <meta charset="utf-8" />
    <ThemeInit />
    <PageFavicon icon="minigames" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f4f1ea" />
    <title>Mikrobiologie · Minigames</title>
    <SiteFontOverrides />
  </head>
  <body>
    <Nav2 variant="subpage" />
    <header class="mb-page-head">
      <p class="mb-page-kicker"><a href="/minigames">← Spielwiese</a></p>
      <h1 class="mb-page-title">Mikrobiologie</h1>
      <p class="mb-page-lead">
        Hier kommen die kleinen Mikrobio-Minigames hin. Werkzeuge und Vorlagen, die ueber mehrere Spiele hinweg nuetzlich sind,
        liegen unten im aufklappbaren Werkzeug-Drawer.
      </p>
    </header>

    <section class="mb-games" aria-label="Minigames">
      <ArchaeaLipidsMikrobioCard client:idle />
      <ExtremophileMikrobioCard client:idle />
    </section>

    <details class="mb-tools">
      <summary class="mb-tools-summary">
        <span class="mb-tools-title">Werkzeuge &amp; Vorlagen</span>
        <span class="mb-tools-hint">aufklappen</span>
      </summary>
      <div class="mb-tools-body">
        <p class="mb-tools-lead">
          Gemeinsame Werkzeuge fuer die Minigames oben. Aktuell: der Molecule Builder fuer Strukturformeln.
        </p>
        <MoleculeBuilder client:only="preact" />
      </div>
    </details>

    <p class="mb-page-back">
      <a href="/minigames">← Alle Minigames</a>
    </p>
    <ThemeClient />
    <BewareOfBugsBanner permission="minigames_access" />
  </body>
</html>

<style>
  body {
    background-color: var(--mg-page-bg);
    margin: 0;
    padding: 0;
    padding-top: calc(var(--nav-strip-h) + env(safe-area-inset-top, 0px));
    color: var(--site-body-text);
  }

  header.mb-page-head,
  .mb-games,
  .mb-tools,
  .mb-page-back {
    width: 100%;
    max-width: 56rem;
    min-width: 0;
    margin: 0 auto;
    padding: 0 1rem;
    box-sizing: border-box;
  }

  header.mb-page-head {
    padding-top: 1.6rem;
    padding-bottom: 0.6rem;
  }

  .mb-page-kicker {
    margin: 0 0 0.4rem;
    font-size: 0.9rem;
    color: var(--site-soft-muted);
  }

  .mb-page-kicker a {
    color: inherit;
    text-decoration: none;
  }

  .mb-page-kicker a:hover {
    text-decoration: underline;
  }

  .mb-page-title {
    margin: 0 0 0.4rem;
    font-size: 1.85rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .mb-page-lead {
    margin: 0;
    line-height: 1.55;
    color: var(--site-muted);
    overflow-wrap: break-word;
  }

  .mb-games {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem;
  }

  @media (min-width: 40rem) {
    .mb-games {
      grid-template-columns: 1fr 1fr;
    }
  }

  .mb-tools {
    margin-top: 1.5rem;
    border: 1px solid var(--site-card-border);
    border-radius: 0.9rem;
    background: var(--site-card-bg);
    box-shadow: var(--site-card-inset-soft), var(--site-card-shadow);
    overflow: hidden;
  }

  .mb-tools-summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.8rem 1.1rem;
    font-weight: 600;
  }

  .mb-tools-summary::-webkit-details-marker {
    display: none;
  }

  .mb-tools-summary::before {
    content: '▸';
    margin-right: 0.45rem;
    color: var(--site-muted);
    transition: transform 0.15s ease;
    display: inline-block;
  }

  details[open] > .mb-tools-summary::before {
    transform: rotate(90deg);
  }

  .mb-tools-title {
    flex: 1;
  }

  .mb-tools-hint {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--site-soft-muted);
  }

  details[open] > .mb-tools-summary .mb-tools-hint {
    visibility: hidden;
  }

  .mb-tools-body {
    padding: 0.4rem 1.1rem 1.2rem;
    border-top: 1px solid var(--site-card-border);
  }

  .mb-tools-lead {
    margin: 0.6rem 0 1rem;
    color: var(--site-muted);
    line-height: 1.5;
  }

  .mb-page-back {
    margin-top: 2.5rem;
    padding-bottom: 4rem;
    color: var(--site-soft-muted);
  }

  .mb-page-back a {
    color: inherit;
  }
</style>
