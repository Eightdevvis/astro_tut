---
import Nav2 from '../../components/Nav2.astro';
import SiteFontOverrides from '../../components/SiteFontOverrides.astro';
import ThemeInit from '../../components/ThemeInit.astro';
import ThemeClient from '../../components/ThemeClient.astro';
import BewareOfBugsBanner from '../../components/BewareOfBugsBanner.astro';
import PageFavicon from '../../components/PageFavicon.astro';
import MoleculeBuilder from '../../components/MoleculeBuilder.jsx';
import { getUsernameFromCookies } from '../../lib/session.js';
import { hasPermission } from '../../lib/permissions.js';
import '../../styles/global.css';

const username = await getUsernameFromCookies(Astro.cookies);
// Vorerst nur Superuser (siehe minigames/index.astro fuer Begruendung).
const canUseMinigames = Boolean(username) && (await hasPermission(username, 'super_access'));
if (!canUseMinigames) {
  return Astro.redirect('/');
}
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <ThemeInit />
    <PageFavicon icon="minigames" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f4f1ea" />
    <title>Mikrobiologie · Minigames</title>
    <SiteFontOverrides />
  </head>
  <body>
    <Nav2 variant="subpage" />
    <header class="mb-page-head">
      <p class="mb-page-kicker"><a href="/minigames">← Spielwiese</a></p>
      <h1 class="mb-page-title">Mikrobiologie</h1>
      <p class="mb-page-lead">
        Petrischale fuer Strukturformeln. Den Knopf druecken, Atome auf das Brett legen, Bindungen ziehen, Ringe einklicken.
      </p>
    </header>
    <MoleculeBuilder client:only="preact" />
    <p class="mb-page-back">
      <a href="/minigames">← Alle Minigames</a>
    </p>
    <ThemeClient />
    <BewareOfBugsBanner permission="minigames_access" />
  </body>
</html>

<style>
  body {
    background-color: var(--mg-page-bg);
    margin: 0;
    padding: 0;
    padding-top: calc(var(--nav-strip-h) + env(safe-area-inset-top, 0px));
    color: var(--site-body-text);
  }

  header.mb-page-head,
  .mb-page-back {
    width: 100%;
    max-width: 56rem;
    min-width: 0;
    margin: 0 auto;
    padding: 0 1rem;
    box-sizing: border-box;
  }

  header.mb-page-head {
    padding-top: 1.6rem;
    padding-bottom: 0.6rem;
  }

  .mb-page-kicker {
    margin: 0 0 0.4rem;
    font-size: 0.9rem;
    color: var(--site-soft-muted);
  }

  .mb-page-kicker a {
    color: inherit;
    text-decoration: none;
  }

  .mb-page-kicker a:hover {
    text-decoration: underline;
  }

  .mb-page-title {
    margin: 0 0 0.4rem;
    font-size: 1.85rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .mb-page-lead {
    margin: 0;
    line-height: 1.55;
    color: var(--site-muted);
    overflow-wrap: break-word;
  }

  .mb-page-back {
    margin-top: 2.5rem;
    padding-bottom: 4rem;
    color: var(--site-soft-muted);
  }

  .mb-page-back a {
    color: inherit;
  }
</style>
