---
import Nav2 from '../../components/Nav2.astro';
import SiteFontOverrides from '../../components/SiteFontOverrides.astro';
import ThemeInit from '../../components/ThemeInit.astro';
import ThemeClient from '../../components/ThemeClient.astro';
import BewareOfBugsBanner from '../../components/BewareOfBugsBanner.astro';
import PageFavicon from '../../components/PageFavicon.astro';
import FraktaleSandbox from '../../components/FraktaleSandbox.jsx';
import { getUsernameFromCookies } from '../../lib/session.js';
import { hasPermission } from '../../lib/permissions.js';
import '../../styles/global.css';

const username = await getUsernameFromCookies(Astro.cookies);
// Vorerst nur Superuser (siehe minigames/index.astro fuer Begruendung).
const canUseMinigames = Boolean(username) && (await hasPermission(username, 'super_access'));
if (!canUseMinigames) {
  return Astro.redirect('/');
}
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <ThemeInit />
    <PageFavicon icon="minigames" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f4f1ea" />
    <title>Fraktale Sandbox · Minigames</title>
    <SiteFontOverrides />
  </head>
  <body>
    <Nav2 variant="subpage" />
    <header class="fs-page-head">
      <p class="fs-page-kicker"><a href="/minigames">← Spielwiese</a></p>
      <p class="fs-page-lead">
        Iterationen z<sub>n+1</sub> = z<sub>n</sub>² + c — Mandelbrot (c aus der Ebene) und Julia (festes c). Ziehen zum Erkunden,
        Zoomen mit Mausrad oder zwei Fingern, Farben und c per Regler oder (Julia) „Ziehen bewegt c“.
      </p>
    </header>
    <FraktaleSandbox client:load />
    <p class="fs-page-back">
      <a href="/minigames">← Alle Minigames</a>
    </p>
    <BewareOfBugsBanner permission="minigames_access" />
  </body>
</html>

<style>
  body {
    background-color: var(--fs-page-bg);
    margin: 0;
    padding: 0;
    padding-top: calc(var(--nav-strip-h) + env(safe-area-inset-top, 0px));
    color: var(--site-body-text);
  }

  header.fs-page-head,
  :global(.fs-root),
  .fs-page-back {
    min-width: 0;
    max-width: 100%;
  }

  .fs-page-head {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem 1rem 0.5rem;
  }

  .fs-page-kicker {
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    opacity: 0.5;
    margin: 0 0 0.35rem;
  }

  .fs-page-kicker a {
    color: inherit;
    text-decoration: none;
  }

  .fs-page-kicker a:hover {
    text-decoration: underline;
  }

  .fs-page-lead {
    margin: 0;
    max-width: 52rem;
    line-height: 1.55;
    font-size: 0.95rem;
    opacity: 0.78;
    overflow-wrap: break-word;
  }

  .fs-page-back {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 1rem 2rem;
    opacity: 0.5;
  }

  .fs-page-back a {
    color: inherit;
    font-size: 0.9rem;
  }
</style>
