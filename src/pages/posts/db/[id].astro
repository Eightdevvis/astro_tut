---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ensureDbSchema, getDb } from '../../../lib/db.js';
import {
  computeEffectivePrivacy,
  isValidPublicSlug,
  normalizeVisibility,
  privacyHeaders,
  privacyMetaTags,
  rewriteOutboundLinks,
} from '../../../lib/blog-privacy.js';
import { classifyUserAgent } from '../../../lib/bot-fingerprints.js';
import { extractClientMeta, safeLogRequest } from '../../../lib/request-log.js';
import { getSessionUserFromCookies } from '../../../lib/session.js';

const rawId = String(Astro.params?.id ?? '').trim();
const asInteger = Number(rawId);
const isIntegerLookup = Number.isInteger(asInteger) && asInteger > 0;
const isSlugLookup = isValidPublicSlug(rawId);

type PostRow = {
  id: number;
  username: string;
  content_html: string;
  content_text: string;
  created_at: string;
  visibility: string;
  privacy_flags: string;
  public_slug: string | null;
};

let post: PostRow | null = null;

if (isIntegerLookup || isSlugLookup) {
  try {
    await ensureDbSchema();
    const result = await getDb().execute({
      sql: isSlugLookup
        ? `SELECT id, username, content_html, content_text, created_at,
                  visibility, privacy_flags, public_slug
             FROM blog_posts
            WHERE public_slug = ? AND deleted_at IS NULL
            LIMIT 1`
        : `SELECT id, username, content_html, content_text, created_at,
                  visibility, privacy_flags, public_slug
             FROM blog_posts
            WHERE id = ? AND deleted_at IS NULL
            LIMIT 1`,
      args: isSlugLookup ? [rawId] : [asInteger],
    });
    const row = result.rows?.[0];
    if (row) {
      post = {
        id: Number(row.id),
        username: String(row.username || ''),
        content_html: String(row.content_html || ''),
        content_text: String(row.content_text || ''),
        created_at: String(row.created_at || ''),
        visibility: normalizeVisibility(row.visibility),
        privacy_flags: String(row.privacy_flags || '{}'),
        public_slug: row.public_slug ? String(row.public_slug) : null,
      };
    }
  } catch (err) {
    console.error('posts/db/[id]', err);
  }
}

// B1 Visibility-Gate:
// - public / unlisted → fuer alle sichtbar (Unterschied liegt im Listing,
//   nicht in der Direkt-URL).
// - private → nur fuer den Autor; alle anderen sehen 404 (Existenz wird
//   bewusst nicht verraten).
// - password → wird in Phase 9 mit Token-Check ergaenzt; bis dahin
//   verhalten wir uns wie 404, um nicht versehentlich geheime Inhalte zu
//   leaken.
if (post) {
  if (post.visibility === 'private') {
    const sessionUser = await getSessionUserFromCookies(Astro.cookies);
    if (!sessionUser || sessionUser.username !== post.username) {
      post = null;
    }
  } else if (post.visibility === 'password') {
    post = null;
  }
}

const requestPath = `/posts/db/${rawId}`;
const client = extractClientMeta(Astro.request, Astro.clientAddress);

if (!post) {
  // Existenz wird bewusst nicht verraten — kein gesonderter Reason fuer
  // private/password vs. wirklich nicht-da, sonst kann man durch
  // Antwort-Vergleich die Existenz herausfinden.
  void safeLogRequest({
    path: requestPath,
    postId: null,
    username: null,
    ua: client.ua,
    ip: client.ip,
    country: client.country,
    referer: client.referer,
    status: 404,
    blockedReason: 'not_found_or_gated',
  });
  return new Response('Post nicht gefunden', { status: 404 });
}

// Integer→Slug-Redirect bei oeffentlichen Posts: konsolidiert die kanonische
// URL und macht die Hub-/Listings-Links konsistent. Unlisted/private bleiben
// auf der zuletzt benutzten URL stehen, sonst koennten Referer-Logs die
// Integer-ID verraten.
if (isIntegerLookup && post.public_slug && post.visibility === 'public') {
  void safeLogRequest({
    path: requestPath,
    postId: post.id,
    username: post.username,
    ua: client.ua,
    ip: client.ip,
    country: client.country,
    referer: client.referer,
    status: 301,
  });
  return Astro.redirect(`/posts/db/${post.public_slug}`, 301);
}

const firstLine = post.content_text
  .split('\n')
  .map((line) => line.trim())
  .find((line) => line.length > 0);

const title = firstLine?.slice(0, 90) || `Post #${post.id}`;
const pubDate = post.created_at.slice(0, 10);
const author = post.username || 'Unknown';

// B2/B3/B9/B10/B11 — wirksame Privacy-Direktiven berechnen und sowohl im
// HTML als Meta-Tag als auch ueber HTTP-Header ausspielen. Meta wirkt fuer
// kompliante Crawler, die das HTML parsen; der Header faengt zusaetzlich
// die ab, die nur Header schauen. B10 (no_referrer) ist Opt-in pro Post;
// B11 (no_embed) ebenfalls. noindex/noai werden bei nicht-public Posts
// automatisch erzwungen — siehe blog-privacy.js.
const effective = computeEffectivePrivacy({
  visibility: post.visibility,
  privacyFlags: post.privacy_flags,
});

// B4 UA-Gate: hartes Block auf Serverebene, bevor der Inhalt rendert.
// Greift fuer alle Bots, deren Kategorie in uaGateBlock steht (nicht-public
// erzwingt ai+archive; ein expliziter Toggle `noai_ua_gate` macht das
// gleiche auch fuer public Posts).
if (effective.uaGateBlock.size > 0) {
  const { category, botName } = classifyUserAgent(client.ua);
  if (effective.uaGateBlock.has(category)) {
    void safeLogRequest({
      path: requestPath,
      postId: post.id,
      username: post.username,
      ua: client.ua,
      ip: client.ip,
      country: client.country,
      referer: client.referer,
      status: 403,
      blockedReason: `ua_gate:${botName || category}`,
    });
    return new Response('Forbidden', { status: 403 });
  }
}

const metaTags = privacyMetaTags(effective);
const headers = privacyHeaders(effective);
for (const [name, value] of Object.entries(headers)) {
  Astro.response.headers.set(name, String(value));
}

void safeLogRequest({
  path: requestPath,
  postId: post.id,
  username: post.username,
  ua: client.ua,
  ip: client.ip,
  country: client.country,
  referer: client.referer,
  status: 200,
});

// B10 (Teil 2): wenn no_referrer aktiv ist, bekommen alle externen
// `<a href>` Links zusaetzlich rel="nofollow noreferrer noopener". Das
// schuetzt die User-Privatsphaere auch dann, wenn Browser den
// Referrer-Policy-Header ignorieren sollten.
let siteHost = '';
try {
  if (Astro.site) siteHost = new URL(Astro.site).host;
} catch {}
const renderedHtml = effective.noReferrer
  ? rewriteOutboundLinks(post.content_html, { siteHost })
  : post.content_html;
---

<BaseLayout pageTitle={title}>
  <Fragment slot="head">
    {metaTags.map((tag) => (
      <meta name={tag.name} content={tag.content} />
    ))}
  </Fragment>
  <p>{pubDate}</p>
  <p>Written by: {author}</p>
  <article class="db-post-content" set:html={renderedHtml}></article>
</BaseLayout>

<style>
  .db-post-content {
    white-space: normal;
    line-height: 1.6;
  }
  .db-post-content :global(*) {
    max-width: 100%;
  }
</style>
