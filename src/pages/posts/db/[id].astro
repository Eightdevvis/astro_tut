---
import bcrypt from 'bcryptjs';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ensureDbSchema, getDb } from '../../../lib/db.js';
import {
  computeEffectivePrivacy,
  isValidPublicSlug,
  normalizeVisibility,
  privacyHeaders,
  privacyMetaTags,
  rewriteOutboundLinks,
} from '../../../lib/blog-privacy.js';
import { classifyUserAgent } from '../../../lib/bot-fingerprints.js';
import {
  consumeTokenIfOnetime,
  findValidTokenForPost,
} from '../../../lib/blog-tokens.js';
import { extractClientMeta, safeLogRequest } from '../../../lib/request-log.js';
import { getSessionUserFromCookies } from '../../../lib/session.js';
import { isAuthorBlockAllAi } from '../../../lib/user-privacy-defaults.js';
import { checkPasswordAttemptLimit, checkRateLimit } from '../../../lib/rate-limit.js';
import { hashIp } from '../../../lib/request-log.js';
import { sanitizePostHtml } from '../../../lib/sanitize-html.js';

const rawId = String(Astro.params?.id ?? '').trim();
const asInteger = Number(rawId);
const isIntegerLookup = Number.isInteger(asInteger) && asInteger > 0;
const isSlugLookup = isValidPublicSlug(rawId);

type PostRow = {
  id: number;
  username: string;
  content_html: string;
  content_text: string;
  created_at: string;
  visibility: string;
  privacy_flags: string;
  public_slug: string | null;
  password_hash: string | null;
  expires_at: string | null;
};

let post: PostRow | null = null;

if (isIntegerLookup || isSlugLookup) {
  try {
    await ensureDbSchema();
    const result = await getDb().execute({
      sql: isSlugLookup
        ? `SELECT id, username, content_html, content_text, created_at,
                  visibility, privacy_flags, public_slug,
                  password_hash, expires_at
             FROM blog_posts
            WHERE public_slug = ? AND deleted_at IS NULL
            LIMIT 1`
        : `SELECT id, username, content_html, content_text, created_at,
                  visibility, privacy_flags, public_slug,
                  password_hash, expires_at
             FROM blog_posts
            WHERE id = ? AND deleted_at IS NULL
            LIMIT 1`,
      args: isSlugLookup ? [rawId] : [asInteger],
    });
    const row = result.rows?.[0];
    if (row) {
      post = {
        id: Number(row.id),
        username: String(row.username || ''),
        content_html: String(row.content_html || ''),
        content_text: String(row.content_text || ''),
        created_at: String(row.created_at || ''),
        visibility: normalizeVisibility(row.visibility),
        privacy_flags: String(row.privacy_flags || '{}'),
        public_slug: row.public_slug ? String(row.public_slug) : null,
        password_hash: row.password_hash ? String(row.password_hash) : null,
        expires_at: row.expires_at ? String(row.expires_at) : null,
      };
    }
  } catch (err) {
    console.error('posts/db/[id]', err);
  }
}

// requestPath + client meta frueh anlegen, damit Failed-Password-Logs
// (H2) den richtigen postId + Pfad haben — die laufen vor dem Block,
// in dem wir das spaeter sonst erst definieren wuerden.
const requestPath = `/posts/db/${rawId}`;
const client = extractClientMeta(Astro.request, Astro.clientAddress);

// B17 Expire: gueltigkeitsdatum gepruefen, bevor andere Gates greifen.
// Antwort 410 Gone, damit Clients (auch Bots) merken: das war's, nicht
// einfach 404 (das waere "nicht da"); UI-Hint kann auf 410 reagieren.
let expiredResponse: Response | null = null;
if (post && post.expires_at) {
  const now = new Date().toISOString();
  if (post.expires_at <= now) {
    expiredResponse = new Response('Post abgelaufen', { status: 410 });
  }
}

// Token-Check (B15/B16): Query-Param ?key=<token>. Wenn ein lebender
// Token zum Post passt, dann setzen wir tokenUnlocked = true und ueberspringen
// das Visibility-Gate. So oeffnet ein Token jeden seiner Posts unabhaengig
// von der visibility-Stufe (privat/password/unlisted).
let tokenUnlocked = false;
let tokenRowForConsume: any = null;
const tokenParam = Astro.url.searchParams.get('key') || '';
if (post && !expiredResponse && tokenParam) {
  try {
    tokenRowForConsume = await findValidTokenForPost(getDb(), {
      post: { id: post.id, username: post.username },
      providedToken: tokenParam,
    });
    if (tokenRowForConsume) tokenUnlocked = true;
  } catch (err) {
    console.error('posts/db/[id] token check', err);
  }
}

// B1 Visibility-Gate:
// - public / unlisted → fuer alle sichtbar (Unterschied liegt im Listing,
//   nicht in der Direkt-URL).
// - private → nur fuer den Autor; alle anderen sehen 404 (Existenz wird
//   bewusst nicht verraten).
// - password → braucht ?pw=<klartext> (bcrypt-Check) ODER ?key=<token>
//   ODER eingeloggter Autor. Sonst 404 (nicht 401 — wir verraten die
//   Existenz nicht, falls jemand einfach mal /posts/db/<slug> probiert).
let passwordUnlocked = false;
if (post && !expiredResponse && !tokenUnlocked) {
  if (post.visibility === 'private') {
    const sessionUser = await getSessionUserFromCookies(Astro.cookies);
    if (!sessionUser || sessionUser.username !== post.username) {
      post = null;
    }
  } else if (post.visibility === 'password') {
    const pwParam = Astro.url.searchParams.get('pw') || '';
    const sessionUser = await getSessionUserFromCookies(Astro.cookies);
    if (sessionUser && sessionUser.username === post.username) {
      passwordUnlocked = true;
    } else if (post.password_hash && pwParam) {
      // H2: per-(IP-Hash × Post)-Counter; nach 5 Fehlversuchen in 10 min
      // wird der Versuch ohne bcrypt-Compare verworfen — schliesst online-
      // Brute-Force gegen den Klartext.
      const pwLimit = await checkPasswordAttemptLimit({
        ipHash: hashIp(client.ip),
        postId: post.id,
      });
      if (pwLimit.allowed) {
        let bcryptOk = false;
        try { bcryptOk = await bcrypt.compare(pwParam, post.password_hash); } catch {}
        if (bcryptOk) {
          passwordUnlocked = true;
        } else {
          // Fehl-Versuch loggen, damit der Counter steigt.
          void safeLogRequest({
            path: requestPath,
            postId: post.id,
            username: post.username,
            ua: client.ua,
            ip: client.ip,
            country: client.country,
            referer: client.referer,
            status: 404,
            blockedReason: 'password_required',
          });
        }
      }
    }
    if (!passwordUnlocked) post = null;
  }
}

// (requestPath + client wurden bereits oben angelegt, damit der
// H2-Failed-Password-Log frueh genug feuern kann.)

// B20 Rate-Limit ganz vorne — bevor wir teure Operationen (UA-Gate-Lookup,
// Token-Check) machen. Verbraucht eine DB-COUNT-Query gegen request_log,
// daher kommt sie NACH dem cheap-Vorab-Check, ob ueberhaupt eine ID/Slug
// passt.
if (isIntegerLookup || isSlugLookup) {
  const rl = await checkRateLimit({ ipHash: hashIp(client.ip) });
  if (!rl.allowed) {
    void safeLogRequest({
      path: requestPath,
      postId: null,
      username: null,
      ua: client.ua,
      ip: client.ip,
      country: client.country,
      referer: client.referer,
      status: 429,
      blockedReason: 'rate_limit',
    });
    return new Response('Zu viele Anfragen', {
      status: 429,
      headers: { 'Retry-After': '60' },
    });
  }
}

if (expiredResponse) {
  void safeLogRequest({
    path: requestPath,
    postId: null,
    username: null,
    ua: client.ua,
    ip: client.ip,
    country: client.country,
    referer: client.referer,
    status: 410,
    blockedReason: 'expired',
  });
  return expiredResponse;
}

if (!post) {
  // Existenz wird bewusst nicht verraten — kein gesonderter Reason fuer
  // private/password vs. wirklich nicht-da, sonst kann man durch
  // Antwort-Vergleich die Existenz herausfinden.
  void safeLogRequest({
    path: requestPath,
    postId: null,
    username: null,
    ua: client.ua,
    ip: client.ip,
    country: client.country,
    referer: client.referer,
    status: 404,
    blockedReason: 'not_found_or_gated',
  });
  return new Response('Post nicht gefunden', { status: 404 });
}

// Integer→Slug-Redirect bei oeffentlichen Posts: konsolidiert die kanonische
// URL und macht die Hub-/Listings-Links konsistent. Unlisted/private bleiben
// auf der zuletzt benutzten URL stehen, sonst koennten Referer-Logs die
// Integer-ID verraten.
if (isIntegerLookup && post.public_slug && post.visibility === 'public') {
  void safeLogRequest({
    path: requestPath,
    postId: post.id,
    username: post.username,
    ua: client.ua,
    ip: client.ip,
    country: client.country,
    referer: client.referer,
    status: 301,
  });
  return Astro.redirect(`/posts/db/${post.public_slug}`, 301);
}

const firstLine = post.content_text
  .split('\n')
  .map((line) => line.trim())
  .find((line) => line.length > 0);

const title = firstLine?.slice(0, 90) || `Post #${post.id}`;
const pubDate = post.created_at.slice(0, 10);
const author = post.username || 'Unknown';

// B2/B3/B9/B10/B11 — wirksame Privacy-Direktiven berechnen und sowohl im
// HTML als Meta-Tag als auch ueber HTTP-Header ausspielen. Meta wirkt fuer
// kompliante Crawler, die das HTML parsen; der Header faengt zusaetzlich
// die ab, die nur Header schauen. B10 (no_referrer) ist Opt-in pro Post;
// B11 (no_embed) ebenfalls. noindex/noai werden bei nicht-public Posts
// automatisch erzwungen — siehe blog-privacy.js.
const effective = computeEffectivePrivacy({
  visibility: post.visibility,
  privacyFlags: post.privacy_flags,
});

// C7: wenn der Autor `block_all_ai=1` gesetzt hat, wird der UA-Gate fuer
// AI+archive auch fuer public Posts zwangsaktiviert. Wir erweitern das
// bestehende Set in-place.
if (await isAuthorBlockAllAi(post.username)) {
  effective.uaGateBlock.add('ai');
  effective.uaGateBlock.add('archive');
}

// B4 UA-Gate: hartes Block auf Serverebene, bevor der Inhalt rendert.
// Greift fuer alle Bots, deren Kategorie in uaGateBlock steht (nicht-public
// erzwingt ai+archive; ein expliziter Toggle `noai_ua_gate` macht das
// gleiche auch fuer public Posts).
if (effective.uaGateBlock.size > 0) {
  const { category, botName } = classifyUserAgent(client.ua);
  if (effective.uaGateBlock.has(category)) {
    void safeLogRequest({
      path: requestPath,
      postId: post.id,
      username: post.username,
      ua: client.ua,
      ip: client.ip,
      country: client.country,
      referer: client.referer,
      status: 403,
      blockedReason: `ua_gate:${botName || category}`,
    });
    return new Response('Forbidden', { status: 403 });
  }
}

const metaTags = privacyMetaTags(effective);
const headers = privacyHeaders(effective);
for (const [name, value] of Object.entries(headers)) {
  Astro.response.headers.set(name, String(value));
}

void safeLogRequest({
  path: requestPath,
  postId: post.id,
  username: post.username,
  ua: client.ua,
  ip: client.ip,
  country: client.country,
  referer: client.referer,
  status: 200,
});

// B16: erst NACH erfolgreichem Render zaehlen wir den One-Time-Token als
// verbraucht — sonst wuerden fehlgeschlagene Renders Tokens "verbrennen".
if (tokenRowForConsume && tokenRowForConsume.kind === 'onetime') {
  try {
    await consumeTokenIfOnetime(getDb(), tokenRowForConsume);
  } catch (err) {
    console.error('posts/db/[id] consume token', err);
  }
}

// B10 (Teil 2): wenn no_referrer aktiv ist, bekommen alle externen
// `<a href>` Links zusaetzlich rel="nofollow noreferrer noopener". Das
// schuetzt die User-Privatsphaere auch dann, wenn Browser den
// Referrer-Policy-Header ignorieren sollten.
let siteHost = '';
try {
  if (Astro.site) siteHost = new URL(Astro.site).host;
} catch {}
// K1 Defense-in-depth: auch beim Rendern nochmal sanitisieren, fuer den
// Fall, dass alte (vor-Sanitizer) Posts in der DB liegen oder direkte
// DB-Manipulation passiert ist.
const cleanHtml = sanitizePostHtml(post.content_html);
const renderedHtml = effective.noReferrer
  ? rewriteOutboundLinks(cleanHtml, { siteHost })
  : cleanHtml;

// B19/B18/B21 — fuer den Render brauchen wir drei Klassen + ggf. den
// JS-only-Pfad. Watermark-Text wird einmal serverseitig vorbereitet,
// damit das CSS::before-Pseudo den Username + Datum zeigen kann.
const articleClass = [
  'db-post-content',
  effective.watermark ? 'is-watermarked' : '',
  effective.softSelect ? 'is-soft-select' : '',
].filter(Boolean).join(' ');
const watermarkText = `${post.username} · ${pubDate}`;
const slugForApi = post.public_slug || String(post.id);
const tokenQs = tokenParam ? `?key=${encodeURIComponent(tokenParam)}` : '';
---

<BaseLayout pageTitle={title}>
  <Fragment slot="head">
    {metaTags.map((tag) => (
      <meta name={tag.name} content={tag.content} />
    ))}
  </Fragment>
  <p>{pubDate}</p>
  <p>Written by: {author}</p>
  {effective.jsOnly ? (
    <article class={articleClass} data-watermark={watermarkText}>
      <div
        id="post-js-only-host"
        data-slug={slugForApi}
        data-token-qs={tokenQs}
      >
        <p class="db-loading">Inhalt wird geladen …</p>
      </div>
    </article>
  ) : (
    <article class={articleClass} data-watermark={watermarkText} set:html={renderedHtml}></article>
  )}
</BaseLayout>

{effective.jsOnly && (
  <script type="module" is:inline>
    const host = document.getElementById('post-js-only-host');
    if (host) {
      const slug = host.getAttribute('data-slug');
      const tokenQs = host.getAttribute('data-token-qs') || '';
      fetch(`/api/posts/${slug}/content${tokenQs}`, { credentials: 'same-origin' })
        .then((r) => r.ok ? r.json() : Promise.reject(r.status))
        .then((d) => { host.innerHTML = d.contentHtml || '<p>Inhalt nicht verfuegbar.</p>'; })
        .catch(() => { host.innerHTML = '<p>Inhalt nicht verfuegbar.</p>'; });
    }
  </script>
)}

{effective.softSelect && (
  <script is:inline>
    document.addEventListener('contextmenu', (e) => {
      if (e.target.closest('.db-post-content.is-soft-select')) e.preventDefault();
    });
    document.addEventListener('copy', (e) => {
      const sel = document.getSelection();
      if (sel && sel.anchorNode && sel.anchorNode.parentElement &&
          sel.anchorNode.parentElement.closest('.db-post-content.is-soft-select')) {
        e.preventDefault();
      }
    });
  </script>
)}

<style>
  .db-post-content {
    /* Editor speichert Zeilenumbrueche als literale \n (er nutzt selbst
       white-space: pre-wrap). Die Anzeige muss das spiegeln, sonst kollabieren
       Umbrueche/Spacing zu einem Block. Alte <div>/<br>-Posts bleiben korrekt,
       da sie keine stray \n enthalten. */
    white-space: pre-wrap;
    line-height: 1.6;
    position: relative;
  }
  .db-post-content :global(*) {
    max-width: 100%;
  }
  .db-loading {
    opacity: 0.6;
    font-style: italic;
  }

  /* B19 Watermark — sich wiederholendes Pseudo-Element ueber dem Inhalt. */
  .db-post-content.is-watermarked::after {
    content: attr(data-watermark) " · " attr(data-watermark) " · " attr(data-watermark);
    position: absolute;
    inset: 0;
    pointer-events: none;
    display: flex;
    flex-wrap: wrap;
    align-content: space-around;
    justify-content: space-around;
    color: currentColor;
    opacity: 0.07;
    font-size: 1.4rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    transform: rotate(-22deg);
    transform-origin: center;
    overflow: hidden;
    user-select: none;
  }

  /* B18 Soft-Select — bremst Text-Auswahl + Copy. Erklart sich nicht als
     echter Schutz; Tooltip sagt das auch. */
  .db-post-content.is-soft-select {
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }
</style>
