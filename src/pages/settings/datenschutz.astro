---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSessionUserFromCookies } from '../../lib/session.js';
import {
  DATA_INVENTORY,
  CATEGORY_LABELS,
  EXTERNAL_SERVICES,
  BROWSER_STORAGE,
  filterInventoryForUser,
} from '../../lib/data-inventory.js';
import { BOT_FINGERPRINTS, LAST_REVIEWED } from '../../lib/bot-fingerprints.js';
import { TOGGLES, VISIBILITIES } from '../../lib/privacy-toggles.js';
import { LAYERS } from '../../lib/backup-layers.js';
import { hasPermission, KNOWN_PERMISSIONS, SUPER_PERMISSION } from '../../lib/permissions.js';

const sessionUser = await getSessionUserFromCookies(Astro.cookies);
if (!sessionUser) return Astro.redirect('/');

const username = sessionUser.username;

// Effektive Permissions des Users serverseitig auflisten — `hasPermission`
// macht parallel zwei DB-Queries und liefert das echte Effective-Set
// inkl. Bootstrap-Super + Global-Grants.
const activePermissions = [];
for (const perm of KNOWN_PERMISSIONS) {
  // hasPermission liefert true auch fuer super_access, deshalb extra-Pruefen
  // ob `super_access` direkt vergeben ist, damit wir den User korrekt
  // markieren koennen.
  if (await hasPermission(username, perm)) {
    activePermissions.push(perm);
  }
}
const isSuper = activePermissions.includes(SUPER_PERMISSION);

// Inventar gegen die Permissions des Users filtern. Superuser sieht alles.
const visibleEntries = filterInventoryForUser(activePermissions);

const grouped = Object.create(null);
for (const entry of visibleEntries) {
  const cat = entry.category;
  if (!grouped[cat]) grouped[cat] = [];
  grouped[cat].push(entry);
}
const categoryOrder = ['content', 'auth', 'behavior', 'tester', 'network', 'global'];

const totalCount = DATA_INVENTORY.length;
const visibleCount = visibleEntries.length;
const hiddenCount = totalCount - visibleCount;

// Permission-Anzeige-Labels (kuerzer / freundlicher als die DB-Konstanten).
const PERM_LABEL = {
  super_access:     'Superuser',
  blogpost_poster:  'Blog-Posts',
  quote_poster:     'Zitate',
  rpg_access:       'RPG / Quests',
  minigames_access: 'Minigames',
  tester_access:    'Tester',
  feed_access:      'Topic-Feeds',
};
---

<BaseLayout pageTitle={`Datenschutz — ${username}`}>
  <Fragment slot="head">
    <meta name="robots" content="noindex,nofollow" />
  </Fragment>

  <article class="dp-page">
    <header class="dp-head">
      <h1>Datenschutz</h1>
      <p class="dp-sub">Eingeloggt als <strong>{username}</strong></p>
      <p class="dp-sub">
        Diese Seite zeigt vollstaendig technisch, was wir speichern und wer Zugriff hat.
        Drei-Bucket-Prinzip: <em>oeffentlich offengelegt</em> &nbsp;·&nbsp;
        <em>mit Bedacht oeffentlich</em> &nbsp;·&nbsp; <em>nicht oeffentlich</em>
        (Schwellenwerte/Cron-Geheimnisse stehen in <code>memory/security-sensitive.md</code>).
      </p>
      <p class="dp-sub dp-perms">
        Deine aktiven Bereiche:
        {activePermissions.length === 0 ? (
          <em>—</em>
        ) : (
          activePermissions.map((p, i) => (
            <span class="dp-perm-chip">{PERM_LABEL[p] || p}</span>
          ))
        )}
      </p>
      <p class="dp-sub">
        Diese Datenschutz-Seite zeigt dir <strong>{visibleCount} von {totalCount}</strong> Tabellen — Eintraege fuer Bereiche, auf die du keinen Zugriff hast, werden nicht angezeigt.
        {hiddenCount > 0 && !isSuper && (
          <span> <a href="#" id="dpShowAllToggle">Alle anzeigen</a></span>
        )}
      </p>
    </header>

    <nav class="dp-tabs" role="tablist">
      <button type="button" class="dp-tab is-active" data-tab="overview" role="tab">Uebersicht</button>
      <button type="button" class="dp-tab"           data-tab="details"  role="tab">Details</button>
      <button type="button" class="dp-tab"           data-tab="actions"  role="tab">Rechte</button>
    </nav>

    <!-- Tab: Uebersicht -->
    <section class="dp-panel is-active" data-panel="overview">
      <p>
        Diese Seite ist deine zentrale Stelle, um zu sehen, was ueber dich
        gespeichert wird und um deine Rechte auszuueben.
      </p>
      <ul class="dp-summary">
        <li><strong>Eigene Inhalte</strong> — Posts, Quotes, RPG-Stand, Fonts, Graffiti, Inventar. Du kannst sie jederzeit exportieren oder loeschen.</li>
        <li><strong>Anmeldung & Rechte</strong> — Username (Klartext), Passwort (bcrypt-Hash, nicht reversibel), aktive Berechtigungen.</li>
        <li><strong>Verhalten & Fortschritt</strong> — Minigame-Fortschritt, KI-Verwendung, Topic-Feeds.</li>
        <li><strong>Server-Logs</strong> — Crawler-/Traffic-Erkennung mit gehashter IP. Roh-Log nach 30 Tagen weg, Aggregat bleibt ohne Personenbezug.</li>
        <li><strong>Externe Dienste</strong> — Vercel (Hosting), Turso (DB), optional KI-Anbieter fuer einzelne Features.</li>
      </ul>
      <p class="dp-mini">
        Volle technische Details im Tab <strong>Details</strong>, Export/Loeschung im Tab <strong>Rechte</strong>.
      </p>
    </section>

    <!-- Tab: Details -->
    <section class="dp-panel" data-panel="details">
      <h2>Datenbank-Tabellen</h2>
      {categoryOrder.map((cat) => grouped[cat] && (
        <details open class="dp-cat">
          <summary>{CATEGORY_LABELS[cat] || cat} ({grouped[cat].length})</summary>
          <ul class="dp-table-list">
            {grouped[cat].map((entry) => (
              <li class="dp-table-entry">
                <h3>{entry.table}</h3>
                <p class="dp-purpose">{entry.purpose}</p>
                <dl>
                  <dt>Aufbewahrung</dt><dd>{entry.retention}</dd>
                  <dt>Zugriff</dt><dd>{(entry.accessRoles || []).join(', ')}</dd>
                  <dt>Felder</dt><dd><code>{(entry.fields || []).join(', ')}</code></dd>
                  {entry.permissionsAnyOf && entry.permissionsAnyOf.length > 0 && (
                    <Fragment>
                      <dt>Voraussetzung</dt>
                      <dd>{entry.permissionsAnyOf.map((p) => PERM_LABEL[p] || p).join(' oder ')}</dd>
                    </Fragment>
                  )}
                </dl>
              </li>
            ))}
          </ul>
        </details>
      ))}

      {hiddenCount > 0 && !isSuper && (
        <details class="dp-cat dp-hidden-cat" id="dpHiddenSection">
          <summary>Weitere {hiddenCount} Tabellen, die fuer dich nicht aktiv sind</summary>
          <p class="dp-mini">
            Diese Tabellen existieren in der DB, aber dein Account hat aktuell keinen Zugriff auf die zugehoerigen Bereiche — wir speichern fuer dich also nichts in ihnen.
          </p>
          <ul class="dp-table-list">
            {DATA_INVENTORY.filter((e) => !visibleEntries.includes(e)).map((entry) => (
              <li class="dp-table-entry dp-table-entry--inactive">
                <h3>{entry.table}</h3>
                <p class="dp-purpose">{entry.purpose}</p>
                <dl>
                  <dt>Voraussetzung</dt>
                  <dd>{(entry.permissionsAnyOf || []).map((p) => PERM_LABEL[p] || p).join(' oder ')}</dd>
                </dl>
              </li>
            ))}
          </ul>
        </details>
      )}

      <h2>Externe Dienste</h2>
      <table class="dp-services">
        <thead><tr><th>Anbieter</th><th>Funktion</th><th>Datenkategorie</th><th>Region</th><th>AVV</th></tr></thead>
        <tbody>
          {EXTERNAL_SERVICES.map((s) => (
            <tr>
              <td><strong>{s.name}</strong></td>
              <td>{s.function}</td>
              <td>{s.dataCategory}</td>
              <td>{s.region}</td>
              <td>{s.avv}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <h2>Browser-Storage</h2>
      <ul class="dp-storage">
        {BROWSER_STORAGE.map((k) => (
          <li>
            <code>{k.key}</code> — {k.purpose} <em>({k.lifetime})</em>
          </li>
        ))}
      </ul>

      <h2>Sicherheitsverfahren</h2>
      <ul>
        <li>Passwoerter via <code>bcryptjs</code> (10 Runden), kein Klartext.</li>
        <li>Session als JWT in <code>httpOnly</code>-Cookie, Secret aus Env.</li>
        <li>Privacy-Tokens: nur sha256-Hash in der DB. Klartext nur einmal im Create-Response.</li>
        <li>Request-Log: IP als <code>sha256(salt || ip)</code> — nicht reversibel. Salt rotiert (Cadenz nicht oeffentlich).</li>
        <li>Rate-Limit auf oeffentlichen Post-Routen (Schwelle nicht oeffentlich).</li>
        <li>HTTPS via Vercel + HSTS.</li>
      </ul>

      <h2>Bot-Fingerprints (UA-Gate)</h2>
      <p>
        Eine einzige Liste mit zwei Aufgaben. Jeder eingehende Besuch wird
        anhand des <code>User-Agent</code>-Headers gegen diese Liste verglichen:
      </p>
      <ul>
        <li>
          <strong>Hart blocken (403)</strong> — wenn der Post per Toggle
          „KI-Block (hart)" oder einer nicht-oeffentlichen Sichtbarkeit
          KI-/Archiv-Crawler ausschliesst. Treffer in der Bot-Liste
          bekommen sofort 403 statt Inhalt.
        </li>
        <li>
          <strong>Fuer Statistik klassifizieren</strong> — auch wenn wir
          den Bot durchlassen, zaehlen wir ihn in den Server-Logs nach
          Kategorie (KI / Suche / Social / Archiv). Damit sehen wir
          spaeter, welche Crawler ueberhaupt unterwegs sind und welche
          Toggles greifen.
        </li>
      </ul>
      <p class="dp-mini">
        Eine Liste, damit „was wir blocken" und „was wir zaehlen" nicht
        auseinanderlaufen. Letzte Aktualisierung: <code>{LAST_REVIEWED}</code>.
      </p>
      <details class="dp-bots">
        <summary>Alle {BOT_FINGERPRINTS.length} Eintraege</summary>
        <ul>
          {BOT_FINGERPRINTS.map((b) => (
            <li><code>{b.name}</code> — Gruppe <em>{b.category}</em></li>
          ))}
        </ul>
      </details>

      <h2>Privacy-Toggles & Sichtbarkeit</h2>
      <p>Was die Toggles in deiner Werkzeugkiste konkret machen — Wirkung pro Toggle siehst du im InfoPopover am Editor.</p>
      <h3>Sichtbarkeitsstufen</h3>
      <ul>
        {VISIBILITIES.map((v) => <li><strong>{v.label}:</strong> {v.short}</li>)}
      </ul>
      <h3>Toggles</h3>
      <ul>
        {TOGGLES.map((t) => <li><strong>{t.label}:</strong> {t.short}</li>)}
      </ul>

      <h2>Backup-Schichten</h2>
      <ul>
        {LAYERS.map((l) => <li><strong>{l.label}:</strong> {l.short}{l.alwaysOn ? ' (Default an)' : ' (Opt-in)'}</li>)}
      </ul>
    </section>

    <!-- Tab: Rechte -->
    <section class="dp-panel" data-panel="actions">
      <h2>Auskunft / Export</h2>
      <p>
        DSGVO Art. 15 + 20. Lade alle deine Daten als JSON-Datei runter
        (Posts, Revisionen, Drafts, Tokens-Hash, Privacy-Defaults, Permissions).
      </p>
      <p><a class="dp-button" href="/api/user/export" download>Daten-Export (JSON)</a></p>

      <h2>Berichtigung</h2>
      <p>Posts, Quotes und RPG-Stand bearbeitest du in der jeweiligen Seite. Anmelde-/Profil-Daten in <a href="/me">/me</a>.</p>

      <h2>Backup-Webhook (A7)</h2>
      <p>
        Optional: jede Save-Aktion wird zusaetzlich an eine von dir gewaehlte URL gepostet.
        Echtes Off-Site-Backup auf deinem eigenen Endpunkt.
      </p>
      <form id="dpWebhookForm" class="dp-form">
        <label for="dpWebhookInput">Webhook-URL (https://…)</label>
        <input id="dpWebhookInput" type="url" placeholder="https://example.com/blog-mirror" />
        <button type="submit">Speichern</button>
        <span id="dpWebhookMsg" class="dp-msg"></span>
      </form>

      <h2>Account loeschen</h2>
      <p class="dp-warn">
        Achtung: loescht UNWIEDERBRINGLICH alle deine Daten (Posts, Revisionen,
        Drafts, Tokens, RPG-Stand, Inventar, Praeferenzen, Tester-Reports,
        deinen User-Account).
      </p>
      <form id="dpDeleteForm" class="dp-form">
        <label for="dpDeletePw">Aktuelles Passwort zur Bestaetigung</label>
        <input id="dpDeletePw" type="password" autocomplete="current-password" required />
        <button id="dpDeleteBtn" class="dp-button dp-button--danger" type="submit">Account loeschen</button>
        <span id="dpDeleteMsg" class="dp-msg"></span>
      </form>
    </section>
  </article>
</BaseLayout>

<style>
  .dp-page {
    max-width: 880px;
    margin: 1.5rem auto;
    padding: 0 1rem 4rem;
    line-height: 1.55;
  }
  .dp-head h1 { margin: 0 0 0.4rem; }
  .dp-sub { opacity: 0.78; margin: 0.3rem 0; font-size: 0.92rem; }
  .dp-tabs {
    display: flex;
    gap: 0.4rem;
    border-bottom: 1px solid var(--site-card-border);
    margin: 1.4rem 0 1rem;
  }
  .dp-tab {
    border: 0;
    background: transparent;
    color: inherit;
    padding: 0.5rem 0.9rem;
    cursor: pointer;
    font: inherit;
    border-bottom: 2px solid transparent;
    opacity: 0.7;
  }
  .dp-tab.is-active { border-bottom-color: currentColor; opacity: 1; }
  .dp-panel { display: none; }
  .dp-panel.is-active { display: block; }
  .dp-summary li { margin: 0.4rem 0; }
  .dp-mini { opacity: 0.7; font-size: 0.9rem; }
  .dp-perms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
  }
  .dp-perm-chip {
    display: inline-block;
    border: 1px solid var(--site-card-border);
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    opacity: 0.85;
  }
  .dp-hidden-cat summary { opacity: 0.6; }
  .dp-table-entry--inactive {
    opacity: 0.55;
    background: transparent;
    border-style: dashed;
  }
  .dp-cat { margin: 1rem 0; }
  .dp-cat summary {
    cursor: pointer;
    font-weight: 600;
    padding: 0.4rem 0;
    letter-spacing: 0.04em;
  }
  .dp-table-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.7rem;
  }
  .dp-table-entry {
    border: 1px solid var(--site-card-border);
    border-radius: 0.5rem;
    padding: 0.7rem 0.85rem;
    background: var(--site-card-bg);
  }
  .dp-table-entry h3 { margin: 0 0 0.2rem; font-size: 1rem; font-family: monospace; }
  .dp-purpose { margin: 0.2rem 0 0.5rem; }
  .dp-table-entry dl {
    margin: 0;
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.2rem 0.8rem;
    font-size: 0.86rem;
  }
  .dp-table-entry dt { opacity: 0.7; }
  .dp-services {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86rem;
  }
  .dp-services th, .dp-services td {
    border-bottom: 1px solid var(--site-card-border);
    padding: 0.45rem 0.5rem;
    text-align: left;
    vertical-align: top;
  }
  .dp-storage li { font-size: 0.88rem; margin: 0.3rem 0; }
  .dp-bots ul { columns: 2; font-size: 0.84rem; }
  .dp-button {
    display: inline-block;
    border: 1px solid var(--site-card-border);
    background: transparent;
    color: inherit;
    border-radius: 0.4rem;
    padding: 0.45rem 0.9rem;
    cursor: pointer;
    text-decoration: none;
    font: inherit;
  }
  .dp-button--danger {
    border-color: rgba(200, 80, 80, 0.7);
    color: #c44;
  }
  .dp-warn {
    border-left: 3px solid #c44;
    padding: 0.3rem 0.6rem;
    background: rgba(200, 80, 80, 0.05);
  }
  .dp-form { display: grid; gap: 0.4rem; max-width: 480px; }
  .dp-form input {
    border: 1px solid var(--site-card-border);
    background: transparent;
    color: inherit;
    border-radius: 0.4rem;
    padding: 0.4rem 0.55rem;
    font-family: inherit;
  }
  .dp-form button { width: max-content; }
  .dp-msg { margin-left: 0.5rem; opacity: 0.75; font-size: 0.85rem; }
</style>

<script>
  (function () {
    const tabs = document.querySelectorAll('.dp-tab');
    const panels = document.querySelectorAll('.dp-panel');
    function selectTab(t) {
      tabs.forEach((b) => b.classList.toggle('is-active', b.getAttribute('data-tab') === t));
      panels.forEach((p) => p.classList.toggle('is-active', p.getAttribute('data-panel') === t));
    }
    tabs.forEach((btn) => btn.addEventListener('click', () => selectTab(btn.getAttribute('data-tab'))));

    // "Alle anzeigen"-Link springt in den Details-Tab und klappt die
    // Hidden-Sektion auf.
    document.getElementById('dpShowAllToggle')?.addEventListener('click', (ev) => {
      ev.preventDefault();
      selectTab('details');
      const hidden = document.getElementById('dpHiddenSection');
      if (hidden) {
        hidden.open = true;
        hidden.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    // Webhook
    const wf = document.getElementById('dpWebhookForm');
    const wi = document.getElementById('dpWebhookInput');
    const wm = document.getElementById('dpWebhookMsg');
    if (wf && wi) {
      fetch('/api/user/privacy-defaults', { credentials: 'same-origin' })
        .then((r) => r.ok ? r.json() : null)
        .then((j) => { if (j && j.defaults) wi.value = j.defaults.backup_webhook_url || ''; })
        .catch(() => {});
      wf.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        wm.textContent = 'speichert …';
        try {
          const r = await fetch('/api/user/privacy-defaults', {
            method: 'PUT',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ backup_webhook_url: wi.value || '' }),
          });
          const j = await r.json();
          wm.textContent = j.success ? 'gespeichert.' : (j.error || 'Fehler.');
        } catch {
          wm.textContent = 'Netzwerkfehler.';
        }
      });
    }

    // Delete-Account: Passwort + Klartext-Bestaetigung beide pflicht.
    const delForm = document.getElementById('dpDeleteForm');
    const delPw = document.getElementById('dpDeletePw');
    const delMsg = document.getElementById('dpDeleteMsg');
    delForm?.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const pw = (delPw?.value || '').trim();
      if (!pw) {
        delMsg.textContent = 'Passwort erforderlich.';
        return;
      }
      const txt = window.prompt(
        'Account UNWIEDERBRINGLICH loeschen?\n\nBestaetige mit dem Wort:\n  Ich-meine-es'
      );
      if (txt !== 'Ich-meine-es') {
        delMsg.textContent = 'abgebrochen.';
        return;
      }
      delMsg.textContent = 'loescht …';
      try {
        const r = await fetch('/api/user/delete-account', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ confirm: 'Ich-meine-es', password: pw }),
        });
        const j = await r.json();
        if (j.success) {
          delMsg.textContent = 'Account geloescht. Du wirst weitergeleitet …';
          setTimeout(() => { window.location.href = '/'; }, 1200);
        } else {
          delMsg.textContent = j.error || 'Fehler.';
        }
      } catch {
        delMsg.textContent = 'Netzwerkfehler.';
      }
    });
  })();
</script>
