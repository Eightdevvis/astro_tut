---
/**
 * Seite: /quotes/new
 * Formular zum Einreichen eines Zitats.
 *
 * Server-seitige Checks (im Frontmatter):
 * 1. Ist der User eingeloggt? → sonst redirect zu /
 * 2. Hat der User das Recht "quote_poster"? → sonst Fehlermeldung
 *
 * Das Formular submitted per fetch an POST /api/quotes/add.
 */

import { jwtVerify } from 'jose';
import { hasPermission } from '../../lib/permissions.js';
import { getJwtSecretBytes } from '../../lib/jwt-secret.js';
import SiteFontOverrides from '../../components/SiteFontOverrides.astro';
import ThemeInit from '../../components/ThemeInit.astro';
import ThemeClient from '../../components/ThemeClient.astro';
import '../../styles/global.css';

// Session aus Cookie lesen
const token = Astro.cookies.get('session')?.value;
let username = null;
let allowed = false;

if (token) {
  try {
    const { payload } = await jwtVerify(token, getJwtSecretBytes());
    username = payload.username as string;
    allowed = await hasPermission(username, 'quote_poster');
  } catch {
    // ungültiger Token → username bleibt null
  }
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <ThemeInit />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f4f1ea" />
    <title>ZITAT EINREICHEN</title>
    <SiteFontOverrides />
    <style>
      html {
        -webkit-text-size-adjust: 100%;
      }
      body {
        background: var(--site-body-bg);
        color: var(--site-body-text);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100dvh;
        margin: 0;
        font-family: var(--font-family);
        padding-left: max(1rem, env(safe-area-inset-left));
        padding-right: max(1rem, env(safe-area-inset-right));
        padding-top: max(0.75rem, env(safe-area-inset-top));
        padding-bottom: max(3rem, calc(env(safe-area-inset-bottom) + 2.75rem));
        box-sizing: border-box;
        overflow-x: hidden;
      }
      h1 {
        font-family: var(--font-quote, 'Black Spiral');
        font-size: clamp(2rem, 9vmin, 4.5rem);
        line-height: 1.05;
        margin-bottom: clamp(1rem, 4vw, 2rem);
        letter-spacing: 2px;
        word-break: break-word;
        max-width: 100%;
      }
      .container {
        width: 100%;
        max-width: 600px;
        padding: clamp(0.75rem, 4vw, 2rem);
        box-sizing: border-box;
      }
      textarea {
        width: 100%;
        min-height: 140px;
        background: rgba(173, 216, 230, 0.15);
        border: 1px solid rgba(173, 216, 230, 0.4);
        border-radius: 8px;
        color: #fff;
        font-size: 1rem;
        padding: 1rem;
        resize: vertical;
        box-sizing: border-box;
        max-width: 100%;
      }
      textarea::placeholder { color: rgba(255,255,255,0.4); }
      .author-field {
        width: 100%;
        margin-top: 1rem;
        padding: 0.75rem 1rem;
        min-height: 2.75rem;
        background: rgba(173, 216, 230, 0.12);
        border: 1px solid rgba(173, 216, 230, 0.35);
        border-radius: 8px;
        color: #fff;
        font-size: 1rem;
        box-sizing: border-box;
        max-width: 100%;
      }
      .author-field::placeholder { color: rgba(255,255,255,0.35); }
      button {
        margin-top: 1rem;
        width: 100%;
        min-height: 2.75rem;
        padding: 0.75rem 1rem;
        background: rgba(173, 216, 230, 0.25);
        border: 1px solid rgba(173, 216, 230, 0.5);
        border-radius: 8px;
        color: #fff;
        font-size: 1rem;
        letter-spacing: 2px;
        cursor: pointer;
        text-transform: uppercase;
        touch-action: manipulation;
      }
      button:hover { background: rgba(173, 216, 230, 0.4); }
      .msg { margin-top: 1rem; text-align: center; font-size: 0.9rem; letter-spacing: 1px; }
      .back { display: block; margin-top: 2rem; color: rgba(255,255,255,0.5); text-align: center; text-decoration: none; letter-spacing: 1px; font-size: 0.85rem; }
      .back:hover { color: #fff; }
      .quote-manage-link {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 0.5rem max(0.75rem, env(safe-area-inset-right)) max(0.65rem, env(safe-area-inset-bottom))
          max(0.75rem, env(safe-area-inset-left));
        text-align: center;
        z-index: 20;
        font-size: clamp(0.68rem, 2.8vw, 0.75rem);
        letter-spacing: 0.12em;
        pointer-events: none;
      }
      .quote-manage-link a {
        color: rgba(173, 216, 230, 0.55);
        text-decoration: none;
        display: inline-block;
        min-height: 2.75rem;
        line-height: 2.75rem;
        padding: 0 0.75rem;
        pointer-events: auto;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
      }
      .quote-manage-link a:hover { color: rgba(173, 216, 230, 0.95); }
      .no-permission { text-align: center; color: rgba(173,216,230,0.8); letter-spacing: 2px; }
      .no-permission p { margin: 0 0 1rem; max-width: 100%; word-break: break-word; }
      html:not(.dark) textarea,
      html:not(.dark) .author-field {
        color: #1a1a1a;
        background: rgba(255, 255, 255, 0.92);
        border-color: rgba(0, 0, 0, 0.18);
      }
      html:not(.dark) textarea::placeholder,
      html:not(.dark) .author-field::placeholder {
        color: rgba(0, 0, 0, 0.38);
      }
      html:not(.dark) button {
        color: #1a1a1a;
        background: rgba(100, 140, 200, 0.28);
        border-color: rgba(0, 0, 0, 0.2);
      }
      html:not(.dark) button:hover {
        background: rgba(100, 140, 200, 0.42);
      }
      html:not(.dark) .back {
        color: rgba(0, 0, 0, 0.45);
      }
      html:not(.dark) .back:hover {
        color: #1a1a1a;
      }
      html:not(.dark) .no-permission {
        color: rgba(40, 55, 80, 0.85);
      }
    </style>
  </head>
  <body>
    {!username ? (
      <!-- Nicht eingeloggt -->
      <div class="container no-permission">
        <h1>HEY</h1>
        <p>DU MUSST EINGELOGGT SEIN UM ZITATE EINZUREICHEN.</p>
        <a href="/" class="back">← ZURÜCK</a>
      </div>
    ) : !allowed ? (
      <!-- Eingeloggt aber kein Recht -->
      <div class="container no-permission">
        <h1>NOPE</h1>
        <p>DU HAST KEINE BERECHTIGUNG UM ZITATE EINZUREICHEN.</p>
        <a href="/" class="back">← ZURÜCK</a>
      </div>
    ) : (
      <!-- Eingeloggt + Berechtigung vorhanden -->
      <div class="container">
        <h1>ZITAT</h1>
        <textarea id="quoteText" placeholder="DEIN ZITAT..."></textarea>
        <input
          type="text"
          id="quoteAuthor"
          class="author-field"
          placeholder="AUTOR (OPTIONAL)"
          maxlength="200"
          autocomplete="off"
        />
        <button id="submitBtn">EINREICHEN</button>
        <div class="msg" id="msg"></div>
        <a href="/" class="back">← ZURÜCK</a>
      </div>
      <div class="quote-manage-link" aria-hidden="false">
        <a href="/quotes/manage">MEINE ZITATE</a>
      </div>
    )}

    <script>
      const btn = document.getElementById('submitBtn') as HTMLButtonElement | null;
      const msg = document.getElementById('msg') as HTMLElement | null;
      const textarea = document.getElementById('quoteText') as HTMLTextAreaElement | null;
      const authorInput = document.getElementById('quoteAuthor') as HTMLInputElement | null;
      if (btn && msg && textarea && authorInput) {
        btn.addEventListener('click', async () => {
          const text = textarea.value;
          if (!text.trim()) { msg.textContent = 'ZITAT DARF NICHT LEER SEIN'; return; }

          btn.disabled = true;
          msg.textContent = '';
          try {
            const res = await fetch('/api/quotes/add', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'same-origin',
              body: JSON.stringify({ text, author: authorInput.value })
            });
            const data = await res.json().catch(() => ({}));

            if (res.ok && data.success) {
              msg.style.color = 'lightblue';
              msg.textContent = 'ZITAT GESPEICHERT ✓';
              textarea.value = '';
              authorInput.value = '';
            } else {
              msg.style.color = 'salmon';
              msg.textContent = (data.error || 'FEHLER').toUpperCase();
            }
          } catch {
            msg.style.color = 'salmon';
            msg.textContent = 'NETZWERK- ODER SERVERFEHLER';
          }
          btn.disabled = false;
        });
      }
    </script>
    <ThemeClient />
  </body>
</html>
