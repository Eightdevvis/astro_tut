---
/**
 * /quotes/manage — eigene Zitate listen und bearbeiten.
 * Gleiche Auth wie /quotes/new (quote_poster).
 */

import { jwtVerify } from 'jose';
import { hasPermission } from '../../lib/permissions.js';
import { getJwtSecretBytes } from '../../lib/jwt-secret.js';
import SiteFontOverrides from '../../components/SiteFontOverrides.astro';
import '../../styles/global.css';

const token = Astro.cookies.get('session')?.value;
let username: string | null = null;
let allowed = false;

if (token) {
  try {
    const { payload } = await jwtVerify(token, getJwtSecretBytes());
    username = payload.username as string;
    allowed = await hasPermission(username, 'quote_poster');
  } catch {
    // ungültig
  }
}
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>MEINE ZITATE</title>
    <SiteFontOverrides />
    <style>
      html {
        -webkit-text-size-adjust: 100%;
      }
      body {
        background: #000;
        color: #fff;
        display: flex;
        flex-direction: column;
        align-items: center;
        min-height: 100dvh;
        margin: 0;
        font-family: var(--font-family);
        padding-left: max(0.75rem, env(safe-area-inset-left));
        padding-right: max(0.75rem, env(safe-area-inset-right));
        padding-top: max(1rem, env(safe-area-inset-top));
        padding-bottom: max(5rem, calc(env(safe-area-inset-bottom) + 3.5rem));
        box-sizing: border-box;
        overflow-x: hidden;
      }
      h1 {
        font-family: var(--font-quote, 'Black Spiral');
        font-size: clamp(1.75rem, 8vmin, 4rem);
        line-height: 1.08;
        margin-bottom: 1.25rem;
        letter-spacing: 2px;
        text-align: center;
        word-break: break-word;
        max-width: 100%;
      }
      .container {
        width: 100%;
        max-width: 600px;
        flex: 1 0 auto;
        box-sizing: border-box;
      }
      .no-permission {
        text-align: center;
        color: rgba(173, 216, 230, 0.8);
        letter-spacing: 2px;
      }
      .no-permission p {
        margin: 0 0 1rem;
        max-width: 100%;
        word-break: break-word;
      }
      .back {
        display: block;
        margin-top: 2rem;
        color: rgba(255, 255, 255, 0.5);
        text-align: center;
        text-decoration: none;
        letter-spacing: 1px;
        font-size: 0.85rem;
      }
      .back:hover {
        color: #fff;
      }
      #status {
        text-align: center;
        color: rgba(255, 255, 255, 0.45);
        font-size: 0.9rem;
        letter-spacing: 1px;
        margin-bottom: 1rem;
      }
      .quote-list {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      /* Dezente „Streifen“ pro Zitat: kaum sichtbare Kante + leichte Fläche */
      .quote-stripe {
        margin-bottom: 0.5rem;
        padding: 0.65rem 0 0.65rem 0.65rem;
        border-radius: 4px;
        border-left: 2px solid rgba(173, 216, 230, 0.14);
        background: linear-gradient(
          90deg,
          rgba(173, 216, 230, 0.045) 0%,
          rgba(255, 255, 255, 0.015) min(100%, 12rem),
          transparent 100%
        );
        box-sizing: border-box;
      }
      .quote-stripe-inner {
        display: flex;
        align-items: flex-start;
        gap: 0.35rem;
        min-width: 0;
      }
      .quote-stripe-body {
        flex: 1;
        min-width: 0;
      }
      .quote-stripe-tools {
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.15rem;
        padding-top: 0.1rem;
      }
      .quote-icon-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.75rem;
        height: 2.75rem;
        margin: 0;
        padding: 0;
        border: none;
        border-radius: 8px;
        background: transparent;
        color: rgba(173, 216, 230, 0.55);
        cursor: pointer;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
      }
      .quote-icon-btn:hover,
      .quote-icon-btn:focus-visible {
        color: rgba(255, 255, 255, 0.95);
        background: rgba(255, 255, 255, 0.06);
        outline: none;
      }
      .quote-icon-btn--danger {
        color: rgba(255, 140, 130, 0.55);
      }
      .quote-icon-btn--danger:hover,
      .quote-icon-btn--danger:focus-visible {
        color: rgba(255, 170, 160, 0.95);
        background: rgba(255, 80, 80, 0.12);
      }
      .quote-icon-btn svg {
        display: block;
        pointer-events: none;
      }
      .quote-item-text {
        color: rgba(255, 255, 255, 0.88);
        font-size: 0.95rem;
        line-height: 1.45;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        word-break: break-word;
        text-transform: uppercase;
      }
      .quote-item-meta {
        margin-top: 0.45rem;
        font-size: clamp(0.65rem, 2.6vw, 0.78rem);
        letter-spacing: 0.07em;
        color: rgba(173, 216, 230, 0.48);
        overflow-wrap: anywhere;
      }
      .quote-stripe--editing {
        padding: 0.75rem 0.65rem 0.75rem 0.75rem;
      }
      textarea.edit-text {
        width: 100%;
        min-height: 96px;
        max-width: 100%;
        background: rgba(173, 216, 230, 0.1);
        border: 1px solid rgba(173, 216, 230, 0.28);
        border-radius: 6px;
        color: #fff;
        font-size: 1rem;
        padding: 0.65rem 0.7rem;
        resize: vertical;
        box-sizing: border-box;
        text-transform: uppercase;
      }
      input.edit-author {
        width: 100%;
        max-width: 100%;
        margin-top: 0.5rem;
        min-height: 2.75rem;
        padding: 0.55rem 0.7rem;
        background: rgba(173, 216, 230, 0.08);
        border: 1px solid rgba(173, 216, 230, 0.25);
        border-radius: 6px;
        color: #fff;
        font-size: 1rem;
        box-sizing: border-box;
        text-transform: uppercase;
      }
      .edit-toolbar {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin-top: 0.6rem;
      }
      .edit-btn-primary,
      .edit-btn-secondary {
        min-height: 2.5rem;
        padding: 0.35rem 0.9rem;
        font-size: 0.72rem;
        letter-spacing: 0.1em;
        border-radius: 6px;
        cursor: pointer;
        text-transform: uppercase;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
      }
      .edit-btn-primary {
        border: 1px solid rgba(173, 216, 230, 0.45);
        background: rgba(173, 216, 230, 0.18);
        color: #fff;
      }
      .edit-btn-primary:hover {
        background: rgba(173, 216, 230, 0.3);
      }
      .edit-btn-secondary {
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: transparent;
        color: rgba(255, 255, 255, 0.55);
      }
      .edit-btn-secondary:hover {
        color: rgba(255, 255, 255, 0.9);
        background: rgba(255, 255, 255, 0.05);
      }
      .edit-msg {
        margin-top: 0.45rem;
        font-size: 0.75rem;
        text-align: right;
        letter-spacing: 0.06em;
      }
      .quote-new-link {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 0.35rem max(0.75rem, env(safe-area-inset-right)) max(0.55rem, env(safe-area-inset-bottom))
          max(0.75rem, env(safe-area-inset-left));
        text-align: center;
        z-index: 20;
        font-size: clamp(0.68rem, 2.8vw, 0.75rem);
        letter-spacing: 0.12em;
        pointer-events: none;
      }
      .quote-new-link a {
        color: rgba(173, 216, 230, 0.55);
        text-decoration: none;
        display: inline-block;
        min-height: 2.75rem;
        line-height: 2.75rem;
        padding: 0 0.75rem;
        pointer-events: auto;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
      }
      .quote-new-link a:hover {
        color: rgba(173, 216, 230, 0.95);
      }
    </style>
  </head>
  <body>
    {
      !username ? (
        <div class="container no-permission">
          <h1>HEY</h1>
          <p>DU MUSST EINGELOGGT SEIN.</p>
          <a href="/" class="back">
            ← ZURÜCK
          </a>
        </div>
      ) : !allowed ? (
        <div class="container no-permission">
          <h1>NOPE</h1>
          <p>DU HAST KEINE BERECHTIGUNG.</p>
          <a href="/" class="back">
            ← ZURÜCK
          </a>
        </div>
      ) : (
        <>
          <div class="container">
            <h1>MEINE ZITATE</h1>
            <div id="status">…</div>
            <ul class="quote-list" id="quoteList" />
          </div>
          <div class="quote-new-link">
            <a href="/quotes/new">NEUES ZITAT</a>
          </div>
        </>
      )
    }

    {
      username && allowed ? (
        <script>
          const ICON_PENCIL =
            '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>';
          const ICON_TRASH =
            '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>';

          function attributionLabel(q: {
            author: string | null;
            username: string;
          }) {
            const a = q.author;
            if (a !== null && a !== undefined) {
              const t = String(a).trim();
              if (t !== '') return t.toUpperCase();
              return 'OHNE AUTOR';
            }
            return String(q.username).toUpperCase();
          }

          const statusEl = document.getElementById('status') as HTMLElement | null;
          const listEl = document.getElementById('quoteList') as HTMLUListElement | null;

          function refreshEmptyState() {
            if (!statusEl || !listEl) return;
            if (listEl.children.length === 0) {
              statusEl.textContent = 'NOCH KEINE ZITATE.';
            }
          }

          async function load() {
            if (!statusEl || !listEl) return;
            statusEl.textContent = '…';
            listEl.innerHTML = '';
            try {
              const res = await fetch('/api/quotes/mine', { credentials: 'same-origin' });
              const data = await res.json().catch(() => ({}));
              if (!res.ok) {
                statusEl.textContent = (data.error || 'FEHLER').toUpperCase();
                return;
              }
              const quotes = data.quotes || [];
              if (quotes.length === 0) {
                statusEl.textContent = 'NOCH KEINE ZITATE.';
                return;
              }
              statusEl.textContent = '';
              for (const q of quotes) {
                listEl.appendChild(renderItem(q));
              }
            } catch {
              statusEl.textContent = 'LADEN FEHLGESCHLAGEN';
            }
          }

          function renderItem(q: {
            id: number;
            text: string;
            author: string | null;
            username: string;
            created_at: string;
          }) {
            const li = document.createElement('li');
            li.className = 'quote-stripe';
            li.dataset.id = String(q.id);

            const inner = document.createElement('div');
            inner.className = 'quote-stripe-inner';

            const body = document.createElement('div');
            body.className = 'quote-stripe-body';

            const textEl = document.createElement('div');
            textEl.className = 'quote-item-text';
            textEl.textContent = q.text;

            const meta = document.createElement('div');
            meta.className = 'quote-item-meta';
            meta.textContent = `${attributionLabel(q)} · ${formatDate(q.created_at)}`;

            body.appendChild(textEl);
            body.appendChild(meta);

            const tools = document.createElement('div');
            tools.className = 'quote-stripe-tools';
            tools.setAttribute('role', 'group');
            tools.setAttribute('aria-label', 'Aktionen');

            const editBtn = document.createElement('button');
            editBtn.type = 'button';
            editBtn.className = 'quote-icon-btn';
            editBtn.title = 'Bearbeiten';
            editBtn.setAttribute('aria-label', 'Bearbeiten');
            editBtn.innerHTML = ICON_PENCIL;
            editBtn.addEventListener('click', () => {
              enterEdit(li, q);
            });

            const delBtn = document.createElement('button');
            delBtn.type = 'button';
            delBtn.className = 'quote-icon-btn quote-icon-btn--danger';
            delBtn.title = 'Löschen';
            delBtn.setAttribute('aria-label', 'Löschen');
            delBtn.innerHTML = ICON_TRASH;
            delBtn.addEventListener('click', () => {
              void deleteQuote(li, q, delBtn);
            });

            tools.appendChild(editBtn);
            tools.appendChild(delBtn);

            inner.appendChild(body);
            inner.appendChild(tools);
            li.appendChild(inner);
            return li;
          }

          async function deleteQuote(
            li: HTMLLIElement,
            q: { id: number },
            btn: HTMLButtonElement
          ) {
            if (!confirm('Dieses Zitat wirklich löschen?')) return;
            btn.disabled = true;
            try {
              const id = Number(q.id);
              const res = await fetch('/api/quotes/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify({ id }),
              });
              const data = await res.json().catch(() => ({}));
              if (res.ok && data.success) {
                li.remove();
                refreshEmptyState();
              } else {
                alert((data.error || 'Löschen fehlgeschlagen').toString());
                btn.disabled = false;
              }
            } catch {
              alert('Netzwerk- oder Serverfehler');
              btn.disabled = false;
            }
          }

          function formatDate(iso: string) {
            try {
              const d = new Date(iso);
              if (Number.isNaN(d.getTime())) return iso;
              return d.toLocaleDateString('de-DE', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric',
              });
            } catch {
              return iso;
            }
          }

          function enterEdit(
            li: HTMLLIElement,
            q: {
              id: number;
              text: string;
              author: string | null;
              username: string;
              created_at: string;
            }
          ) {
            li.className = 'quote-stripe quote-stripe--editing';
            li.innerHTML = '';

            const ta = document.createElement('textarea');
            ta.className = 'edit-text';
            ta.value = q.text;

            const auth = document.createElement('input');
            auth.type = 'text';
            auth.className = 'edit-author';
            auth.placeholder = 'AUTOR (LEER = KEINE ANGABE)';
            auth.maxLength = 200;
            auth.autocomplete = 'off';
            if (q.author !== null && q.author !== undefined) {
              auth.value = String(q.author);
            } else {
              auth.value = q.username;
            }

            const msg = document.createElement('div');
            msg.className = 'edit-msg';

            const row = document.createElement('div');
            row.className = 'edit-toolbar';

            const cancelBtn = document.createElement('button');
            cancelBtn.type = 'button';
            cancelBtn.className = 'edit-btn-secondary';
            cancelBtn.textContent = 'ABBRECHEN';

            const saveBtn = document.createElement('button');
            saveBtn.type = 'button';
            saveBtn.className = 'edit-btn-primary';
            saveBtn.textContent = 'SPEICHERN';

            const id = q.id;

            saveBtn.addEventListener('click', async () => {
              const text = ta.value.trim();
              if (!text) {
                msg.style.color = 'salmon';
                msg.textContent = 'ZITAT DARF NICHT LEER SEIN';
                return;
              }
              saveBtn.disabled = true;
              cancelBtn.disabled = true;
              msg.textContent = '';
              try {
                const res = await fetch(`/api/quotes/${id}`, {
                  method: 'PATCH',
                  headers: { 'Content-Type': 'application/json' },
                  credentials: 'same-origin',
                  body: JSON.stringify({ text, author: auth.value }),
                });
                const data = await res.json().catch(() => ({}));
                if (res.ok && data.success) {
                  const updated = {
                    ...q,
                    text,
                    author: auth.value.trim() === '' ? '' : auth.value.trim(),
                  };
                  li.replaceWith(renderItem(updated));
                } else {
                  msg.style.color = 'salmon';
                  msg.textContent = (data.error || 'FEHLER').toUpperCase();
                  saveBtn.disabled = false;
                  cancelBtn.disabled = false;
                }
              } catch {
                msg.style.color = 'salmon';
                msg.textContent = 'NETZWERK- ODER SERVERFEHLER';
                saveBtn.disabled = false;
                cancelBtn.disabled = false;
              }
            });

            cancelBtn.addEventListener('click', () => {
              li.replaceWith(renderItem(q));
            });

            row.appendChild(cancelBtn);
            row.appendChild(saveBtn);
            li.appendChild(ta);
            li.appendChild(auth);
            li.appendChild(msg);
            li.appendChild(row);
          }

          load();
        </script>
      ) : null
    }

    {username && allowed ? (
      <a href="/" class="back" style="margin-top: auto;">
        ← ZURÜCK
      </a>
    ) : null}
  </body>
</html>
