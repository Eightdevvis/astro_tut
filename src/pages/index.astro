---
import Nav2 from '../components/Nav2.astro';
import QuoteDisplay from '../components/QuoteDisplay.jsx';
import SiteFontOverrides from '../components/SiteFontOverrides.astro';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeClient from '../components/ThemeClient.astro';
import TesterBugBar from '../components/TesterBugBar.jsx';
import GraffitiLayer from '../components/GraffitiLayer.jsx';
import { ensureDbSchema, getDb } from '../lib/db.js';
import '../styles/global.css';

// Alle Markdown-Posts unter ./posts einsammeln. eager:true heisst: zur Build-Zeit
// werden alle Module direkt geladen; jedes Modul hat frontmatter, url, Content,
// rawContent() (Body als Markdown ohne Frontmatter), compiledContent().
const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true })) as any[];

// pubDate aus Frontmatter strikt in ms umwandeln (fehlt/ungueltig -> 0).
// Wichtig: Date.parse() akzeptiert manche kaputten Formate "irgendwie" und kann
// dadurch falsche Zukunftsdaten erzeugen.
function parseStrictFrontmatterDate(value: unknown): number {
  const raw = String(value ?? '').trim();
  if (!raw) return 0;

  const m = raw.match(/^(\d{4})-(\d{2})-(\d{2})(?:[T\s](\d{2}):(\d{2})(?::(\d{2}))?(?:\.\d{1,3})?(Z)?)?$/);
  if (!m) return 0;

  const year = Number(m[1]);
  const month = Number(m[2]);
  const day = Number(m[3]);
  const hour = Number(m[4] ?? '0');
  const minute = Number(m[5] ?? '0');
  const second = Number(m[6] ?? '0');
  const hasTime = Boolean(m[4]);
  const hasZulu = m[7] === 'Z';

  if (month < 1 || month > 12) return 0;
  if (day < 1 || day > 31) return 0;
  if (hour < 0 || hour > 23) return 0;
  if (minute < 0 || minute > 59) return 0;
  if (second < 0 || second > 59) return 0;

  const t = hasTime && hasZulu
    ? Date.UTC(year, month - 1, day, hour, minute, second, 0)
    : new Date(year, month - 1, day, hour, minute, second, 0).getTime();

  if (Number.isNaN(t)) return 0;
  const check = hasTime && hasZulu ? new Date(t) : new Date(t);
  if (
    check.getFullYear() !== year ||
    check.getMonth() !== month - 1 ||
    check.getDate() !== day ||
    check.getHours() !== hour ||
    check.getMinutes() !== minute ||
    check.getSeconds() !== second
  ) {
    return 0;
  }
  return t;
}

function pubTime(post: any): number {
  const d = post?.frontmatter?.pubDate;
  if (d == null) return 0;
  return parseStrictFrontmatterDate(d);
}

// Neuester Post zuerst; bei Gleichstand deterministisch ueber url.
const sorted = [...allPosts].sort((a, b) => {
  const diff = pubTime(b) - pubTime(a);
  if (diff !== 0) return diff;
  return String(b.url ?? '').localeCompare(String(a.url ?? ''));
});
const lastMarkdownPost = sorted[0] ?? null;

function dbTime(value: unknown): number {
  const raw = String(value ?? '').trim();
  if (!raw) return 0;
  const normalized = raw.includes('T') ? raw : `${raw.replace(' ', 'T')}Z`;
  const t = Date.parse(normalized);
  return Number.isNaN(t) ? 0 : t;
}

let lastDbPost: null | {
  id: number;
  created_at: string;
  content_text: string;
} = null;
try {
  await ensureDbSchema();
  const result = await getDb().execute({
    sql: `SELECT id, created_at, content_text
       FROM blog_posts
      ORDER BY datetime(created_at) DESC, id DESC
      LIMIT 1`,
    args: [],
  });
  const row = result.rows?.[0];
  if (row) {
    lastDbPost = {
      id: Number(row.id ?? 0),
      created_at: String(row.created_at ?? ''),
      content_text: String(row.content_text ?? ''),
    };
  }
} catch (err) {
  console.error('index: failed to load latest db blog post', err);
}

// Markdown-Syntax leicht abraeumen, damit das Snippet als Klartext lesbar bleibt.
// Bewusst minimal: Headings, Links, Inline-Emphasis, Quote-/Code-Marker raus.
// Komplexere Sachen (Tabellen, HTML) sind hier kein Thema.
function stripMarkdownLight(src: string): string {
  return src
    .replace(/```[\s\S]*?```/g, ' ')          // Codeblocks komplett raus
    .replace(/`([^`]+)`/g, '$1')               // Inline-Code: nur Backticks raus
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')     // Bilder raus
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')   // Links: nur Anzeigetext behalten
    .replace(/^#{1,6}\s+/gm, '')               // Heading-Marker
    .replace(/^\s*[-*+]\s+/gm, '')             // Listen-Marker
    .replace(/^\s*>\s?/gm, '')                 // Blockquote-Marker
    .replace(/[*_~]+/g, '')                    // bold/italic/strike
    .replace(/\s+/g, ' ')                      // Whitespace kollabieren
    .trim();
}

// Aus dem Klartext ein zufaelliges Stueck der gewuenschten Laenge schneiden.
// Wortgrenzen respektieren: Anfang an naechsten Space, Ende am letzten Space davor.
// Wenn der Text kuerzer als length ist, gebe ihn ganz zurueck.
function pickRandomSnippet(plain: string, length = 220): string {
  if (!plain) return '';
  if (plain.length <= length) return plain;
  const maxStart = plain.length - length;
  const rawStart = Math.floor(Math.random() * (maxStart + 1));
  // Vom Random-Start zum naechsten Space springen, damit wir nicht mitten im Wort starten.
  const spaceAfter = plain.indexOf(' ', rawStart);
  const start = rawStart === 0 ? 0 : (spaceAfter > -1 && spaceAfter < rawStart + 40 ? spaceAfter + 1 : rawStart);
  const slice = plain.slice(start, start + length);
  // Letztes vollstaendiges Wort als Ende.
  const lastSpace = slice.lastIndexOf(' ');
  const trimmed = lastSpace > length * 0.6 ? slice.slice(0, lastSpace) : slice;
  const prefix = start > 0 ? '… ' : '';
  const suffix = start + length < plain.length ? ' …' : '';
  return `${prefix}${trimmed.trim()}${suffix}`;
}

// Roh-Body des letzten Posts holen und Snippet bauen. rawContent ist eine Funktion
// am Astro-Markdown-Modul; defensive Fallbacks fuer den Fall, dass der Build-Hook
// das Modul anders liefert.
let lastPostSnippet = '';
let lastPostTitle = '';
let lastPostUrl = '';
const markdownTs = pubTime(lastMarkdownPost);
const dbTs = dbTime(lastDbPost?.created_at);

if (dbTs > markdownTs && lastDbPost) {
  const plain = String(lastDbPost.content_text || '').trim();
  lastPostTitle = plain.split('\n').find((line) => line.trim().length > 0)?.trim().slice(0, 90) || 'Neuer Blogpost';
  lastPostSnippet = pickRandomSnippet(plain, 220);
  lastPostUrl = lastDbPost.id > 0 ? `/posts/db/${lastDbPost.id}` : '';
} else if (lastMarkdownPost) {
  const raw = typeof lastMarkdownPost.rawContent === 'function' ? String(lastMarkdownPost.rawContent() ?? '') : '';
  const plain = stripMarkdownLight(raw);
  lastPostTitle = String(lastMarkdownPost.frontmatter?.title ?? '').trim();
  lastPostSnippet = pickRandomSnippet(plain, 220);
  lastPostUrl = String(lastMarkdownPost.url ?? '').trim();
}
---

<html lang="en" class="home">
  <head>
    <meta charset="utf-8" />
    <ThemeInit />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f4f1ea" />
    <title>SASH</title>
    <SiteFontOverrides />
  </head>
  <body>
    <Nav2 variant="home" />
    <header class="home-hero">
      <h1 class="home-hero-title">SaSh</h1>
    </header>
    <QuoteDisplay client:load />

    <section class="home-tail" aria-label="Letzter Blogpost">
      {lastPostTitle && lastPostUrl && (
        <a
          href={lastPostUrl}
          class="last-post-card"
          aria-label={`Letzter Blogpost: ${lastPostTitle}`}
        >
          <span class="last-post-card__eyebrow">letzter blogpost</span>
          <h2 class="last-post-card__title">{lastPostTitle}</h2>
          {lastPostSnippet && (
            <p class="last-post-card__snippet">{lastPostSnippet}</p>
          )}
        </a>
      )}
    </section>
    <GraffitiLayer client:load />
    <TesterBugBar client:load />
    <ThemeClient />
  </body>
</html>

<style is:global>
  html.home {
    background-color: var(--home-page-bg);
  }
  /* Nur Abstand für fixierte Icon-Leiste; großer Titel scrollt mit im Fluss darunter. */
  html.home body {
    background-color: var(--home-page-bg);
    margin: 0;
    padding: 0;
    padding-top: calc(var(--nav-strip-h) + env(safe-area-inset-top, 0px));
  }

  /* Global h1-Regeln (margin, font-weight) würden den Hero-Titel verschieben — hier zurücksetzen. */
  html.home .home-hero-title {
    margin: 0;
    font-weight: normal;
  }
</style>
<style>
  .home-hero {
    position: relative;
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding-left: max(0.75rem, env(safe-area-inset-left, 0px));
    padding-right: max(0.75rem, env(safe-area-inset-right, 0px));
    box-sizing: border-box;
    overflow-x: clip;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  /*
   * Zentrierung per Flexbox (stabil auf Mobile); scaleX separat ohne translateX,
   * damit nichts nach rechts „wandert“.
   */
  .home-hero-title {
    font-family: var(--font-hero, 'Protest Demo');
    font-size: 20vh;
    color: var(--home-hero-text);
    display: block;
    position: relative;
    left: auto;
    width: max-content;
    max-width: min(100%, 100vw - 1.5rem);
    padding: 0;
    padding-top: calc(1rem + 5vh);
    line-height: 1;
    text-align: center;
    transform: scaleX(0.6);
    transform-origin: center top;
  }

  @media screen and (max-width: 767px) {
    .home-hero-title {
      font-size: clamp(2.25rem, min(11vh, 12vw), 3.5rem);
      padding-top: calc(0.75rem + 3vh);
    }
  }

  .home-tail {
    margin-top: 4rem;
    padding: 0 1rem 3rem;
    opacity: var(--home-tail-opacity);
    display: flex;
    justify-content: center;
  }

  .last-post-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: min(640px, 100%);
    padding: 1.5rem 1.5rem 1.75rem;
    border-radius: 1rem;
    background: var(--site-card-bg);
    color: var(--site-card-text);
    border: 1px solid var(--site-card-border);
    box-shadow:
      var(--site-card-inset-soft),
      var(--site-card-inset-strong),
      var(--site-card-shadow);
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .last-post-card:hover,
  .last-post-card:focus-visible {
    transform: translateY(-2px);
    outline: none;
  }

  .last-post-card__eyebrow {
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .last-post-card__title {
    margin: 0;
    font-size: 1.6rem;
    line-height: 1.2;
    font-weight: 600;
  }

  .last-post-card__snippet {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    opacity: 0.85;
    font-style: italic;
  }

  @media (max-width: 480px) {
    .last-post-card {
      padding: 1.1rem 1.1rem 1.3rem;
    }
    .last-post-card__title {
      font-size: 1.35rem;
    }
  }
</style>
