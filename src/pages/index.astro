---
import Nav2 from '../components/Nav2.astro';
import QuoteDisplay from '../components/QuoteDisplay.jsx';
import SiteFontOverrides from '../components/SiteFontOverrides.astro';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeClient from '../components/ThemeClient.astro';
import TesterBugBar from '../components/TesterBugBar.jsx';
import GraffitiLayer from '../components/GraffitiLayer.jsx';
import SiteInventory from '../components/SiteInventory.jsx';
import SitePlacedItemsLayer from '../components/SitePlacedItemsLayer.jsx';
import { ensureDbSchema, getDb } from '../lib/db.js';
import '../styles/global.css';

function dbTime(value: unknown): number {
  const raw = String(value ?? '').trim();
  if (!raw) return 0;
  const normalized = raw.includes('T') ? raw : `${raw.replace(' ', 'T')}Z`;
  const t = Date.parse(normalized);
  return Number.isNaN(t) ? 0 : t;
}

const POSTS_ON_HOME = 6;

type DbPost = {
  id: number;
  created_at: string;
  content_text: string;
};

let recentDbPosts: DbPost[] = [];
try {
  await ensureDbSchema();
  const result = await getDb().execute({
    sql: `SELECT id, created_at, content_text
       FROM blog_posts
      WHERE deleted_at IS NULL
      ORDER BY datetime(created_at) DESC, id DESC
      LIMIT ?`,
    args: [POSTS_ON_HOME],
  });
  recentDbPosts = (result.rows || []).map((row) => ({
    id: Number(row.id ?? 0),
    created_at: String(row.created_at ?? ''),
    content_text: String(row.content_text ?? ''),
  }));
} catch (err) {
  console.error('index: failed to load recent db blog posts', err);
}

// Aus dem Klartext ein zufaelliges Stueck der gewuenschten Laenge schneiden.
// Wortgrenzen respektieren: Anfang an naechsten Space, Ende am letzten Space davor.
// Wenn der Text kuerzer als length ist, gebe ihn ganz zurueck.
function pickRandomSnippet(plain: string, length = 220): string {
  if (!plain) return '';
  if (plain.length <= length) return plain;
  const maxStart = plain.length - length;
  const rawStart = Math.floor(Math.random() * (maxStart + 1));
  // Vom Random-Start zum naechsten Space springen, damit wir nicht mitten im Wort starten.
  const spaceAfter = plain.indexOf(' ', rawStart);
  const start = rawStart === 0 ? 0 : (spaceAfter > -1 && spaceAfter < rawStart + 40 ? spaceAfter + 1 : rawStart);
  const slice = plain.slice(start, start + length);
  // Letztes vollstaendiges Wort als Ende.
  const lastSpace = slice.lastIndexOf(' ');
  const trimmed = lastSpace > length * 0.6 ? slice.slice(0, lastSpace) : slice;
  const prefix = start > 0 ? '… ' : '';
  const suffix = start + length < plain.length ? ' …' : '';
  return `${prefix}${trimmed.trim()}${suffix}`;
}

// DB-Posts in die Home-Liste mappen — eine Quelle, der MD-Loader ist obsolet
// nach der Migration aller Markdown-Posts in blog_posts.
type HomePost = { title: string; url: string; plain: string; time: number };

const homePosts = recentDbPosts
  .map((row): HomePost => {
    const plain = String(row.content_text || '').trim();
    const title = plain.split('\n').find((line) => line.trim().length > 0)?.trim().slice(0, 90) || 'Neuer Blogpost';
    const url = row.id > 0 ? `/posts/db/${row.id}` : '';
    const time = dbTime(row.created_at);
    return { title, url, plain, time };
  })
  .filter((p) => p.title && p.url && p.plain)
  .sort((a, b) => {
    if (b.time !== a.time) return b.time - a.time;
    return b.url.localeCompare(a.url);
  })
  .slice(0, POSTS_ON_HOME)
  .map((p) => ({
    title: p.title,
    url: p.url,
    snippet: pickRandomSnippet(p.plain, 220),
  }));
---

<html lang="en" class="home">
  <head>
    <meta charset="utf-8" />
    <ThemeInit />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f4f1ea" />
    <title>SASH</title>
    <SiteFontOverrides />
  </head>
  <body>
    <Nav2 variant="home" />
    <header class="home-hero">
      <h1 class="home-hero-title">SaSh</h1>
    </header>
    <QuoteDisplay client:load />

    <section class="home-tail" aria-label="Letzte Blogposts">
      {homePosts.map((post, i) => (
        <a
          href={post.url}
          class="last-post-card"
          style={`--post-depth: ${i}; --post-depth-max: ${POSTS_ON_HOME - 1};`}
          aria-label={i === 0 ? `Letzter Blogpost: ${post.title}` : `Älterer Blogpost: ${post.title}`}
        >
          {i === 0 && <span class="last-post-card__eyebrow">letzter blogpost</span>}
          <h2 class="last-post-card__title">{post.title}</h2>
          {post.snippet && (
            <p class="last-post-card__snippet">{post.snippet}</p>
          )}
        </a>
      ))}
    </section>
    <GraffitiLayer client:load />
    <SitePlacedItemsLayer client:load />
    <SiteInventory client:load />
    <TesterBugBar client:load />
    <ThemeClient />
  </body>
</html>

<style is:global>
  html.home {
    background-color: var(--home-page-bg);
  }
  /* Nur Abstand für fixierte Icon-Leiste; großer Titel scrollt mit im Fluss darunter. */
  html.home body {
    background-color: var(--home-page-bg);
    margin: 0;
    padding: 0;
    padding-top: calc(var(--nav-strip-h) + env(safe-area-inset-top, 0px));
  }

  /* Global h1-Regeln (margin, font-weight) würden den Hero-Titel verschieben — hier zurücksetzen. */
  html.home .home-hero-title {
    margin: 0;
    font-weight: normal;
  }
</style>
<style>
  .home-hero {
    position: relative;
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding-left: max(0.75rem, env(safe-area-inset-left, 0px));
    padding-right: max(0.75rem, env(safe-area-inset-right, 0px));
    box-sizing: border-box;
    overflow-x: clip;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  /*
   * Zentrierung per Flexbox (stabil auf Mobile); scaleX separat ohne translateX,
   * damit nichts nach rechts „wandert“.
   */
  .home-hero-title {
    font-family: var(--font-hero, 'Protest Demo');
    font-size: 20vh;
    color: var(--home-hero-text);
    display: block;
    position: relative;
    left: auto;
    width: max-content;
    max-width: min(100%, 100vw - 1.5rem);
    padding: 0;
    padding-top: calc(1rem + 5vh);
    line-height: 1;
    text-align: center;
    transform: scaleX(0.6);
    transform-origin: center top;
  }

  @media screen and (max-width: 767px) {
    .home-hero-title {
      font-size: clamp(2.25rem, min(11vh, 12vw), 3.5rem);
      padding-top: calc(0.75rem + 3vh);
    }
  }

  .home-tail {
    margin-top: 4rem;
    padding: 0 1rem 3rem;
    opacity: var(--home-tail-opacity);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  /*
   * Trichter-Stack: Hauptpost (depth=0) bleibt voll, ältere Posts werden
   * schmaler/blasser/dünner. --post-depth wird inline gesetzt (0..N-1),
   * --post-depth-max ist (N-1).
   * --t ist der normalisierte Fade-Faktor: 0 = voll, 1 = letzter sichtbarer.
   */
  .last-post-card {
    --post-depth: 0;
    --post-depth-max: 5;
    --t: calc(var(--post-depth) / var(--post-depth-max));

    display: flex;
    flex-direction: column;
    gap: calc(0.75rem * (1 - var(--t) * 0.5));
    width: calc(min(640px, 100%) * (1 - var(--t) * 0.4));
    padding:
      calc(1.5rem * (1 - var(--t) * 0.55))
      calc(1.5rem * (1 - var(--t) * 0.45))
      calc(1.75rem * (1 - var(--t) * 0.55));
    border-radius: calc(1rem * (1 - var(--t) * 0.35));
    background: var(--site-card-bg);
    color: var(--site-card-text);
    border: 1px solid var(--site-card-border);
    box-shadow:
      var(--site-card-inset-soft),
      var(--site-card-inset-strong),
      var(--site-card-shadow);
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    opacity: calc(1 - var(--t) * 0.85);
  }

  .last-post-card:hover,
  .last-post-card:focus-visible {
    transform: translateY(-2px);
    outline: none;
  }

  .last-post-card__eyebrow {
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .last-post-card__title {
    margin: 0;
    font-size: calc(1.6rem * (1 - var(--t) * 0.45));
    line-height: 1.2;
    font-weight: calc(600 - var(--t) * 200);
  }

  .last-post-card__snippet {
    margin: 0;
    font-size: calc(0.95rem * (1 - var(--t) * 0.4));
    line-height: 1.55;
    opacity: 0.85;
    font-style: italic;
  }

  @media (max-width: 480px) {
    .last-post-card {
      padding:
        calc(1.1rem * (1 - var(--t) * 0.55))
        calc(1.1rem * (1 - var(--t) * 0.45))
        calc(1.3rem * (1 - var(--t) * 0.55));
    }
    .last-post-card__title {
      font-size: calc(1.35rem * (1 - var(--t) * 0.45));
    }
  }
</style>
