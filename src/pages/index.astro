---
import Nav2 from '../components/Nav2.astro';
import QuoteDisplay from '../components/QuoteDisplay.jsx';
import Grid from '../components/Grid.astro';
import Veranda from '../components/Veranda.astro';
import SiteFontOverrides from '../components/SiteFontOverrides.astro';
import '../styles/global.css';

const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true })) as any[];

function pubTime(post: any): number {
  const d = post?.frontmatter?.pubDate;
  if (d == null) return 0;
  const t = Date.parse(String(d));
  return Number.isNaN(t) ? 0 : t;
}

const sorted = [...allPosts].sort((a, b) => {
  const diff = pubTime(b) - pubTime(a);
  if (diff !== 0) return diff;
  return String(b.url ?? '').localeCompare(String(a.url ?? ''));
});
const lastPost = sorted[0] ?? null;
---

<html lang="en" class="home">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>SASH</title>
    <SiteFontOverrides />
  </head>
  <body>
    <Nav2 variant="home" />
    <header class="home-hero">
      <h1 class="home-hero-title">SaSh</h1>
    </header>
    <QuoteDisplay client:load />

    <section class="home-tail" aria-label="Blog-Vorschau (Entwurf)">
      <Veranda />
      <Grid>
        <a
          href="/minigames"
          class="grid-item grid-item--minigames"
          style="text-decoration: none; color: inherit; display: block;"
          aria-label="Minigames"
        >
          <span class="minigames-icon-wrap" aria-hidden="true">
            <svg class="minigames-icon" width="56" height="56" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="6" y="14" width="36" height="22" rx="4" stroke="currentColor" stroke-width="1.8" />
              <path d="M14 22h4v4h-4z M22 22h4v4h-4z" fill="currentColor" />
              <path d="M32 24a2 2 0 1 1-4 0 2 2 0 0 1 4 0z" fill="currentColor" />
              <path d="M10 20c8-6 20-6 28 0" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.45" />
            </svg>
          </span>
          <span class="minigames-label">minigames</span>
        </a>
        {lastPost?.url && lastPost?.frontmatter?.title && (
          <a
            href={lastPost.url}
            class="grid-item grid-item--inset"
            style="text-decoration: none; color: inherit; display: block;"
          >
            <h1 class="lastPost-title">{lastPost.frontmatter.title}</h1>
            <div class="lastPost-eye">eye</div>
          </a>
        )}
      </Grid>
    </section>
  </body>
</html>

<style is:global>
  /* Default-Theme: html beige — Startseite schwarz. */
  html.home {
    background-color: #000;
  }
  /* Nur Abstand für fixierte Icon-Leiste; großer Titel scrollt mit im Fluss darunter. */
  html.home body {
    background-color: #000;
    margin: 0;
    padding: 0;
    padding-top: calc(var(--nav-strip-h) + env(safe-area-inset-top, 0px));
  }

  /* Global h1-Regeln (margin, font-weight) würden den Hero-Titel verschieben — hier zurücksetzen. */
  html.home .home-hero-title {
    margin: 0;
    font-weight: normal;
  }
</style>
<style>
  .home-hero {
    position: relative;
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding-left: max(0.75rem, env(safe-area-inset-left, 0px));
    padding-right: max(0.75rem, env(safe-area-inset-right, 0px));
    box-sizing: border-box;
    overflow-x: clip;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  /*
   * Zentrierung per Flexbox (stabil auf Mobile); scaleX separat ohne translateX,
   * damit nichts nach rechts „wandert“.
   */
  .home-hero-title {
    font-family: var(--font-hero, 'Protest Demo');
    font-size: 20vh;
    color: white;
    display: block;
    position: relative;
    left: auto;
    width: max-content;
    max-width: min(100%, 100vw - 1.5rem);
    padding: 0;
    padding-top: calc(1rem + 5vh);
    line-height: 1;
    text-align: center;
    transform: scaleX(0.6);
    transform-origin: center top;
  }

  @media screen and (max-width: 767px) {
    .home-hero-title {
      font-size: clamp(2.25rem, min(11vh, 12vw), 3.5rem);
      padding-top: calc(0.75rem + 3vh);
    }
  }

  .home-tail {
    margin-top: 4rem;
    padding: 0 1rem 3rem;
    opacity: 0.45;
  }

  :global(.grid-item--minigames) {
    background: linear-gradient(145deg, #1a1a2e 0%, #16213e 45%, #0f3460 100%);
    box-shadow:
      inset 0 0 32px 8px rgba(255, 255, 255, 0.06),
      inset 0 0 4px 1px rgba(0, 0, 0, 0.4);
    border-radius: 1rem;
    color: rgba(255, 255, 255, 0.92);
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    min-width: 7rem;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  :global(.grid-item--minigames:hover) {
    transform: translateY(-2px);
    box-shadow:
      inset 0 0 40px 12px rgba(120, 180, 255, 0.12),
      0 8px 24px rgba(0, 0, 0, 0.35);
  }

  .minigames-icon-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .minigames-icon {
    opacity: 0.95;
  }

  .minigames-label {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  :global(.grid-item--inset) {
    background: #fff;
    box-shadow:
      inset 0 0 40px 10px rgba(0, 0, 0, 0.35),
      inset 0 0 80px 10px rgba(0, 0, 0, 0.25),
      inset 0 0 8px 2px rgba(0, 0, 0, 0.45);
    border-radius: 1rem;
  }

  :global(.grid-item--inset h1) {
    font-size: 2.5rem;
    transition: font-size 0.5s cubic-bezier(0.4, 1.6, 0.4, 1);
  }

  :global(.grid-item--inset:hover h1) {
    font-size: 1.2rem;
  }

  .lastPost-title {
    font-size: 1rem;
    padding: 10px;
  }

  .lastPost-eye {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }
</style>
