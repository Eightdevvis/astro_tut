---
import RpgQuestTree from '../../components/RpgQuestTree.jsx';
import ThemeInit from '../../components/ThemeInit.astro';
import ThemeClient from '../../components/ThemeClient.astro';
import TesterBugBar from '../../components/TesterBugBar.jsx';
import { getUsernameFromCookies } from '../../lib/session.js';
import { hasPermission } from '../../lib/permissions.js';
import '../../styles/themes.css';

const username = await getUsernameFromCookies(Astro.cookies);
const canUseRpg = Boolean(username) && (await hasPermission(username, 'rpg_access'));
if (!canUseRpg) {
  return Astro.redirect('/');
}
---

<!doctype html>
<html lang="de" class="rpg-root-html">
  <head>
    <meta charset="utf-8" />
    <ThemeInit />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f4f1ea" />
    <title>RPG · Quest-Baum</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="rpg-root-body">
    <RpgQuestTree client:load />
    <TesterBugBar client:load />
    <ThemeClient />
  </body>
</html>

<style is:global>
  html.rpg-root-html {
    color-scheme: light dark;
    --rpg-font-sans: 'Plus Jakarta Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  html.rpg-root-html,
  body.rpg-root-body {
    margin: 0;
    min-height: 100%;
    background: var(--rpg-root-bg);
    color: var(--rpg-root-fg);
  }

  body.rpg-root-body {
    min-height: 100dvh;
    font-family: var(--rpg-font-sans);
  }

</style>
