---
import RpgQuestTree from '../../components/RpgQuestTree.jsx';
import ThemeInit from '../../components/ThemeInit.astro';
import ThemeClient from '../../components/ThemeClient.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import { getUsernameFromCookies } from '../../lib/session.js';
import { SUPERUSER } from '../../lib/permissions.js';
import '../../styles/themes.css';

const username = await getUsernameFromCookies(Astro.cookies);
if (!username || username !== SUPERUSER) {
  return Astro.redirect('/');
}
---

<!doctype html>
<html lang="de" class="rpg-root-html">
  <head>
    <meta charset="utf-8" />
    <ThemeInit />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#c5ac7e" />
    <title>RPG · Quest-Baum</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="rpg-root-body">
    <div class="rpg-theme-float">
      <ThemeToggle />
    </div>
    <RpgQuestTree client:load />
    <ThemeClient />
  </body>
</html>

<style is:global>
  html.rpg-root-html {
    color-scheme: light dark;
    --rpg-font-sans: 'Plus Jakarta Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  html.rpg-root-html,
  body.rpg-root-body {
    margin: 0;
    min-height: 100%;
    background: var(--rpg-root-bg);
    color: var(--rpg-root-fg);
  }

  body.rpg-root-body {
    min-height: 100dvh;
    font-family: var(--rpg-font-sans);
  }

  .rpg-theme-float {
    position: fixed;
    top: calc(0.35rem + env(safe-area-inset-top, 0px));
    right: calc(0.5rem + env(safe-area-inset-right, 0px));
    z-index: 300;
    pointer-events: auto;
  }

  .rpg-theme-float .theme-toggle {
    border-radius: 10px;
    background: color-mix(in srgb, var(--rpg-root-fg) 8%, transparent);
  }

  .rpg-theme-float .theme-toggle:hover,
  .rpg-theme-float .theme-toggle:focus-visible {
    background: color-mix(in srgb, var(--rpg-root-fg) 14%, transparent);
  }
</style>
