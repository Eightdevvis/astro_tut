---
import RpgQuestTree from '../../components/RpgQuestTree.jsx';
import { getUsernameFromCookies } from '../../lib/session.js';
import { SUPERUSER } from '../../lib/permissions.js';

const username = await getUsernameFromCookies(Astro.cookies);
if (!username || username !== SUPERUSER) {
  return Astro.redirect('/');
}
---

<!doctype html>
<html lang="de" class="rpg-root-html">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0a0c" />
    <title>RPG · Quest-Baum</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="rpg-root-body">
    <RpgQuestTree client:load />
  </body>
</html>

<style is:global>
  html.rpg-root-html {
    color-scheme: dark;
  }

  html.rpg-root-html,
  body.rpg-root-body {
    margin: 0;
    min-height: 100%;
    background: #0a0a0c;
    color: rgba(255, 255, 255, 0.92);
  }
  body.rpg-root-body {
    min-height: 100dvh;
  }
</style>
