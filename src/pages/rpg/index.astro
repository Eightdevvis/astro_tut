---
import RpgQuestHub from '../../components/RpgQuestHub.jsx';
import { getUsernameFromCookies } from '../../lib/session.js';
import { SUPERUSER } from '../../lib/permissions.js';

const username = await getUsernameFromCookies(Astro.cookies);
if (!username || username !== SUPERUSER) {
  return Astro.redirect('/');
}
---

<!doctype html>
<html lang="de" class="rpg-root-html">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0a0c" />
    <title>RPG · Quests</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="rpg-root-body">
    <RpgQuestHub client:load />
  </body>
</html>

<style is:global>
  html.rpg-root-html {
    color-scheme: dark;
    --rpg-font-sans: 'Plus Jakarta Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  html.rpg-root-html,
  body.rpg-root-body {
    margin: 0;
    min-height: 100%;
    background: #0a0a0c;
    color: rgba(255, 255, 255, 0.92);
  }

  body.rpg-root-body {
    min-height: 100dvh;
    font-family: var(--rpg-font-sans);
  }
</style>
