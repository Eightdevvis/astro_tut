---
import BlogPost from '../components/BlogPost.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ensureDbSchema, getDb } from '../lib/db.js';
import { getFullHiddenUsernames } from '../lib/user-privacy-defaults.js';

const pageTitle = 'My Astro Learning Blog';

type DbBlogRow = {
  id: number;
  slug: string | null;
  username: string;
  content_text: string;
  created_at: string;
};

let posts: DbBlogRow[] = [];
try {
  await ensureDbSchema();
  const hidden = await getFullHiddenUsernames();
  const result = await getDb().execute({
    sql: `SELECT id, public_slug, username, content_text, created_at
          FROM blog_posts
         WHERE deleted_at IS NULL AND visibility = 'public'
         ORDER BY datetime(created_at) DESC, id DESC`,
    args: [],
  });
  posts = (result.rows || []).filter((row) => !hidden.has(String(row.username || ''))).map((row) => ({
    id: Number(row.id ?? 0),
    slug: row.public_slug ? String(row.public_slug) : null,
    username: String(row.username ?? ''),
    content_text: String(row.content_text ?? ''),
    created_at: String(row.created_at ?? ''),
  }));
} catch (err) {
  console.error('blog: failed to load db posts', err);
}

function titleFromText(text: string, id: number): string {
  const firstLine = text
    .split('\n')
    .map((line) => line.trim())
    .find((line) => line.length > 0);
  return firstLine?.slice(0, 90) || `Post #${id}`;
}
---

<BaseLayout pageTitle={pageTitle}>
  <p>This is where I will post about my journey learning Astro.</p>
  <ul>
    {posts.map((post) => (
      <BlogPost url={`/posts/db/${post.slug || post.id}`} title={titleFromText(post.content_text, post.id)} />
    ))}
  </ul>
</BaseLayout>
