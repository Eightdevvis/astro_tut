---
import Nav2 from '../components/Nav2.astro';
import Footer from '../components/Footer.astro';
import SiteFontOverrides from '../components/SiteFontOverrides.astro';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeClient from '../components/ThemeClient.astro';
import TesterBugBar from '../components/TesterBugBar.jsx';
import GraffitiLayer from '../components/GraffitiLayer.jsx';
import SiteInventory from '../components/SiteInventory.jsx';
import SitePlacedItemsLayer from '../components/SitePlacedItemsLayer.jsx';
import PageFavicon from '../components/PageFavicon.astro';
import '../styles/global.css';

const { pageTitle, faviconIcon } = Astro.props;
---

<html lang="de" class="site-subpage">
  <head>
    <meta charset="utf-8" />
    <ThemeInit />
    {faviconIcon
      ? <PageFavicon icon={faviconIcon} />
      : <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    }
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4f1ea" />
    <title>{pageTitle}</title>
    <SiteFontOverrides />
    <slot name="head" />
  </head>
  <body>
    <Nav2 variant="subpage" />
    <main class="subpage-main">
      <slot />
    </main>
    <GraffitiLayer client:load />
    <SitePlacedItemsLayer client:load />
    <SiteInventory client:load />
    <TesterBugBar client:load />
    <Footer />
    <ThemeClient />
  </body>
</html>
