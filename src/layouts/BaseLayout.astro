---
import Nav2 from '../components/Nav2.astro';
import Footer from '../components/Footer.astro';
import SiteFontOverrides from '../components/SiteFontOverrides.astro';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeClient from '../components/ThemeClient.astro';
import TesterBugBar from '../components/TesterBugBar.jsx';
import GraffitiLayer from '../components/GraffitiLayer.jsx';
import SiteInventory from '../components/SiteInventory.jsx';
import SitePlacedItemsLayer from '../components/SitePlacedItemsLayer.jsx';
import PageFavicon from '../components/PageFavicon.astro';
import '../styles/global.css';

const { pageTitle, faviconIcon } = Astro.props;

// N2 — globale Default-CSP als zweite Verteidigungslinie gegen XSS.
// Wir nutzen viele inline-<script>-Tags (Editor, Sidebar, Datenschutz),
// deshalb hier 'unsafe-inline' fuer script-src. Wenn diese je auf nonces
// migriert werden, kann 'unsafe-inline' raus. `object-src 'none'` blockt
// <object>/<embed>-XSS-Tricks; `base-uri 'self'` verhindert <base>-
// Hijacks; `frame-ancestors 'self'` ist der globale Default — per-Post
// no_embed setzt das auf 'none' (siehe blog-privacy privacyHeaders).
const DEFAULT_CSP = [
  "default-src 'self'",
  "script-src 'self' 'unsafe-inline'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: blob:",
  "font-src 'self' data:",
  "connect-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "frame-ancestors 'self'",
  "form-action 'self'",
].join('; ');
if (Astro?.response && !Astro.response.headers.has('Content-Security-Policy')) {
  Astro.response.headers.set('Content-Security-Policy', DEFAULT_CSP);
}
---

<html lang="de" class="site-subpage">
  <head>
    <meta charset="utf-8" />
    <ThemeInit />
    {faviconIcon
      ? <PageFavicon icon={faviconIcon} />
      : <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    }
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4f1ea" />
    <title>{pageTitle}</title>
    <SiteFontOverrides />
    <slot name="head" />
  </head>
  <body>
    <Nav2 variant="subpage" />
    <main class="subpage-main">
      <slot />
    </main>
    <GraffitiLayer client:load />
    <SitePlacedItemsLayer client:load />
    <SiteInventory client:load />
    <TesterBugBar client:load />
    <Footer />
    <ThemeClient />
  </body>
</html>
