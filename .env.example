# Lokal: kopieren nach .env und Werte setzen. Vercel: dieselben Namen unter Project → Settings → Environment Variables.

# Zufällige lange Zeichenkette (z. B. openssl rand -hex 32)
JWT_SECRET=

# Production (Vercel): Turso-DB — ohne diese beiden funktionieren Login/Zitate nicht in der Cloud
# https://turso.tech — Datenbank anlegen, dann URL + Token aus dem Dashboard
TURSO_URL=
TURSO_AUTH_TOKEN=

# Optional: feste Canonical-URL (eigene Domain). Sonst nutzt Astro die Vercel-URL.
# SITE_URL=https://deine-domain.de

# Optional: RPG Quest-Baum — KI-Generierung neuer Quests (Superuser). Ohne Key: Button liefert 503.
# OpenAI direkt: Key https://platform.openai.com/api-keys — oder OpenRouter: https://openrouter.ai/keys
OPENAI_API_KEY=
# Modell: bei OpenRouter mit Anbieter-Präfix, z. B. openai/gpt-4o-mini oder deepseek/deepseek-chat
RPG_OPENAI_MODEL=openai/gpt-4o-mini
# OpenAI-kompatible Base-URL (Default: https://api.openai.com/v1). OpenRouter:
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# structured output: bei OpenRouter/DeepSeek meist json_object (Default ohne api.openai.com)
RPG_OPENAI_USE_JSON_SCHEMA=0
